    local hit = make("TextButton", {Name="ToggleHitArea",Text="",BackgroundTransparency=1,
        Size=UDim2.fromScale(1,1),ZIndex=row.ZIndex+1,Parent=row})
    pill.ZIndex=hit.ZIndex+1; knob.ZIndex=pill.ZIndex+1
