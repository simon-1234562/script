						end

						needRescan = scannedOceanFolder ~= oceanFolder

						if not needRescan then
							elapsed = tick() - now
							oceanRescanRate = getgenv().OceanRescanRate or 5
							needRescan = elapsed > oceanRescanRate
						end

						if needRescan then
							instances = {}
							oceanTopY = nil

							-- adds an ocean part to the list the water walker keeps above
							noteOceanPart = function(instance)
								if not instance:IsA("BasePart") then
