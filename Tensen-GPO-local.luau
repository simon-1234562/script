		-- the closest cake of a flavour in the room: model, prompt, main part and distance
		getgenv().findCake = function(flavour, children)
			flavour = flavour or getgenv().wantedCake()

			if not flavour then
				return nil
			end

			if not children then
				children = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
				children = children and children.Position
			end

			local lowerFlavour = string.lower(flavour)
			local bestDist = math.huge
			local bestChild = nil
			local bestPrompt = nil
			local best = nil

			for _, cakeFolder in ipairs(getgenv().cakeFolders()) do
				for _, child in ipairs(cakeFolder:GetChildren()) do
					if string.lower(child.Name) ~= lowerFlavour then
						continue
					end

					local proximityPrompt = child:FindFirstChildWhichIsA("ProximityPrompt", true)

					if not (proximityPrompt and proximityPrompt.Enabled) then
						continue
					end

					local cakePos = getgenv().cakePosition(child)

					if not cakePos then
						continue
					end

					local magnitude = children and (cakePos - children).Magnitude or 0

					if magnitude < bestDist then
						bestDist = magnitude
						bestChild = child
						bestPrompt = proximityPrompt
						best = cakePos
					end
				end
			end

			return bestChild, bestPrompt, best, bestDist
		end

		getgenv().CakeWaitTimeout = getgenv().CakeWaitTimeout or 15

		getgenv().CakeWaitRate = getgenv().CakeWaitRate or 0.25

		-- waits up to `timeout` seconds for a cake of the flavour to appear; same returns as findCake
		getgenv().waitForCake = function(flavour, timeout)
			local wanted = flavour or getgenv().wantedCake()

			if not wanted then
				return nil, "no flavour asked for"
			end

			local deadline = tick() + (timeout or getgenv().CakeWaitTimeout or 15)

			while true do
				local cake, cakePos, cakeMain, cakeDist = getgenv().findCake(wanted)

				if cake then
					return cake, cakePos, cakeMain, cakeDist
				end

				task.wait(getgenv().CakeWaitRate or 0.25)

				if not (deadline < tick()) then
					continue
				end

				break
			end

			return nil,
				string.format(
					"no '%s' appeared within %.0fs",
					tostring(wanted),
					timeout or getgenv().CakeWaitTimeout or 15
				)
		end

