					end

					if type(walkOnWater) ~= "boolean" then
						walkOnWater = noWalkOnWater
						continue
					end

					needRescan = scannedOceanFolder ~= oceanFolder

					if not needRescan then
						elapsed = tick() - now
						oceanRescanRate = getgenv().OceanRescanRate or 5
						needRescan = elapsed > oceanRescanRate
					end

					if needRescan then
						instances = {}
						oceanTopY = nil

						-- adds an ocean part to the list the water walker keeps above
						noteOceanPart = function(instance)
							if not instance:IsA("BasePart") then
								return
							end

							table.insert(instances, instance)

							local topY = instance.Position.Y + instance.Size.Y / 2

							if not oceanTopY or topY > oceanTopY then
								oceanTopY = topY
							end
						end

						noteOceanPart(oceanFolder)

						for _, descendant in ipairs(oceanFolder:GetDescendants()) do
