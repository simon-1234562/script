		local function tweenToMob(cfg)
			if tweenState.Enabled or getgenv().EvadingBoss or getgenv().LowHealthActive then
				return
			end

			cfg = cfg or {}
			getgenv().RecordTweenRequest("mob", cfg)
			local container = cfg and cfg.Container or npcFolder or Workspace

			-- the dump drops the default offset here: it builds Vector3.new(0, 14, 0)
			-- when cfg.Offset is missing, then never uses it

			if getgenv().TweenMobRaycast == false and getgenv().KeepTweenMobRaycastOff ~= true then
				getgenv().TweenMobRaycast = nil

				if getgenv().BMLog then
					getgenv().BMLog(
						"[Tween] TweenMobRaycast was left OFF by the previous build - clearing it, the mob chase raycast is back on."
					)
				end
			end

			local walkOnWater = cfg.WalkOnWater ~= false

			if tweenState.Conn then
				tweenState.Conn:Disconnect()
			end

			local attachState = getgenv().AttachState

			if attachState and attachState.Enabled and stopAttach then
				pcall(stopAttach)
			end

			pcall(function()
				if tweenState.Gyro then
					tweenState.Gyro:Destroy()
					return
				end

				if tweenState.Vel then
					tweenState.Vel:Destroy()
				end
			end)
			local localPlayer = game.Players.LocalPlayer
			local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
			local humanoidRootPart = character:WaitForChild("HumanoidRootPart", 3)
			local humanoid = character:WaitForChild("Humanoid", 3)

			if not humanoidRootPart or not humanoid then
				return
			end

			tweenState.Enabled = true
			setNoclip(false)
			humanoid.PlatformStand = true
			humanoid.AutoRotate = false

			if not getgenv().firebreathMovementHeld() then
				humanoidRootPart.Anchored = false
			end

			getgenv().WaterOverride = true

			if walkOnWater then
				getgenv().WaterOverrideType = "Collide"
			else
				getgenv().WaterOverrideType = "NoCollide"
			end

			local kdTweenGyro = Instance.new("BodyGyro")
			kdTweenGyro.Name = "KD_TweenGyro"
			kdTweenGyro.P = 200000
			kdTweenGyro.D = getgenv().ChaseGyroD or 1000
			kdTweenGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
			kdTweenGyro.Parent = humanoidRootPart
			tweenState.Gyro = kdTweenGyro
			local kdTweenVel = Instance.new("BodyVelocity")
			kdTweenVel.Name = "KD_TweenVel"
			kdTweenVel.MaxForce = Vector3.new(1000000000, 1e9, 1e9)
			kdTweenVel.Parent = humanoidRootPart
			tweenState.Vel = kdTweenVel
			tweenState.Gen = (tweenState.Gen or 0) + 1
			local gen = tweenState.Gen
			local conn = nil
			local lastMob = nil
			local emptySince = nil
			local raycastParams = RaycastParams.new()
			raycastParams.FilterDescendantsInstances = { character }
			raycastParams.FilterType = Enum.RaycastFilterType.Exclude

			-- ends this chase: disconnects the heartbeat, destroys the movers and gives control back
			local function stopChase()
				getgenv().BreathHolding = false

				pcall(function()
					kdTweenVel.Velocity = Vector3.zero
				end)

				if conn then
					conn:Disconnect()
					conn = nil
				end

				pcall(function()
					kdTweenGyro:Destroy()
				end)

				pcall(function()
					kdTweenVel:Destroy()
				end)

				if tweenState.Gen == gen then
					tweenState.Enabled = false
					tweenState.Conn = nil
					tweenState.Gyro = nil
					tweenState.Vel = nil
					setNoclip(false)
					getgenv().WaterOverride = false
				end

				if humanoid and humanoid.Parent then
					humanoid.PlatformStand = false
					humanoid.AutoRotate = true
				end
			end

			-- nothing to chase this frame: stand still, and give up after ChaseEmptyMax seconds
			local function nothingToChase()
				tweenState.AtGoal = false
				kdTweenVel.Velocity = Vector3.zero

				pcall(function()
					humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
				end)

				emptySince = emptySince or tick()
				local emptyFor = tick() - emptySince

				if (getgenv().ChaseEmptyMax or 1.5) < emptyFor then
					if getgenv().BMLog then
						getgenv().BMLog("[Tween] Nothing left to chase - ending the chase so the room can move on.")
					end

					stopChase()
				end
			end

			-- Broken in the dump: the code that pushes you toward the mob is gone, so this
			-- never sets a non-zero velocity. The decompiler's version was three nested
			-- state machines (about 1100 lines); two of them can only ever return, and what
			-- is left is below, step for step. Two paths throw, as they did in the dump.
			conn = game:GetService("RunService").Heartbeat:Connect(function(_dt)
				if bmStale() or tweenState.Gen ~= gen then
					if conn then
						conn:Disconnect()
						conn = nil
					end

					return
				end

				if not tweenState.Enabled or getgenv().EvadingBoss or getgenv().LowHealthActive then
					return
				end

				local characterGone = not humanoidRootPart.Parent
					or not humanoid.Parent
					or humanoid.Health <= 0
					or localPlayer.Character ~= character

				if characterGone then
					stopChase()
					return
				end

				if getgenv().firebreathMovementHeld() then
					kdTweenVel.Velocity = Vector3.zero
					return
				end

				if isCharacterDowned(character) then
					return
				end

				if not humanoid.PlatformStand then
					humanoid.PlatformStand = true
					humanoid.AutoRotate = false
				end

				getgenv().holdAboveWater(humanoidRootPart)

				-- leashPart doubles as a leftover value the Kaido check below compares against
				local leashPart = cfg.LeashPart

				if leashPart and leashPart.Parent and cfg.Leash then
					stopChase()
					return
				end

				-- target: whoever carries the prisoner, else the mob we were sent after
				local target = nil
				local carrier = getgenv().CurrentPrisonerCarrier

				if carrier then
					leashPart = 0

					if carrier.Parent then
						target = carrier
						local carrierHumanoid = carrier:FindFirstChildOfClass("Humanoid")

						if not (carrierHumanoid and carrierHumanoid.Health > 0) then
							target = nil
						end
					end
				end

				if not target then
					target = cfg and cfg.TargetMob

					if target and target.Parent then
						local targetHumanoid = target:FindFirstChildOfClass("Humanoid")

						if targetHumanoid and targetHumanoid.Health <= 0 then
							target = nil
						end
					else
						target = nil
					end
				end

				if not target then
					-- no target: keep the last mob while it lives, otherwise pick the nearest one
					local reference = cfg and (cfg.ReferencePart or cfg.ReferencePosition) or humanoidRootPart
					local lastMobAlive = lastMob ~= nil and lastMob.Parent ~= nil

					if lastMobAlive then
						local lastMobHumanoid = lastMob:FindFirstChildOfClass("Humanoid")

						if lastMobHumanoid and lastMobHumanoid.Health <= 0 then
							lastMobAlive = false
						end
					end

					if lastMobAlive then
						local retargetRate = getgenv().RetargetRate

						if retargetRate then
							error("attempt to call a number value") -- the dump calls a leftover key number here
						end

						error("attempt to compare nil < number") -- the dump compares a value it never set
					end

					leashPart = false
					target = nearestMob(reference, container)
					lastMob = target
				end

				if not npcRoot(target) then
					nothingToChase()
					return
				end

				emptySince = nil

				if getgenv().ChaseIgnoreDragon ~= leashPart and getgenv().isKaidoNPC then
					getgenv().isKaidoNPC(target) -- the result is never used
				end
			end)
			tweenState.Conn = conn
		end

