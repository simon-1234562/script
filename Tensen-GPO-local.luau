		-- --------------------------------------------------------------------
		-- 3.13 Big Mom / aiming
		-- --------------------------------------------------------------------

		getgenv().lookDownAimCFrame = function(from, target, cframe)
			if not (from and target) then
				if not cframe then
					cframe = CFrame.new(from or Vector3.zero)
				end

				return cframe
			end

			local offset = target - from
			local vector = Vector3.new(offset.X, 0, offset.Z)
			local unit

			if vector.Magnitude > (tonumber(getgenv().AimHeadingMinFlat) or 6) then
				unit = vector.Unit
			else
				unit = nil

				if cframe then
					unit = nil

					for _, axis in ipairs({ cframe.LookVector, cframe.RightVector, cframe.UpVector }) do
						local flatAxis = Vector3.new(axis.X, 0, axis.Z)

						if 0.001 < flatAxis.Magnitude then
							unit = flatAxis.Unit
							break
						end

						unit = nil
					end
				end
			end

			if not unit and vector.Magnitude > 0.001 then
				unit = vector.Unit
			end

			unit = unit or Vector3.new(0, 0, -1)
			local pitch = math.atan2(-offset.Y, math.max(vector.Magnitude, 1e-06))
			local num = tonumber(getgenv().AimMaxPitch) or 80
			local maxPitch = math.rad(math.clamp(num, 0, 89))
			local clampedPitch = math.clamp(pitch, -maxPitch, maxPitch)
			local lookDir = unit * math.cos(clampedPitch) - Vector3.yAxis * math.sin(clampedPitch)

			local lookOk, lookCF = pcall(function()
				return CFrame.lookAt(from, from + lookDir, Vector3.yAxis)
			end)

			if lookOk and lookCF then
				return lookCF
			end

			return CFrame.new(from, target)
		end

		-- a CFrame at `from` looking at `target`, kept upright or looking down depending on the aim settings
		getgenv().aimAtCFrame = function(from, target, cframe)
			if not from or not target then
				return cframe or CFrame.new(from or Vector3.zero)
			end

			local offset = target - from

			if offset.Magnitude < 0.0001 then
				cframe = cframe and CFrame.new(from) * cframe.Rotation or CFrame.new(from)
				return cframe
			end

			local flatOffset = Vector3.new(offset.X, 0, offset.Z)
			local steep = false

			if getgenv().AimDefineVertical ~= false then
				if flatOffset.Magnitude <= 0.0001 then
					steep = true
				else
					steep = math.deg(math.atan2(math.abs(offset.Y), flatOffset.Magnitude))
						>= (getgenv().AimVerticalPitch or 60)
				end
			end

			if not steep then
				return CFrame.new(from, target)
			end

			if (getgenv().AimLookDown ~= false) and type(getgenv().lookDownAimCFrame) == "function" then
				return getgenv().lookDownAimCFrame(from, target, cframe)
			end

			local upright = getgenv().AimUprightSteep ~= false

			if upright then
				upright = type(getgenv().uprightAimCFrame) == "function"
			end

			if upright then
				return CFrame.new(from) * getgenv().uprightAimCFrame(from, target, cframe)
			end

			local unit = nil

			if cframe then
				for _, axis in ipairs({ cframe.UpVector, cframe.LookVector }) do
					local flatAxis = Vector3.new(axis.X, 0, axis.Z)

					if flatAxis.Magnitude > 0.01 then
						unit = flatAxis.Unit
						break
					end
				end
			end

			unit = unit or Vector3.new(0, 0, -1)

			local uprightOk, uprightCF = pcall(function()
				return CFrame.lookAt(from, target, unit)
			end)

			if uprightOk and uprightCF then
				return uprightCF
			end

			return CFrame.new(from, target)
		end

		do
			-- aim used while chasing: flat (yaw only) when ChaseFlatAim is on, else aimAtCFrame
			local function chaseAimCFrame(from, target, current)
				if not from or not target then
					if not current then
						local cframe = CFrame.new
						from = from or Vector3.zero
						current = cframe(from)
					end

					return current
				end

				if getgenv().ChaseFlatAim == false then
					return getgenv().aimAtCFrame(from, target, current)
				end

				local vector = Vector3.new(target.X, from.Y, target.Z)

				if (vector - from).Magnitude < 0.05 then
					return current and CFrame.new(from) * current.Rotation or CFrame.new(from)
