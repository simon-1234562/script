		-- Y of the lowest ceiling above origin, 999999 when open sky
		getgenv().GetLowestCeilingY = function(origin, params, ignoreList)
			if ignoreList and #ignoreList > 0 then
				local raycastParams = RaycastParams.new()
				raycastParams.FilterType = Enum.RaycastFilterType.Exclude
				local filterDescendantsInstances = {}

				if params then
					for _, filterDescendantsInstance in ipairs(params.FilterDescendantsInstances) do
						table.insert(filterDescendantsInstances, filterDescendantsInstance)
					end
				end

				for _, part in ipairs(ignoreList) do
					if part then
						table.insert(filterDescendantsInstances, part)
					end
				end

				raycastParams.FilterDescendantsInstances = filterDescendantsInstances
				params = raycastParams
			end

			local hit = Workspace:Raycast(origin + Vector3.new(0, 2, 0), Vector3.new(0, 2000, 0), params)

			if hit and hit.Instance then
				return hit.Position.Y
			end

			return 999999
		end

