					-- adds a toggle bound to getgenv()[boss .. suffix]
					local function addBossToggle(label, suffix, description, default)
						local setting = boss .. suffix

						if getgenv()[setting] == nil then
							getgenv()[setting] = default
						end

						local opts = {
							Name = label,
							Description = description,
							Default = getgenv()[setting] == true,
							Flag = "Boss_" .. setting,
						}

						-- stores the toggle value and autosaves
						local function callback(enabled)
							getgenv()[setting] = enabled

							autosave()
						end

						opts.Callback = callback
						tab:AddToggle(opts)
					end

					-- adds a slider bound to getgenv()[boss .. suffix] (UI value = setting * scale)
					local function addBossSlider(label, suffix, min, max, default, unit, scale)
						if not scale then
							return
						end

						local setting = boss .. suffix
						local num = tonumber(getgenv()[setting])

						if num == nil then
							getgenv()[setting] = default
						end

						tab:AddSlider({
							Name = label,
							Description = SLIDER_DESCRIPTIONS[suffix],
							Min = min,
							Max = max,
							Suffix = unit or "",
							Default = math.floor(tonumber(getgenv()[setting]) * scale + 0.5),
							Flag = "Boss_" .. setting,
							Callback = function(value)
								getgenv()[setting] = value / scale

								autosave()
