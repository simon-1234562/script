							"[React] %s -> %s, holding until the track stops (%s, x%d).",
							tostring(label),
							kind == "dodge" and "GET OUT OF IT" or "BLOCK",
							animLength > 0 and string.format("%.1fs long", animLength)
								or string.format("no length, capped at %.0fs", holdCapped),
							getgenv().Reactions
						)
					)
				end

				return true
			end

			getgenv().noteBigMomReact = noteBigMomReact
		end

		-- --------------------------------------------------------------------
		-- 3.29 Big Mom / dodging: sounds and the reaction loop
		-- --------------------------------------------------------------------

		getgenv().noteBigMomSound = function(sound, label)
			if getgenv().BigMomReact == false then
				return false
			end

			local hold = tonumber(getgenv().TorchHold) or 6
			local key = {}
			local reaction =
				{ kind = "upblock", label = label, done = false, style = "up", id = "sound", until_ = tick() + hold }
			local now = tick()
			reaction.at = now
			reaction.floor_ = tick() + math.min(getgenv().ReactMinHold or 2, hold)
			reaction.side = 1
			getgenv().BigMomReactLive[key] = reaction

			pcall(function()
				sound.Ended:Connect(function()
					reaction.done = true
				end)

				sound.Stopped:Connect(function()
					reaction.done = true
				end)
			end)
			getgenv().TorchReacts = (getgenv().TorchReacts or 0) + 1
			getgenv().Reactions = (getgenv().Reactions or 0) + 1

			if getgenv().ReactLog ~= false and getgenv().BMLog then
				local bmLog = getgenv().BMLog
				local labelText = tostring(label)
				bmLog(
					string.format(
						"[React] %s heard ('%s') -> UP %d studs AND BLOCK, pinned there until it stops (x%d).",
						labelText,
						tostring(sound.Name),
						math.floor(getgenv().ReactRise or 700),
						getgenv().TorchReacts
					)
				)
			end

			return true
		end

		getgenv().MochiBuzzcutHold = getgenv().MochiBuzzcutHold or 6
		getgenv().MochiBuzzcutSounds = getgenv().MochiBuzzcutSounds
			or { MochiV2BuzzcutStart = true, MochiV2BuzzcutHakiOn = true, MochiV2BuzzcutLoop = true }
		getgenv().MochiBuzzcuts = getgenv().MochiBuzzcuts or 0

		do
			-- reacts to Katakuri's Supreme Mochi Buzzcut by going up for a while
			local function noteMochiBuzzcut(label)
				local off = getgenv().BigMomReact == false or bmStale() or not getgenv().EnableBigMom

				if off then
					return false
				end

				if not (getgenv().mochiEmperor and getgenv().mochiEmperor()) then
					return false
				end

				if tick() - (getgenv().LastBuzzcutAt or 0) < 1.5 then
					return false
				end

				getgenv().LastBuzzcutAt = tick()
				local hold = tonumber(getgenv().MochiBuzzcutHold) or 6

				getgenv().BigMomReactLive[{}] = {
					kind = "dodge",
					label = "SUPREME MOCHI BUZZCUT",
					done = false,
					style = "up",
					id = "buzzcut",
					at = tick(),
					until_ = tick() + hold,
					floor_ = tick() + hold,
					side = 1,
				}

				getgenv().MochiBuzzcuts = (getgenv().MochiBuzzcuts or 0) + 1
				getgenv().Reactions = (getgenv().Reactions or 0) + 1

				if getgenv().ReactLog ~= false and getgenv().BMLog then
					local bmLog = getgenv().BMLog
					local labelText = tostring(label)
					bmLog(
						string.format(
							"[React] SUPREME MOCHI BUZZCUT (%s) -> up %d studs for %.0fs (x%d).",
							labelText,
							math.floor(getgenv().MochiDodgeRise or 150),
							hold,
							getgenv().MochiBuzzcuts
						)
					)
				end

				return true
			end

			getgenv().noteMochiBuzzcut = noteMochiBuzzcut
		end

		task.spawn(function()
			for i = 1, 100 do
				if getgenv().onDialogue then
					break
				end

				task.wait(0.1)
			end

			if getgenv().BuzzcutDialogueHooked or not getgenv().onDialogue then
				return
			end

			getgenv().BuzzcutDialogueHooked = true

			getgenv().onDialogue(function(text)
				if
					string.find(string.lower(tostring(text and text.Text or "")), "buzzcut", 1, true)
					and getgenv().noteMochiBuzzcut
				then
					getgenv().noteMochiBuzzcut("he shouted it")
				end
			end)
		end)

		task.spawn(function()
			local obj = setmetatable({}, { __mode = "k" })

			-- hooks a Buzzcut sound so its start triggers the reaction
			local function onBuzzcutSound(instance)
				if obj[instance] or instance.ClassName ~= "Sound" then
					return
				end

				if not (getgenv().MochiBuzzcutSounds or {})[instance.Name] then
					return
				end

				obj[instance] = true

				pcall(function()
					instance.Played:Connect(function()
						pcall(getgenv().noteMochiBuzzcut, "heard " .. instance.Name)
					end)
				end)

				local isPlaying = false

				pcall(function()
					isPlaying = instance.IsPlaying
				end)

				if isPlaying then
					pcall(getgenv().noteMochiBuzzcut, "heard " .. instance.Name)
				end
			end

			for _, descendant in ipairs(Workspace:GetDescendants()) do
				onBuzzcutSound(descendant)
			end

			local connection = nil

			connection = Workspace.DescendantAdded:Connect(function(descendant)
				if bmStale() then
					if connection then
						connection:Disconnect()
					end

					return
				end

				onBuzzcutSound(descendant)
			end)
		end)

		task.spawn(function()
			local obj = setmetatable({}, { __mode = "k" })

			-- hooks one of Big Mom's torch sounds so it triggers a block
			local function onSound(instance)
				if obj[instance] then
					return
				end

				if instance.ClassName ~= "Sound" then
					return
				end

				local bigMomTorchSound = (getgenv().BigMomTorchSounds or {})[instance.Name]

				if not bigMomTorchSound then
					return
				end

				obj[instance] = true

				pcall(function()
					instance.Played:Connect(function()
						if bmStale() then
							return
						end

						if not getgenv().EnableBigMom then
							return
						end

						pcall(getgenv().noteBigMomSound, instance, bigMomTorchSound)
					end)
				end)

				local isPlaying = false

				pcall(function()
					isPlaying = instance.IsPlaying
				end)

				if isPlaying then
					pcall(getgenv().noteBigMomSound, instance, bigMomTorchSound)
				end
			end

			for _, descendant in ipairs(Workspace:GetDescendants()) do
				onSound(descendant)
			end

			local connection = nil

			connection = Workspace.DescendantAdded:Connect(function(descendant)
				if bmStale() then
					if connection then
						connection:Disconnect()
					end

					return
				end

				onSound(descendant)
			end)
		end)

		task.spawn(function()
			local bmReactVel = nil
			local blockPinned = false
			local lastLoggedReaction = nil
			local dodgeCF = nil
			local dodgeSpot = nil
			local blockPinCF = nil
			local reactBoss = nil
			local bossPos = nil

			-- forgets the reaction's mover (the dump never destroys it)
			local function clearReactMovers()
				if not bmReactVel then
					return
				end

				bmReactVel = nil
			end

			-- ends a dodge: removes the movers, returns to the fight spot and resumes the chase
			local function endReaction(label)
				dodgeCF = nil
				dodgeSpot = nil
				clearReactMovers()

				if not getgenv().ReactUp then
					getgenv().EvadingBoss = false
					return
				end

				getgenv().ReactUp = false
				local isMochiNPC = reactBoss and getgenv().isMochiNPC and getgenv().isMochiNPC(reactBoss)
				local prevBossPos = bossPos
				reactBoss = nil
				bossPos = nil

				-- after a reaction, starts chasing again (Katakuri, else Big Mom)
				local function resumeChase()
					if bmStale() or not getgenv().EnableBigMom or getgenv().ReactLanding or getgenv().ReactUp then
						return
					end

					if isMochiNPC then
						getgenv().LastMochiChase = 0
						pcall(getgenv().resumeMochiChase)
					else
						pcall(getgenv().refireLastTween)
					end
				end

				if getgenv().ReactReturnToBoss ~= false then
					local character = localPlayer.Character
					local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
					local reactBoss = getgenv().reactBoss and getgenv().reactBoss()
						or getgenv().findBigMom and getgenv().findBigMom()

					local bigMomPosition = (reactBoss and getgenv().bigMomPosition)
							and getgenv().bigMomPosition(reactBoss)
						or nil
					local targetRoot = humanoidRootPart
						and bigMomPosition
						and (humanoidRootPart.Position - bigMomPosition).Magnitude
							<= (getgenv().ReactReturnMax or 1400)

					if targetRoot then
						local namedChaseOffset = getgenv().namedChaseOffset and getgenv().namedChaseOffset(reactBoss)
							or Vector3.new(0, 14, 0)
						getgenv().ReactLanding = true

						task.spawn(function()
							pcall(getgenv().glideDownToBoss, reactBoss, namedChaseOffset, label)
							getgenv().ReactLanding = false
							getgenv().EvadingBoss = false
							resumeChase()
						end)
						return
					end
				end

				if isMochiNPC and prevBossPos then
					local character = localPlayer.Character
					local rootPart = character and character:FindFirstChild("HumanoidRootPart")

					if rootPart then
						local mochiOffset = (getgenv().MobOffsetByName or {})[getgenv().MochiName or "Mochi Emperor"]
							or Vector3.new(0, 12, 0)

						local cFrame = CFrame.new(
							rootPart.Position.X,
							prevBossPos.Y + mochiOffset.Y,
							rootPart.Position.Z
						) * rootPart.CFrame.Rotation

						if cFrame and not getgenv().firebreathMovementHeld() then
							rootPart.CFrame = cFrame
						end
					end

					getgenv().EvadingBoss = false
					task.defer(resumeChase)
					return
				end

				if getgenv().ReactLandBack == false then
					getgenv().EvadingBoss = false
					return
				end

				getgenv().ReactLanding = true

				task.spawn(function()
					pcall(getgenv().LandOnGround, "the dodge is over - " .. tostring(label))
					getgenv().ReactLanding = false
					getgenv().EvadingBoss = false
				end)
			end

			-- ends a pinned block's react state (the dump never sends the unblock here)
			local function releaseBlock(label)
				getgenv().ReactBlockPin = false

				if blockPinned then
					blockPinned = false
					blockPinCF = nil
					getgenv().AutoBlocking = false
				end

				endReaction(label)

				if getgenv().Reacting and getgenv().ReactLog ~= false and getgenv().BMLog then
					getgenv().BMLog(
						string.format(
							"[React] %s is over (%s) - back to the fight.",
							tostring(getgenv().ReactingWhy),
							tostring(label)
						)
					)
				end

				getgenv().Reacting = nil
				getgenv().ReactingWhy = nil
				lastLoggedReaction = nil
			end

			while task.wait(getgenv().ReactRate or 0.05) do
				if bmStale() then
					releaseBlock("the script was replaced")
					break
				end

				if getgenv().BigMomReact == false or not getgenv().EnableBigMom then
					if getgenv().Reacting then
						releaseBlock("reacting is switched off")
					end
					continue
				end

				local now = tick()
				local reactings = { block = 1, dodge = 2, upblock = 3 }
				local reacting = nil
				local style = "up"
				local label = nil
				local id = nil
				local side = 1

				for k, live in pairs(getgenv().BigMomReactLive) do
					if (live.done or now > live.until_) and now >= (live.floor_ or 0) then
						getgenv().BigMomReactLive[k] = nil
						continue
					end

					local rankA = reactings[live.kind] or 0
					local rankB = reactings[reacting] or 0
					local moreReacting = rankA > rankB

					if
						not moreReacting
						and rankA == rankB
						and live.kind == "dodge"
						and live.style == "away"
						and style ~= "away"
					then
						reacting = live.kind
						label = live.label
						id = live.id
						side = live.side or 1
						style = live.style or "up"
					elseif moreReacting then
						reacting = live.kind
						label = live.label
						id = live.id
						side = live.side or 1
						style = live.style or "up"
					end
				end

				if not reacting then
					if getgenv().Reacting then
						releaseBlock("the animation ended")
					end
					continue
				end

				local character = localPlayer.Character
				local rootPart = character and character:FindFirstChild("HumanoidRootPart")
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")

				if not rootPart or not humanoid or humanoid.Health <= 0 then
					if getgenv().Reacting then
						releaseBlock("no character")
					end
					continue
				end

				getgenv().Reacting = reacting
				getgenv().ReactingWhy = label

				if lastLoggedReaction ~= reacting and getgenv().ReactLog ~= false and getgenv().BMLog then
					lastLoggedReaction = reacting
				end

				if getgenv().ReactLanding then
					continue
				end

				if reacting == "block" then
					endReaction("blocking instead")

					if not blockPinned then
						blockPinned = true
						blockPinCF = CFrame.new(rootPart.Position) * rootPart.CFrame.Rotation
						getgenv().AutoBlocking = true

						pcall(function()
							getgenv().DoBlock(true)
						end)
					end

					if getgenv().ReactBlockHold ~= false then
						getgenv().EvadingBoss = true

						if getgenv().ReactBlockAnchor ~= false then
							getgenv().ReactBlockPin = true
						elseif
							blockPinCF
							and (rootPart.Position - blockPinCF.Position).Magnitude
								> (getgenv().ReactHoldSlack or 0.5)
						then
							getgenv().holdAtSpot(rootPart, blockPinCF)
						end

						pcall(function()
							rootPart.AssemblyLinearVelocity = Vector3.zero
							rootPart.AssemblyAngularVelocity = Vector3.zero
						end)
					end

					getgenv().subStatus = "Blocking " .. tostring(label)
					continue
				end

				if blockPinned and reacting ~= "upblock" then
					blockPinned = false
					getgenv().AutoBlocking = false
					getgenv().ReactBlockPin = false

					pcall(function()
						getgenv().DoUnBlock(true)
					end)
				end

				if reacting ~= "upblock" then
					getgenv().ReactBlockPin = false
				end

				getgenv().EvadingBoss = true

				if not getgenv().ReactUp then
					reactBoss = getgenv().reactBoss and getgenv().reactBoss()
					bossPos = reactBoss and getgenv().bigMomPosition(reactBoss)
					local reactAwaySpot = style == "away" and getgenv().reactAwaySpot
					local awaySpot = nil
					local awayWhy = nil

					if reactAwaySpot then
						awaySpot, awayWhy = getgenv().reactAwaySpot(rootPart, side)
					end

					local reactRise = getgenv().ReactRise

					if reactBoss and getgenv().isMochiNPC and getgenv().isMochiNPC(reactBoss) then
						reactRise = id and (getgenv().MochiRiseById or {})[id] or getgenv().MochiDodgeRise or 150
					end

					local dodgeY, y, dodgeNote = getgenv().bigMomDodgeY(rootPart.Position, { character }, reactRise)
					y = y or rootPart.Position.Y
					dodgeY = dodgeY or y + (getgenv().ReactRise or 700)

					if
						dodgeNote
						and getgenv().ReactLog ~= false
						and getgenv().BMLog
						and tick() - (getgenv().LastDodgeCeilLog or 0) >= 5
					then
						getgenv().LastDodgeCeilLog = tick()
						getgenv().BMLog(
							string.format(
								"[React] Ceiling at Y %d - taking the dodge to Y %d instead of the full %d studs, so we stay inside the room.",
								math.floor(dodgeNote),
								math.floor(dodgeY),
								math.floor(getgenv().ReactRise or 700)
							)
						)
					end

					local safeY = getgenv().barrierSafeY(rootPart.Position.X, dodgeY, rootPart.Position.Z, "the dodge")
						or dodgeY
					local reactSideStep = getgenv().ReactSideStep or 0
					local vector = Vector3.zero

					if reactSideStep > 0 then
						local lookVector = rootPart.CFrame.LookVector
						local flatLook = Vector3.new(lookVector.X, 0, lookVector.Z)

						if flatLook.Magnitude > 0.01 then
							local unit = flatLook.Unit
							vector = Vector3.new(-unit.Z, 0, unit.X) * (reactSideStep * side)
						end
					end

					dodgeSpot = awaySpot
					local dodgeTarget

					if awaySpot then
						dodgeTarget = Vector3.new(rootPart.Position.X, awaySpot.Y, rootPart.Position.Z)
					else
						dodgeTarget = Vector3.new(rootPart.Position.X + vector.X, safeY, rootPart.Position.Z + vector.Z)
					end

					local awayNoSpot = style == "away" and not awaySpot

					if awayNoSpot then
						awayNoSpot = getgenv().ReactLog ~= false
					end

					if awayNoSpot and getgenv().BMLog and tick() - (getgenv().LastAwayFailLog or 0) >= 5 then
						getgenv().LastAwayFailLog = tick()
						getgenv().BMLog(
							string.format(
								"[React] %s wants a sideways dodge but there is nowhere in the room to put us - going up instead, which does NOT beat the beam.",
								tostring(label)
							)
						)
					end

					pcall(function()
						getgenv().dropFaceMouseNow("React dodge")
					end)
					local clampedPos = getgenv().clampYUp(rootPart, dodgeTarget, "React dodge")
					local rotation = rootPart.CFrame.Rotation

					if getgenv().DodgeUprightAim ~= false then
						local reactBoss = getgenv().reactBoss and getgenv().reactBoss()
							or getgenv().findBigMom and getgenv().findBigMom()
						reactBoss = reactBoss and getgenv().bigMomPosition(reactBoss) or nil
						rotation = getgenv().uprightAimCFrame(
							clampedPos,
							reactBoss or clampedPos + rootPart.CFrame.LookVector,
							rootPart.CFrame
						)
					end

					dodgeCF = CFrame.new(clampedPos) * rotation
					clearReactMovers()
					bmReactVel = Instance.new("BodyVelocity")
					bmReactVel.Name = "BM_ReactVel"
					bmReactVel.MaxForce = Vector3.new(1000000000, 1e9, 1000000000)
					bmReactVel.Velocity = Vector3.zero
					bmReactVel.Parent = rootPart

					pcall(function()
						if not getgenv().firebreathMovementHeld() then
							rootPart.CFrame = CFrame.new(rootPart.Position.X, clampedPos.Y, rootPart.Position.Z)
								* dodgeCF.Rotation
						end

						rootPart.AssemblyLinearVelocity = Vector3.zero
						rootPart.AssemblyAngularVelocity = Vector3.zero
					end)

					getgenv().ReactUp = true
					task.wait(getgenv().DodgeSettleTime or 0.1)

					if getgenv().ReactLog ~= false and getgenv().BMLog then
						if awaySpot then
							getgenv().BMLog(
								string.format(
									"[React] SIDEWAYS for %s - going up does not beat this one. Y %.0f now, then WALKING %d studs out of her column at %d/s (never a sideways teleport, that is a kick).",
									tostring(label),
									clampedPos.Y,
									math.floor(awayWhy or 0),
									math.floor(getgenv().ReactAwaySpeed or 200)
								)
							)
						else
							getgenv().BMLog(
								string.format(
									"[React] Up %d studs off the floor (Y %.0f -> %.0f) for %s - holding there until it ends.",
									math.floor(reactRise or 700),
									y,
									clampedPos.Y,
									tostring(label)
								)
							)
						end
					end
				elseif dodgeCF then
					if dodgeSpot then
						local position = dodgeCF.Position
						local vector = Vector3.new(dodgeSpot.X - position.X, 0, dodgeSpot.Z - position.Z)

						if vector.Magnitude <= 1 then
							dodgeSpot = nil
						else
							local position = position
								+ vector.Unit
									* math.min(
										vector.Magnitude,
										(getgenv().ReactAwaySpeed or 200) * (getgenv().ReactRate or 0.05)
									)
							dodgeCF = CFrame.new(position.X, dodgeSpot.Y, position.Z) * dodgeCF.Rotation
						end
					end

					if not bmReactVel or bmReactVel.Parent ~= rootPart then
						clearReactMovers()
						bmReactVel = Instance.new("BodyVelocity")
						bmReactVel.Name = "BM_ReactVel"
						bmReactVel.MaxForce = Vector3.new(1e9, 1e9, 1000000000)
						bmReactVel.Velocity = Vector3.zero
						bmReactVel.Parent = rootPart
					end

					if (getgenv().ReactHoldSlack or 0.5) < (rootPart.Position - dodgeCF.Position).Magnitude then
						getgenv().holdAtSpot(rootPart, dodgeCF)
					end

					pcall(function()
						rootPart.AssemblyLinearVelocity = Vector3.zero
						rootPart.AssemblyAngularVelocity = Vector3.zero
					end)
				end

				if reacting == "upblock" then
					if not blockPinned then
						blockPinned = true
						blockPinCF = CFrame.new(rootPart.Position) * rootPart.CFrame.Rotation
						getgenv().AutoBlocking = true

						if getgenv().ReactLog ~= false and getgenv().BMLog then
							getgenv().BMLog(
								string.format(
									"[React] Blocking %s at Y %.0f - anchored, nothing moves us until it ends.",
									tostring(label),
									rootPart.Position.Y
								)
							)
						end
					end

					if getgenv().ReactBlockAnchor ~= false then
						getgenv().ReactBlockPin = true
					end

					getgenv().subStatus = "Up + blocking " .. tostring(label)
				else
					getgenv().subStatus = "Dodging " .. tostring(label)
				end
			end
		end)

		-- report of the reaction lists and what is happening right now
		getgenv().ReactInfo = function()
			local reactState = getgenv().BigMomReact == false and "OFF" or "on"
			local reactingText = getgenv().Reacting and getgenv().Reacting .. " - " .. tostring(getgenv().ReactingWhy)
				or "nothing"

			local lines = {
				string.format(
					"[React] %s | now: %s | reactions this session: %d",
					reactState,
					reactingText,
					getgenv().Reactions or 0
				),
			}

			local lineCount = #lines
			lines[lineCount + 1] = "  BLOCK:"
			local bigMomBlockAnims = getgenv().BigMomBlockAnims or {}

			for k, bigMomBlockAnim in pairs(bigMomBlockAnims) do
				lines[#lines + 1] = string.format("    %-16s %s", k, bigMomBlockAnim)
			end

			lines[#lines + 1] = "  UP + BLOCK (rise then block, pinned):"
			local bigMomUpBlockAnims = getgenv().BigMomUpBlockAnims or {}

