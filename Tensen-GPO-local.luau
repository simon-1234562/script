		-- plays, hits and damage recorded for an animation id
		getgenv().animStats = function(animId)
			local bigMomAnimPlays = getgenv().BigMomAnimPlays or {}
			local plays = 0

			for k, bigMomAnimPlay in pairs(bigMomAnimPlays) do
				if getgenv().animDigits(k) == animId then
					plays += bigMomAnimPlay
				end
			end

			local iterFn, iterState, iterStart = pairs(getgenv().BigMomAnimHurt or {})
			local hits = 0
			local damage = 0

			for k, entry in iterFn, iterState, iterStart do
				if getgenv().animDigits(k) == animId then
					hits += entry.damage or 0
					damage += entry.hits or 0
				end
			end

			return plays, hits, damage
		end

		-- true (with the reaction kind) when the animation is in one of the react lists
		getgenv().inReactList = function(animId)
			local digits = getgenv().animDigits(animId)

			if not digits then
				return false
			end

			local bigMomUpBlockAnims = getgenv().BigMomUpBlockAnims or {}

			for k in pairs(bigMomUpBlockAnims) do
				if getgenv().animDigits(k) == digits then
					return true, "upblock"
				end
			end

			local iterFn, iterState, iterStart = pairs(getgenv().BigMomDodgeAnims or {})

			for k in iterFn, iterState, iterStart do
				if getgenv().animDigits(k) == digits then
					return true, "dodge"
				end
			end

			local bigMomBlockAnims = getgenv().BigMomBlockAnims or {}

			for k in pairs(bigMomBlockAnims) do
				if getgenv().animDigits(k) == digits then
					return true, "block"
				end
			end

			return false
		end

