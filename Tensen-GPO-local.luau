		-- --------------------------------------------------------------------
		-- 3.15 Big Mom / climbing
		-- --------------------------------------------------------------------

		getgenv().ceilingAbove = function(origin, ignoreList)
			local raycastParams = RaycastParams.new()
			raycastParams.FilterType = Enum.RaycastFilterType.Exclude
			local filterDescendantsInstances = {}
			local ignore = ignoreList or {}

			for _, part in ipairs(ignore) do
				if part then
					table.insert(filterDescendantsInstances, part)
				end
			end

			local climbCeilingProbe = getgenv().ClimbCeilingProbe or 80

			for i = 1, 6 do
				raycastParams.FilterDescendantsInstances = filterDescendantsInstances
				local hit = Workspace:Raycast(origin, Vector3.new(0, climbCeilingProbe, 0), raycastParams)

				if not (hit and hit.Instance) then
					return nil
				end

				local hitPart = hit.Instance

				if
					hitPart.CanCollide
					and hitPart.Transparency < 1
					and not (getgenv().isBarrierPart and getgenv().isBarrierPart(hitPart))
				then
					return hit.Position.Y, hitPart
				end

				table.insert(filterDescendantsInstances, hitPart)
				climbCeilingProbe -= hit.Position.Y - origin.Y

				if climbCeilingProbe <= 0 then
					return nil
				end

				origin = hit.Position
			end

			return nil
		end

		-- where to land when a tween climbs a wall: on top of it, or nil when it reaches the ceiling
		-- (indoors)
		getgenv().climbLanding = function(root, hitPos, normal, wall, rayParams, ignoreList, label)
			local wallTopY = wall.Position.Y + wall.Size.Y / 2
			local vector = hitPos + -normal * 4
			local maxY = math.max(wallTopY, root.Position.Y) + 60
			local ceilingY = nil
			local ceilingPart = nil

			if getgenv().ClimbIndoorCheck ~= false then
				ceilingY, ceilingPart = getgenv().ceilingAbove(root.Position, ignoreList)
			end

			local y

			if ceilingY then
				if ceilingY - (getgenv().ClimbWallGap or 3) <= wallTopY then
					getgenv().ClimbIndoorHits = (getgenv().ClimbIndoorHits or 0) + 1
					local bmLog = getgenv().ClimbIndoorLog ~= false
						and getgenv().BMLog
						and tick() - (getgenv().LastIndoorClimbLog or 0) >= 3

					if not bmLog then
						return nil
					end

					getgenv().LastIndoorClimbLog = tick()
					local log = getgenv().BMLog
					local labelText = tostring(label)
					log(
						string.format(
							"[Tween] %s: '%s' goes up to the ceiling ('%s' at Y %d) - that is a wall, not climbing it onto the roof (x%d).",
							labelText,
							tostring(wall.Name),
							tostring(ceilingPart and ceilingPart.Name),
							math.floor(ceilingY),
							getgenv().ClimbIndoorHits
						)
					)
					return nil
				end

				y = math.min(maxY, ceilingY - (getgenv().ClimbCeilingPad or 1))
			else
				y = maxY
			end

			local hit = Workspace:Raycast(Vector3.new(vector.X, y, vector.Z), Vector3.new(0, -400, 0), rayParams)
			local probePoint

			if hit and hit.Instance then
				probePoint = Vector3.new(hit.Position.X, hit.Position.Y + 4, hit.Position.Z)
			else
				probePoint = Vector3.new(vector.X, wallTopY + 4, vector.Z)
			end

			local landing = getVector(probePoint, ignoreList, 30)

			if ceilingY and landing.Y > ceilingY - 2 then
				local x = landing.X
				local cappedY = math.max(ceilingY - 3, root.Position.Y)
				landing = Vector3.new(x, cappedY, landing.Z)
			end

			return landing
		end

		-- --------------------------------------------------------------------
