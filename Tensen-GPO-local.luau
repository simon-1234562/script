				end

				local magnitude = math.huge
				local root = startRoot and startRoot.Parent and startRoot
					or localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")

				if root then
					magnitude = (origin - root.Position).Magnitude
