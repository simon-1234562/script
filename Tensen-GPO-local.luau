			do
				-- the config name saved in autoload.txt, or nil
				local function readAutoload()
					local ok, result = pcall(function()
						if isfile("Tensen Hub/Configs/autoload.txt") then
							return readfile("Tensen Hub/Configs/autoload.txt")
						end
					end)

					if ok and type(result) == "string" and result ~= "" then
						return result
					end

					return nil
				end

				local function cleanName(name)
					return (tostring(name or ""):gsub("[^%w%-_ ]", ""))
				end

				local defaultConfig =
					cleanName("GrandPieceOnline" .. tostring(game:GetService("Players").LocalPlayer.Name))

				if getgenv().AutoSave == nil then
					getgenv().AutoSave = true
				end

				getgenv().AutoSaveQueued = false

				-- saves the config shortly after a change (several changes are saved together)
				queueAutoSave = function()
					if getgenv().AutoSave == false then
						return
					end

					if getgenv().AutoSaveQueued then
						return
					end

					getgenv().AutoSaveQueued = true

					task.delay(1, function()
						getgenv().AutoSaveQueued = false

						pcall(function()
							tensenUILib:SaveConfig(defaultConfig)
						end)
					end)
				end

				if getgenv().AutoLoad == nil then
					getgenv().AutoLoad = true
				end

				-- the saved config names, sorted
				local function getConfigs()
					local configs = tensenUILib:ListConfigs()
					table.sort(configs)

					if #configs == 0 then
						configs = { "None" }
					end

					return configs
				end

				local typed = ""
				local selectedConfig = nil
				local configDropdown = nil
				local autoloadParagraph = nil

				-- refreshes the config dropdown
				local function refreshConfigs()
					local configs = getConfigs()

					pcall(function()
						configDropdown:SetOptions(configs)
					end)

					if not table.find(configs, selectedConfig) then
						selectedConfig = configs[1] ~= "None" and configs[1] or nil
					end
				end

				local function refreshAutoload()
					local autoload = readAutoload()

					pcall(function()
						autoloadParagraph:Set(
							autoload and "Autoloads " .. autoload .. " when the script runs" or "Nothing autoloads"
						)
					end)
				end

				local function notify(title, content, kind)
					window:Notify({ Title = title, Content = content, Type = kind or "info", Duration = 3 })
				end

				Configs:AddSection("Config")

				Configs:AddInput({
					Name = "Config Name",
					Description = "Name for your saved settings",
					Default = "",
					Placeholder = "My Config",
					Callback = function(configName)
						typed = cleanName(configName)
					end,
				})

				configDropdown = Configs:AddDropdown({
					Name = "Select Config",
					Description = "Choose a saved config",
					Options = getConfigs(),
					Default = getConfigs()[1],
					Callback = function(selectConfig)
						if type(selectConfig) == "table" then
							selectConfig = selectConfig[1]
						end

						selectedConfig = selectConfig and selectConfig ~= "None" and selectConfig or nil
					end,
				})

				local config = getConfigs()[1]
				selectedConfig = config ~= "None" and config or nil

				Configs:AddButton({
					Name = "Save Config",
					Description = "Save current settings",
					Primary = true,
					-- saves the current settings as a config (typed name, else the selected one)
					Callback = function()
						local configName = typed ~= "" and typed or selectedConfig

						if not configName then
							notify("Config", "Type a config name first", "warning")
							return
						end

						if tensenUILib:SaveConfig(configName) then
							refreshConfigs()
							selectedConfig = configName

							pcall(function()
								configDropdown:Set(configName)
							end)

							notify("Config", "Saved " .. configName, "success")
						else
							notify("Config", "Could not save " .. configName, "error")
						end
					end,
				})

				Configs:AddButton({
					Name = "Load Config",
					Description = "Load the selected config",
                    Callback = function()
                        if not selectedConfig then notify("Config","Pick a config first","warning");return end
                        local ok,result=pcall(function()return tensenUILib:LoadConfig(selectedConfig)end)
                        notify("Config",ok and result and("Loaded "..selectedConfig)or"Could not load that config",ok and result and"success"or"warning")
                    end,
				})

				Configs:AddButton({
					Name = "Delete Config",
					Description = "Delete the selected config",
					-- marks the selected config to load automatically next time
					Callback = function()
						if not selectedConfig then
							notify("Config", "Pick a config first", "warning")
							return
						end

						local configName = selectedConfig

						if tensenUILib:DeleteConfig(configName) then
							if readAutoload() == configName then
								pcall(delfile, "Tensen Hub/Configs/autoload.txt")
								refreshAutoload()
							end

							refreshConfigs()
							notify("Config", "Deleted " .. configName, "success")
						else
							notify("Config", "Could not delete " .. configName, "error")
						end
					end,
				})

				Configs:AddButton({
					Name = "Refresh List",
					Description = "Reload the list of saved configs",
					Callback = function()
						refreshConfigs()
						notify("Config", "List refreshed", "info")
					end,
				})

				Configs:AddToggle({
					Name = "Auto Save",
					Description = "Automatically keep your settings saved to " .. defaultConfig,
					Default = getgenv().AutoSave ~= false,
					Flag = "AutoSaveToggle",
					-- auto save toggle
					Callback = function(autoSave)
						getgenv().AutoSave = autoSave

						if autoSave then
							pcall(function()
								tensenUILib:SaveConfig(defaultConfig)
							end)
						end

						autosave()
					end,
				})

                -- Configurations are loaded explicitly; no active feature starts from a saved config.

				task.spawn(function()
					while true do
						task.wait(60)

						if getgenv().AutoSave ~= false then
							pcall(function()
								tensenUILib:SaveConfig(defaultConfig)
							end)
						end
					end
				end)
