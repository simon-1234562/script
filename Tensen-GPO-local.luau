			end

			local attribute = nil

			pcall(function()
				attribute = character:GetAttribute(getgenv().FaceMouseAttr or "PreviousFaceMouse")
			end)

			if type(attribute) == "boolean" then
				return attribute and 0 or math.huge
			end

			if type(attribute) ~= "number" then
				return nil
			end

			local now = os.time()

			pcall(function()
