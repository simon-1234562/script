			end

			getgenv().BusoFromRoom = getgenv().BusoFromRoom or "4"

			-- true when buso haki may be used here (from room BusoFromRoom on)
			getgenv().busoAllowedNow = function()
				local busoFromRoom = getgenv().BusoFromRoom

				if busoFromRoom == false then
					return true
				end

				local roomName, _room, how = getgenv().currentCakeStage()

				if how ~= "inside" then
					return false
				end

				local num = tonumber(roomName)
				local fromRoom = tonumber(busoFromRoom)

				if not num or not fromRoom then
					return false
				end

				return num >= fromRoom
			end

			getgenv().CampClear = getgenv().CampClear ~= false
			getgenv().CampRooms = getgenv().CampRooms or { ["4"] = true, ["5"] = true }

			if getgenv().CampRooms["5"] == nil then
				getgenv().CampRooms["5"] = true
			end

			getgenv().CampRoomPad = getgenv().CampRoomPad or 0
			getgenv().CampBossOnly = getgenv().CampBossOnly or { ["5"] = true }

			if getgenv().CampBossOnly["5"] == nil then
				getgenv().CampBossOnly["5"] = true
			end

			-- living mobs inside a camp room's box
			getgenv().campMobs = function(instance)
				local mobs = {}
				local npcs = Workspace:FindFirstChild("NPCs")

				if not (npcs and instance and instance.Parent) then
					return mobs
				end

				local cframe, size = getgenv().roomBox(instance)

				if not (cframe and size) then
					return mobs
				end

				local campRoomPad = getgenv().CampRoomPad or 0
				local bossOnly = (getgenv().CampBossOnly or {})[instance.Name] == true

				for _, child in ipairs(npcs:GetChildren()) do
					local humanoid = child:FindFirstChildOfClass("Humanoid")
					local npcRoot = getgenv().npcRoot and getgenv().npcRoot(child)

					if bossOnly and not (getgenv().isBigMomNPC and getgenv().isBigMomNPC(child)) then
						humanoid = nil
					end

					if
						humanoid
						and npcRoot
						and humanoid.Health > 0
						and not (getgenv().isIgnoredNPC and getgenv().isIgnoredNPC(child))
					then
						local localPos = cframe:PointToObjectSpace(npcRoot.Position)

						if
							math.abs(localPos.X) <= size.X / 2 + campRoomPad
							and math.abs(localPos.Y) <= size.Y / 2 + campRoomPad
							and math.abs(localPos.Z) <= size.Z / 2 + campRoomPad
						then
							mobs[#mobs + 1] = child
						end
					end
				end

				return mobs
			end

			getgenv().CampChaseLock = getgenv().CampChaseLock ~= false
		end

		getgenv().CampChaseAlways = getgenv().CampChaseAlways ~= false
		getgenv().CampGrace = getgenv().CampGrace or 25

		getgenv().CampEmptyDone = getgenv().CampEmptyDone ~= false

		getgenv().BossAppearMax = getgenv().BossAppearMax or 60
		getgenv().CampClearHold = getgenv().CampClearHold or 3
		getgenv().CampReach = getgenv().CampReach or 18

		getgenv().CampChaseRefire = getgenv().CampChaseRefire or 1

		getgenv().CampChaseSpeed = getgenv().CampChaseSpeed or getgenv().TweenSpeed or 65
		getgenv().CampSeen = {}
		getgenv().CampCleared = {}
		getgenv().CampSince = {}
		getgenv().CampClearAt = {}

		-- the camp room we are in, its model and its living mobs; nil when not in a camp room
		getgenv().campCheck = function()
			if getgenv().CampClear == false then
				return nil
			end

			local roomName, roomModel, how = getgenv().currentCakeStage()

			if how ~= "inside" or not roomName or not roomModel then
				return nil
			end

			if not (getgenv().CampRooms or {})[roomName] then
				return nil
			end

			return roomName, roomModel, getgenv().campMobs(roomModel)
		end

		getgenv().Backtrack = getgenv().Backtrack ~= false
		getgenv().BacktrackForget = getgenv().BacktrackForget or 30
		getgenv().DeathKeepDepth = getgenv().DeathKeepDepth or 300
		getgenv().BacktrackGiveUp = getgenv().BacktrackGiveUp or 45
		getgenv().BacktrackSince = {}
		getgenv().BacktrackGaveUp = {}

		-- true (with room numbers) when we are back in an earlier room than the deepest one reached
		local function backtrackingNow()
			if getgenv().Backtrack == false then
				return false
			end

			local roomName, _room, how = getgenv().currentCakeStage()

			if how ~= "inside" or roomName == nil then
				return false
			end

			if (getgenv().BacktrackGaveUp or {})[tostring(roomName)] then
				return false
			end

			local num = tonumber(roomName)
			local deepest = tonumber(getgenv().DeepestRoom)

			if not (num and deepest) then
				return false
			end

			if deepest <= num then
				return false
			end

			return true, tostring(roomName), num, deepest
		end

		getgenv().backtrackingNow = backtrackingNow
		getgenv().DeepestRoom = getgenv().DeepestRoom
		getgenv().DeepestAt = getgenv().DeepestAt or 0

		getgenv().OutsideSince = nil

		getgenv().BacktrackRoom = nil

		-- remembers the deepest room reached this run (forgotten after a while outside the dungeon)
		getgenv().noteRoomDepth = function(roomName, how)
			if getgenv().reactionOwnsUs() then
				return
			end

			if how == "inside" and tonumber(roomName) then
				getgenv().OutsideSince = nil
				local num = tonumber(getgenv().DeepestRoom)

				if not num or tonumber(roomName) > num then
					getgenv().DeepestRoom = tostring(roomName)
					getgenv().DeepestAt = tick()
				end

				return
			end

			getgenv().OutsideSince = getgenv().OutsideSince or tick()
			local elapsed = tick() - (getgenv().DeathAt or 0)
			local recentlyDied = (getgenv().DeathAt or 0) > 0 and elapsed < (getgenv().DeathKeepDepth or 300)
			local forget = getgenv().DeepestRoom and not getgenv().ReturnAfterDeath and not recentlyDied

			if forget then
				local now = tick()
				forget = now - getgenv().OutsideSince >= (getgenv().BacktrackForget or 30)
			end

			if not forget then
				return
			end

			if getgenv().BMLog then
				getgenv().BMLog(
					string.format(
						"[Room] Out of the dungeon for %ds - forgetting that we got as far as room %s, so a fresh run starts from the top.",
						math.floor(getgenv().BacktrackForget or 30),
						tostring(getgenv().DeepestRoom)
					)
				)
			end

			getgenv().DeepestRoom = nil
			getgenv().BacktrackRoom = nil
		end

		getgenv().RoomReturn = getgenv().RoomReturn ~= false
		getgenv().RoomReturnGrace = getgenv().RoomReturnGrace or 3

		getgenv().RoomReturnReach = getgenv().RoomReturnReach or 20

		getgenv().RoomReturnGiveUp = getgenv().RoomReturnGiveUp or 60

		getgenv().RoomReturnLog = getgenv().RoomReturnLog ~= false

		getgenv().RoomReturns = getgenv().RoomReturns or 0
		getgenv().LastInsideRoom = nil
		getgenv().LastInsidePos = nil
		getgenv().LastInsideAt = 0
		getgenv().OutOfRoomSince = nil
		getgenv().LastDungeonPos = nil
		getgenv().LastDungeonAt = 0

		-- remembers where we last were inside a room, used to walk back after being thrown out
		getgenv().noteInsideRoom = function(roomName, how, instance)
			if getgenv().reactionOwnsUs() then
				return false
			end

			if (how == "inside" or how == "nearest") and instance and instance.Parent then
				getgenv().LastDungeonPos = instance.Position
				getgenv().LastDungeonAt = tick()
			end

			if how ~= "inside" or roomName == nil then
				return false
			end

			getgenv().LastInsideRoom = tostring(roomName)
			getgenv().LastInsideAt = tick()

			if instance and instance.Parent then
				getgenv().LastInsidePos = instance.Position
			end

			getgenv().OutOfRoomSince = nil
			return true
		end

		getgenv().reactionOwnsUs = function()
			return getgenv().Reacting ~= nil
