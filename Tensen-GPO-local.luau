			getgenv().OceanTopY = nil

			getgenv().waterSurfaceY = function()
				local oceanTopY = getgenv().OceanTopY

				if type(oceanTopY) == "number" then
					return oceanTopY, "the ocean"
				end

				return getgenv().WaterLevelY, "the hardcoded water level"
			end

			local oceanFolder = getgenv().findOceanFolder()

			task.spawn(function()
				local instances = nil
				local now = 0
				local scannedOceanFolder = nil
