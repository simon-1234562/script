		-- offset that swings the attack position in and out through the boss every shuffle period
		getgenv().m1ShuffleOffset = function(model)
			if getgenv().M1Shuffle == false then
				return Vector3.zero
			end

			if not (model and model.Parent) then
				return Vector3.zero
			end

			local who = getgenv().m1ShuffleWho(model)

			if not who then
				return Vector3.zero
			end

			local onMochi = who == "him"
			local onJuice = who == "juice"

			if type(getgenv().reactionOwnsUs) == "function" and getgenv().reactionOwnsUs() then
				return Vector3.zero
			end

			local character = localPlayer and localPlayer.Character
			local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
			local modelRoot = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart

			if not (humanoidRootPart and modelRoot and modelRoot.Parent) then
				return Vector3.zero
			end

			local vector = Vector3.new(
				humanoidRootPart.Position.X - modelRoot.Position.X,
				0,
				humanoidRootPart.Position.Z - modelRoot.Position.Z
			)

			if (getgenv().M1ShuffleRange or 45) < vector.Magnitude then
				return Vector3.zero
			end

			local m1ShuffleState = getgenv().M1ShuffleState
			local now = tick()
			local m1ShufflePeriodJuice = onJuice and (getgenv().M1ShufflePeriodJuice or 0.4)
				or onMochi and (getgenv().M1ShufflePeriodMochi or 0.4)
				or getgenv().M1ShufflePeriod
				or 0.4

			if m1ShufflePeriodJuice <= now - (m1ShuffleState.at or 0) then
				m1ShuffleState.at = now
				m1ShuffleState.phase = m1ShuffleState.phase == 1 and -1 or 1
				m1ShuffleState.dir = nil
				getgenv().M1Shuffles = (getgenv().M1Shuffles or 0) + 1
			end

			local dir = m1ShuffleState.dir

			if not (dir and dir.Magnitude > 0.001) then
				dir = vector.Magnitude > 0.001 and vector.Unit or Vector3.new(0, 0, 1)
				m1ShuffleState.dir = dir
			end

			local m1ShuffleStuds = getgenv().M1ShuffleStuds or 12

			if getgenv().M1ShuffleThrough ~= false then
				if (m1ShuffleState.phase or 1) == 1 then
					return dir * m1ShuffleStuds
				end

				return Vector3.zero
			end

			return dir * (m1ShuffleStuds * (m1ShuffleState.phase or 1))
		end

