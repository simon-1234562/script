				.. tostring(getgenv().currentStageName)
			local inRoom = getgenv().inCakeRoom()
			local inRoomText = tostring(inRoom)
			local distLine = humanoidRootPart
					and string.format(
						" | %.0f studs to the drop point, %.0f to the start point",
						(humanoidRootPart.Position - getgenv().CakeDropCF.Position).Magnitude,
						(humanoidRootPart.Position - getgenv().bigMomStartAt().Position).Magnitude
					)
				or ""
			lines[1] = stepLine
			lines[2] = enableLine
			lines[3] = placeLine
			lines[4] = orderLine
			lines[5] = wantsLine
			lines[6] = posLine
			lines[7] = stageLine
			lines[8] = "  in the cake room = " .. inRoomText .. distLine
			local report = table.concat(lines, "\n")

			return report
		end

