				if not wanted then
					local ok, result = pcall(getgenv().playerBlockingFlag)

					if ok and result then
						wanted = true
						reason = "the server Blocking flag"
					end
				end

				if not wanted then
					getgenv().WaitUnblockSince = nil
					return false
				end

				local now = tick()
				getgenv().WaitUnblockSince = getgenv().WaitUnblockSince or now
				local elapsed = now - getgenv().WaitUnblockSince

				if (getgenv().WaitUnblockMax or 3) < elapsed then
					local bmLog = getgenv().WaitUnblockLog ~= false and getgenv().BMLog
					local shouldLog = bmLog and now - (getgenv().LastUnblockGiveUp or 0) >= 5

					if shouldLog then
						getgenv().LastUnblockGiveUp = now
						getgenv().BMLog(
							string.format(
								"[Block] %s has held a block for %.1fs and it is still not released - moving again rather than standing here (the orphan watchdog will force it off).",
								tostring(reason),
								elapsed
							)
						)
					end

					return false, reason, true
				end

