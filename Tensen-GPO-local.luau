				part.CFrame = cframe * part.CFrame.Rotation
				local assemblyLinearVelocity = part.AssemblyLinearVelocity

				if assemblyLinearVelocity.Y < 0 then
					part.AssemblyLinearVelocity = Vector3.new(assemblyLinearVelocity.X, 0, assemblyLinearVelocity.Z)
				end

				local bmLog = getgenv().BMLog

				if bmLog then
