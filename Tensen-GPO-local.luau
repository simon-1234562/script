		task.spawn(function()
			local cFrame = nil
			local rayParams = RaycastParams.new()
			rayParams.FilterType = Enum.RaycastFilterType.Exclude
			local now = nil

			while task.wait(0.25) do
				if bmStale() then
					break
				end

				if getgenv().FallRecovery == false then
					continue
				end

				if not getgenv().EnableBigMom then
					continue
				end

				local evadingBoss = getgenv().EvadingBoss or getgenv().LowHealthActive

				if evadingBoss then
					cFrame = nil
					now = nil
					continue
				elseif getgenv().ReplayRunning == true then
					cFrame = nil
					now = nil
					continue
				end

				if getgenv().BarrierFlightActive == true then
					cFrame = nil
					now = nil
					continue
				end

				local character = localPlayer.Character
				local rootPart = character and character:FindFirstChild("HumanoidRootPart")

				if not rootPart or not rootPart.Parent then
					now = nil
					continue
				end

				if getgenv().RecoveryYieldsToTween ~= false and tweenState.Enabled then
					cFrame = nil

					if rootPart.Position.Y < (getgenv().VoidY or -100) then
						getgenv().RecoveryVoidStops = (getgenv().RecoveryVoidStops or 0) + 1
						noopLog(
							string.format(
								"[Recovery] Y %d is under the world with a tween running - dropping the tween and letting the watchdog re-fire it from here (x%d).",
								math.floor(rootPart.Position.Y),
								getgenv().RecoveryVoidStops
							)
						)
						setNoclip(false)
						pcall(stopTween)
						getgenv().TweenNeedsRetween = true
					end

					now = nil
					continue
				end

				rayParams.FilterDescendantsInstances = { character }
				local hit

				if getgenv().FallRecoverySolidOnly == false then
					hit = Workspace:Raycast(rootPart.Position, Vector3.new(0, -18, 0), rayParams)
				else
					local filterDescendantsInstances = { character }
					local position = rootPart.Position
					local fallRecoveryLayers = getgenv().FallRecoveryLayers or 6
					local probeDepth = 18
					hit = nil

					for i = 1, fallRecoveryLayers do
						hit = nil

						if probeDepth <= 0 then
							break
						end

						rayParams.FilterDescendantsInstances = filterDescendantsInstances
						local downHit = Workspace:Raycast(position, Vector3.new(0, -probeDepth, 0), rayParams)
						local hitPart = downHit and downHit.Instance
						hit = nil

						if not hitPart then
							break
						end

						local floorPart = downHit.Instance
						local canCollide = floorPart.CanCollide

						if canCollide and getgenv().isBarrierPart and getgenv().isBarrierPart(floorPart) then
							canCollide = false
						end

						if canCollide then
							hit = downHit
							break
						end

						probeDepth = probeDepth - (position.Y - downHit.Position.Y) - 0.05
						position = downHit.Position - Vector3.new(0, 0.05, 0)
						table.insert(filterDescendantsInstances, floorPart)
						hit = nil
					end

					rayParams.FilterDescendantsInstances = { character }
				end

				if hit and hit.Instance then
					cFrame = CFrame.new(hit.Position + Vector3.new(0, 4, 0)) * rootPart.CFrame.Rotation
					now = nil
					continue
				end

				if not cFrame then
					continue
				end

				local dropBelow = cFrame.Position.Y - rootPart.Position.Y
				local fellFar = dropBelow > (getgenv().FallRecoveryDrop or 60)
				local inVoid = rootPart.Position.Y < (getgenv().VoidY or -100)

				if not (fellFar or inVoid) then
					now = nil
					continue
				end

				now = now or tick()

				if not (tick() - now >= 0.5) then
					continue
				end

				noopLog(
					string.format(
						"[Recovery] Under the map (%d studs below the last floor) - restoring collisions and blinking back.",
						math.floor(dropBelow)
					)
				)
				local enabled = tweenState.Enabled
				setNoclip(false)
				pcall(stopTween)

				if enabled then
					getgenv().TweenNeedsRetween = true
					getgenv().RecoveryKilledTweens = (getgenv().RecoveryKilledTweens or 0) + 1
				end

				pcall(function()
					if not getgenv().firebreathMovementHeld() then
						rootPart.CFrame = cFrame
					end

					rootPart.AssemblyLinearVelocity = Vector3.zero
					rootPart.Velocity = Vector3.zero
				end)
				task.wait(0.4)
				now = nil
			end
		end)

