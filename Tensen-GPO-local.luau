			if wholeCakeLiveMemo.at and tick() - wholeCakeLiveMemo.at < (getgenv().WholeCakeLiveFor or 1) then
				return wholeCakeLiveMemo.live, wholeCakeLiveMemo.why, wholeCakeLiveMemo.n, wholeCakeLiveMemo.total
			end

			local live, why, litCount, total = getgenv().wholeCakeLiveRaw()
			wholeCakeLiveMemo.at = tick()
			wholeCakeLiveMemo.live = live
			wholeCakeLiveMemo.why = why
			wholeCakeLiveMemo.n = litCount
			wholeCakeLiveMemo.total = total
