				return false, magnitude
			end

			return true, magnitude
		end

		-- tweens to a CFrame and waits until within `distance` (then settles); false with a reason on failure
		getgenv().goTo = function(target, label, distance)
			distance = distance or 8
			pcall(stopTween)
			getgenv().BigMomStatus = tostring(label)

			tweenToCFrame({
				CFrame = target,
				Speed = getgenv().CakeTweenSpeed or 60,
				StopDistance = distance,
				TeleportOnClose = true,
				TeleportDistance = distance,
			})

			local now = tick()
			local deadline = now + (getgenv().TravelTimeout or 30)

			repeat
				task.wait(0.1)

				if bmStale() or not getgenv().EnableBigMom then
					return false, "stopped"
				end

				local humanoidRootPart = localPlayer.Character
					and localPlayer.Character:FindFirstChild("HumanoidRootPart")

				if humanoidRootPart and (humanoidRootPart.Position - target.Position).Magnitude <= distance then
					local settled, settleWhy = getgenv().settleAfterArrive(target, label, distance)

					if not settled then
						return false,
							string.format(
								"drifted %d studs off %s while settling",
								math.floor(settleWhy or -1),
								tostring(label)
							)
					end

					return true
				end
			until tick() > deadline

			local settled = false
			local labelText = tostring(label)
			return settled, string.format("did not reach %s within %.0fs", labelText, getgenv().TravelTimeout or 30)
		end

		-- picks up one cake and drops it at the drop point, waiting for the pick-up and drop sounds
		getgenv().deliverOneCake = function(instance, cakePart, flavour)
			if not (instance and instance.Parent) then
				return false, "the cake went away"
			end

			if not (cakePart and cakePart.Parent) then
				return false, "that cake has no part to walk to"
			end

			if not flavour then
				flavour = instance.Name
			end

			getgenv().BigMomStep = "fetching " .. tostring(flavour)
			local reached, reachWhy = getgenv().goTo(CFrame.new(cakePart.Position), "the cake", getgenv().CakeReachDist)

			if not reached then
				return false, tostring(reachWhy)
			end

			getgenv().BigMomStep = "picking it up"
			local cakeRetries = getgenv().CakeRetries or 3
			local pickedUp = false

			for i = 1, cakeRetries do
				if not cakePart.Parent then
					return false, "the cake went away"
				end

				local pickWatch = getgenv().armSoundWatch(cakePart, getgenv().CakePickUpSound or "CakePickUp")

				if i > 1 then
					getgenv().waitBeforeClick("another go at the cake")
				end

				getgenv().tapE(0)
				pickedUp =
					getgenv().waitSoundWatch(pickWatch, (getgenv().PickUpTimeout or 8) / (getgenv().CakeRetries or 3))

				if pickedUp then
					break
				end

				getgenv().BMLog(string.format("[Cake] tap %d did not take, trying again", i))
			end

			if not pickedUp then
				return false, "pressed E but no " .. tostring(getgenv().CakePickUpSound)
			end

			getgenv().BigMomStep = "carrying it to Mama"
			local dropReached, dropWhy = getgenv().goTo(getgenv().CakeDropCF, "the drop point", getgenv().DropReachDist)

			if not dropReached then
				return false, tostring(dropWhy)
			end

			getgenv().BigMomStep = "dropping it"
			local dropped = false
			local cakeRetries = getgenv().CakeRetries or 3

			for i = 1, cakeRetries do
				local cake = cakePart and cakePart.Parent and cakePart or nil

				if not cake then
					return false, "lost track of the cake"
				end

				local dropWatch = getgenv().armSoundWatch(cake, getgenv().CakeDropSound or "CakeDrop")

				if 1 < i then
					getgenv().waitBeforeClick("another go at the drop")
				end

				getgenv().tapE(0)

				dropped =
					getgenv().waitSoundWatch(dropWatch, (getgenv().DropTimeout or 8) / (getgenv().CakeRetries or 3))

				if dropped then
					break
				end

				getgenv().BMLog(string.format("[Cake] drop tap %d did not take, trying again", i))
			end

			if not dropped then
				return false, "pressed E but no " .. tostring(getgenv().CakeDropSound)
			end

			if getgenv().CakeDeletePrompt ~= false and instance and instance.Parent then
				local count = 0

				for _, descendant in ipairs(instance:GetDescendants()) do
					if not descendant:IsA("ProximityPrompt") then
						continue
					end

					-- the dump lost the call that removed the prompt, so every prompt is counted
					count += 1
				end

				if count > 0 and getgenv().BMLog then
					getgenv().BMLog(
						string.format(
							"[Cake] delivered - removed %d prompt(s) from '%s' so it cannot be picked up again.",
							count,
							tostring(instance.Name)
						)
					)
				end
			end

			return true
		end

		getgenv().CakeDeliverMax = getgenv().CakeDeliverMax or 6

		-- delivers every cake Big Mom asked for; returns success, how many were delivered, and a reason
		getgenv().deliverCake = function(flavour)
			local wanted = flavour or getgenv().wantedCake()

			if not wanted then
				return false, 0, "nothing has been asked for"
			end

			local tried = {}
			local stopped = false
			local cakeDeliverMax = getgenv().CakeDeliverMax or 6
			local delivered = 0

			for i = 1, cakeDeliverMax do
				if bmStale() or not getgenv().EnableBigMom then
					return false, delivered, "stopped"
				end

				local nowWanted = getgenv().wantedCake()

				if nowWanted and nowWanted ~= wanted then
					getgenv().BMLog(
						string.format(
							"[Cake] she switched from %s to %s mid-set after %d - taking the new order.",
							tostring(wanted),
							tostring(nowWanted),
							delivered
						)
					)
					return delivered > 0, delivered, "flavour changed"
				end

				local cakes = getgenv().cakesByFlavour(wanted, tried)

				if #cakes == 0 and delivered == 0 then
					local count = 0

					for _, cakeFolder in ipairs(getgenv().cakeFolders()) do
						for _, child in ipairs(cakeFolder:GetChildren()) do
							if string.lower(child.Name) == string.lower(wanted) then
								count += 1
							end
						end
					end

					if not stopped then
						getgenv().BigMomStep = "waiting for the " .. tostring(wanted) .. " cakes to load in"
						stopped = true

						if getgenv().waitForCake(wanted) then
							continue
						end

						return false, 0, string.format("no '%s' in the room", tostring(wanted))
					end

					return false, 0, string.format("no '%s' in the room", tostring(wanted))
				end

				local cake = cakes[1]
				getgenv().BMLog(
					string.format(
						"[Cake] %s %d/%d: taking the biggest left (volume %.1f, %d still here)",
						tostring(wanted),
						delivered + 1,
						delivered + #cakes,
						cake.vol,
						#cakes
					)
				)
				local deliveredOk, deliverWhy = getgenv().deliverOneCake(cake.cake, cake.main, wanted)

				if not deliveredOk then
					return false, delivered, tostring(deliverWhy)
				end

				tried[cake.cake] = true
				delivered += 1
				getgenv().BigMomRuns = (getgenv().BigMomRuns or 0) + 1
				getgenv().BMLog(
					string.format(
						"[Cake] delivered %s #%d (%d this session)",
						tostring(wanted),
						delivered,
						getgenv().BigMomRuns
					)
				)
			end

			local bmLog = getgenv().BMLog
			local wantedText = tostring(wanted)
			bmLog(
				string.format(
					"[Cake] stopped after %d of %s - the %d cap. Raise CakeDeliverMax if a round really is longer than that.",
					delivered,
					wantedText,
					getgenv().CakeDeliverMax or 6
				)
			)
			return delivered > 0, delivered, "hit the delivery cap"
		end

		getgenv().CakeFloorDone = getgenv().CakeFloorDone ~= false
