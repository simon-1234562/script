		-- the text in the cake dialogue box (rows joined in reading order), and the rows
		getgenv().readCakeDialogue = function()
			local instance, screenGui = getgenv().cakeTextFrame()

			if not instance then
				return nil
			end

			if getgenv().ScrapeOnlyWhenShown ~= false and screenGui then
				if screenGui:IsA("ScreenGui") and screenGui.Enabled == false then
					return nil
				end

				local mainFrame = screenGui:FindFirstChild("Main")

				if mainFrame and mainFrame:IsA("GuiObject") and not mainFrame.Visible then
					return nil
				end

				if not instance.Visible then
					return nil
				end
			end

			local lines = {}

			for _, child in ipairs(instance:GetChildren()) do
				if not (child:IsA("GuiObject") and child.Name == "Line") then
					continue
				end

				local rows = {}

				for _, row in ipairs(child:GetChildren()) do
					if row:IsA("GuiObject") then
						local textLabel = row:FindFirstChildWhichIsA("TextLabel", true)

						if textLabel then
							rows[#rows + 1] = { x = row.AbsolutePosition.X, t = textLabel.Text }
						end
					end
				end

				table.sort(rows, function(a, b)
					return a.x < b.x
				end)
				local ts = {}

				for _, row in ipairs(rows) do
					ts[#ts + 1] = row.t
				end

				lines[#lines + 1] = { y = child.AbsolutePosition.Y, text = table.concat(ts) }
			end

			if #lines == 0 then
				return nil
			end

			table.sort(lines, function(a, b)
				return a.y < b.y
			end)
			local texts = {}

			for _, row in ipairs(lines) do
				texts[#texts + 1] = row.text
			end

			return table.concat(texts), lines
		end

