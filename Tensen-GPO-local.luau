			if path then
				return path
			end

			local wholeCakeNodeMemo = getgenv().WholeCakeNodeMemo

			if
				wholeCakeNodeMemo.at
				and tick() - wholeCakeNodeMemo.at < (getgenv().WholeCakeScanGap or 2)
				and (wholeCakeNodeMemo.node == nil or wholeCakeNodeMemo.node.Parent)
			then
				return wholeCakeNodeMemo.node
			end

			local wholeCake = nil

			pcall(function()
				local islands = Workspace:FindFirstChild("Islands")
				local wholeCakeIsland = islands and islands:FindFirstChild("Whole Cake Island")

				if wholeCakeIsland then
					wholeCake = wholeCakeIsland:FindFirstChild("WholeCake", true)
				end
			end)

			wholeCakeNodeMemo.at = tick()
			wholeCakeNodeMemo.node = wholeCake
			return wholeCake
		end

		-- true when WholeCake's particle emitters are lit (Big Mom beaten), with a reason and counts
		getgenv().wholeCakeLiveRaw = function()
			local wholeCake = getgenv().wholeCakeNode()

			if not wholeCake then
				return nil, "WholeCake is not loaded", 0, 0
			end

			local count = 0
			local total = 0

			pcall(function()
				for _, descendant in ipairs(wholeCake:GetDescendants()) do
					if not descendant:IsA("ParticleEmitter") then
						continue
					end

					total += 1
					local enabled = true

					pcall(function()
						enabled = descendant.Enabled
					end)

					if enabled ~= false then
						count += 1
					end
				end
			end)

			if total == 0 then
				return nil, "no ParticleEmitter under it to read", 0, 0
			end

			if count > 0 then
				return true, string.format("%d of %d emitters are live", count, total), count, total
			end

			return false, string.format("all %d emitters are off", total), 0, total
		end

