			local function addEspToggle(tab, label, setting, description)
				local function onToggle(enabled)
					getgenv().ESP[setting] = enabled

					autosave()
				end

				tab:AddToggle({
					Name = label,
					Description = description,
					Default = getgenv().ESP[setting] == true,
					Flag = "ESP_" .. setting,
					Callback = onToggle,
				})
			end

			-- adds an ESP slider bound to getgenv().ESP[setting]
			local function addEspSlider(tab, label, setting, min, max, description, unit)
				local opts = {
					Name = label,
					Description = description,
					Min = min,
					Max = max,
					Suffix = unit or "",
					Default = tonumber(getgenv().ESP[setting]) or min,
					Flag = "ESP_" .. setting,
				}

				local function callback(value)
					local esp = getgenv().ESP
					esp[setting] = value

					autosave()
				end

				opts.Callback = callback
				tab:AddSlider(opts)
			end

			-- adds an ESP colour picker bound to getgenv().ESP[setting]
			local function addEspColor(tab, label, setting, description)
				local function onColor(colour)
					getgenv().ESPSetColor(setting, colour)

					queueAutoSave()
				end

				tab:AddColorPicker({
					Name = label,
					Description = description,
					Default = getgenv().ESPColor(setting),
					Flag = "ESP_" .. setting,
					Callback = onColor,
				})
			end

