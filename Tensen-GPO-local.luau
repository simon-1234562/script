		getgenv().noteMochiAnim = function(track)
			if getgenv().MochiSpy == false then
				return
			end

			local animation = track and track.Animation
			local mochiRecent = getgenv().animDigits(animation and animation.AnimationId)

			if not mochiRecent then
				return
			end

			if getgenv().MochiAnimNames[mochiRecent] == nil then
				local animName = "?"

				pcall(function()
					animName = tostring(animation.Name or "?")
				end)
				getgenv().MochiAnimNames[mochiRecent] = animName
				getgenv().MochiFirstSeen[mochiRecent] = tick()
				local bmLog = (getgenv().MochiNewLog ~= false) and getgenv().BMLog

				if bmLog then
					getgenv().BMLog(
						string.format("[Mochi] NEW TRACK  %-28s %s", string.sub(animName, 1, 28), mochiRecent)
					)
				end

				if
					not ((getgenv().MochiPlays[mochiRecent] or 0) >= (getgenv().MochiAmbient or 150))
					and (getgenv().MochiNoReact or {})[mochiRecent] == nil
				then
					local shout = getgenv().takeMochiShout()

					if shout then
						getgenv().MochiAnimLabels[mochiRecent] = shout

						if getgenv().BMLog then
							getgenv().BMLog(
								string.format(
									"[Mochi] NAMED %s -> '%s' - a NEW track started as he shouted it. Correlation, not proof: more than one track can play during one line.",
