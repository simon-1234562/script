				local hum = character and character:FindFirstChildOfClass("Humanoid")
				local mochiEmperor = getgenv().mochiEmperor and getgenv().mochiEmperor()

				if not (getgenv().EnableBigMom and getgenv().MochiSpy ~= false and hum and mochiEmperor) then
					getgenv().MochiRecent = nil
					getgenv().MochiRecentAt = 0
					lastHealth = nil
					lastMochi = nil
					continue
				end

				local health = hum.Health

				if hum == lastMochi and lastHealth and health < lastHealth - 0.5 then
					local mochiRecent = getgenv().MochiRecent

					if mochiRecent and tick() - (getgenv().MochiRecentAt or 0) <= (getgenv().MochiCredit or 2) then
						getgenv().learnMochiDamage(mochiRecent, lastHealth - health, getgenv().MochiRecentAt)
						lastHealth = health
						lastMochi = hum
					else
						lastHealth = health
						lastMochi = hum
					end
				else
					lastHealth = health
					lastMochi = hum
				end
			end
		end)

