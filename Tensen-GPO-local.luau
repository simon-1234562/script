			getgenv().OceanPath = getgenv().OceanPath or { "Env", "WaterStuff", "Ocean" }

			getgenv().OceanFallbackPaths = getgenv().OceanFallbackPaths or { { "Ocean", "OceanMeshes" }, { "Ocean" } }
			getgenv().WaterSurfaceCFrame = getgenv().WaterSurfaceCFrame
				or CFrame.new(-326.934845, -3.15842009, 117.919998, 1, 0, 0, 0, 1, 0, 0, 0, 1)

			getgenv().WaterLevelY = getgenv().WaterLevelY or getgenv().WaterSurfaceCFrame.Position.Y

			-- follows a list of child names from an instance; nil when one is missing
			getgenv().resolvePath = function(instance, path)
				path = path or {}

				for _, name in ipairs(path) do
