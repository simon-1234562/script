			end

			-- keeps a part from sinking below the water surface while walking on water; true when it held it
			-- up
			getgenv().holdAboveWater = function(part, limitY)
				local waterPlaneHold = getgenv().WaterPlaneHold

				if waterPlaneHold == false then
					return false
				end

				if getgenv().WaterOverride ~= true then
					return false
				end

				if getgenv().WaterOverrideType ~= "Collide" then
					return false
				end

				if getgenv().IsStunnedOverride then
					return false
				end

				if not part or not part.Parent then
					return false
				end

				local humanoid = part.Parent:FindFirstChildOfClass("Humanoid")

				if not humanoid or humanoid.Health <= 0 then
					return false
				end

				if getgenv().firebreathMovementHeld and getgenv().firebreathMovementHeld() then
					return false
				end

				if getgenv().noclipSuspended and getgenv().noclipSuspended(part.Parent) then
					return false
				end

				local surfaceY, surfaceName = getgenv().waterSurfaceY()
				local noSurface = type(surfaceY) ~= "number"

				if noSurface then
					return false
				end

				if limitY and limitY < surfaceY then
					return false
				end

				if (waterPlaneHold ~= true) and surfaceName == "the ocean" and not getgenv().characterNoclipped() then
					return false
				end

