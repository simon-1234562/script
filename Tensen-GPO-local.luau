env.__YanusGround = (function()
-- Ordinary Humanoid walking; no collision changes, hover, or position writes.
local g=getgenv()
local N={Status="idle",Serial=0}
local function parts()
    local c=game:GetService("Players").LocalPlayer.Character
    return c,c and c:FindFirstChild("HumanoidRootPart"),c and c:FindFirstChildOfClass("Humanoid")
end
local function flat(a,b)return Vector3.new(a.X-b.X,0,a.Z-b.Z).Magnitude end
function N.Stop(owner)
    local j=N.Current
    if not j or(owner and j.owner~=owner)then return end
    N.Serial+=1;N.Current=nil
    if j.blocked then j.blocked:Disconnect()end
    if j.path then j.path:Destroy()end
    if j.hum.Parent then j.hum:Move(Vector3.zero)end
    g.ForceDisableFastWalk=j.previousFastWalk
    N.Status="idle"
end
local function fail(j,reason)
    if N.Current~=j then return end
    N.Stop();N.Status=reason
    if j.owner=="island" then
        g.StartTweenIsland=false
        if g.TensenUILib then
            pcall(function()g.TensenUILib:SetFlag("StartTweenIslandToggle",false)end)
            pcall(function()g.TensenUILib:Notify({Title="Island walking stopped",Content=reason..". Use a boat for ocean travel.",Duration=8})end)
        end
        return
    end
    local q=g.__TensenAutoQuest
    if q and q.Enabled then q.Fail(reason)
    else
        g.TweenToNPC=false
        if g.TensenUILib then
            pcall(function()g.TensenUILib:SetFlag("TweenToNPCToggle",false)end)
            pcall(function()g.TensenUILib:Notify({Title="NPC walking stopped",Content=reason,Duration=6})end)
        end
        warn("[yanus walking] "..reason)
    end
end
local function clearLine(a,b,character)
    local p=RaycastParams.new();p.FilterType=Enum.RaycastFilterType.Exclude
    p.FilterDescendantsInstances={character,workspace:FindFirstChild("NPCs")or character};p.RespectCanCollide=true
    return workspace:Raycast(a,b-a,p)==nil
end
local function floorPoint(position,character)
    local p=RaycastParams.new();p.FilterType=Enum.RaycastFilterType.Exclude
    p.FilterDescendantsInstances={character,workspace:FindFirstChild("NPCs")or character};p.RespectCanCollide=true
    local hit=workspace:Raycast(position+Vector3.new(0,4,0),Vector3.new(0,-20,0),p)
    if not hit or hit.Material==Enum.Material.Water then return nil end
    return hit.Position
end
function N.Go(part,owner,range,offset)
    local character,root,hum=parts()
    if not part or not part.Parent or not root or not hum or hum.Health<=0 then N.Stop(owner);return false end
    if g.Noclip or g.ForceNoClipReal then
        local q=g.__TensenAutoQuest
        if q and q.Enabled then q.Fail("Turn off Noclip before using ground quest movement")end
        N.Status="Turn off Noclip before using ground movement";return false
    end
    local goal=part.Position+(offset or Vector3.zero)
    if flat(root.Position,goal)<=range and math.abs(root.Position.Y-goal.Y)<=4 and clearLine(root.Position,goal,character) then
        N.Stop(owner);N.Status="in range";return true
    end
    local current=N.Current
    if current and current.owner==owner and current.target==part then return true end
    N.Stop()
    if type(g.StopCurrentTween)=="function"then g.StopCurrentTween()end
    local j={owner=owner,target=part,range=range,offset=offset or Vector3.zero,hum=hum,previousFastWalk=g.ForceDisableFastWalk}
    N.Current=j;N.Serial+=1;local serial=N.Serial
    g.ForceDisableFastWalk=true;N.Status="finding a ground path"
    task.spawn(function()
        local ok,err=pcall(function()
            local lastProgress,lastPosition=tick(),root.Position
            local airSince,lastPlan,plannedGoal=nil,-math.huge,nil
            local waypoints,index,replan=nil,1,true
            while N.Current==j and N.Serial==serial do
                if character~=game:GetService("Players").LocalPlayer.Character or hum.Health<=0 or not part.Parent then N.Stop(owner);return end
                if g.Noclip or g.ForceNoClipReal then fail(j,"Turn off Noclip before using ground movement");return end
                local destination=part.Position+j.offset
                if flat(root.Position,destination)<=range and math.abs(root.Position.Y-destination.Y)<=4 and clearLine(root.Position,destination,character) then N.Stop(owner);N.Status="in range";return end
                if(root.Position-lastPosition).Magnitude>=1 then lastProgress=tick();lastPosition=root.Position end
                if tick()-lastProgress>10 then fail(j,"Ground route is blocked; move to an open path and retry");return end
                if hum.FloorMaterial==Enum.Material.Air then
                    airSince=airSince or tick()
                    if tick()-airSince>4 then fail(j,"Ground movement stopped: character has been airborne too long");return end
                    task.wait(0.15);continue
                end
                airSince=nil
                if plannedGoal and flat(destination,plannedGoal)>6 then replan=true end
                if replan and tick()-lastPlan>=1 then
                    hum:Move(Vector3.zero)
                    if j.blocked then j.blocked:Disconnect();j.blocked=nil end
                    if j.path then j.path:Destroy();j.path=nil end
                    local goalPoint=floorPoint(destination,character)
                    if not goalPoint then fail(j,"No walkable floor near the target; move closer using a ground route");return end
                    local path=game:GetService("PathfindingService"):CreatePath({AgentRadius=2,AgentHeight=6,
                        AgentCanJump=true,AgentCanClimb=false,WaypointSpacing=4,Costs={Water=math.huge}})
                    j.path=path
                    local computed=pcall(function()path:ComputeAsync(root.Position,goalPoint)end)
                    if N.Current~=j or N.Serial~=serial then return end
                    if not computed or path.Status~=Enum.PathStatus.Success then fail(j,"No walkable path found; move around the rocks manually and retry");return end
                    waypoints=path:GetWaypoints();index=1
                    if #waypoints==0 then fail(j,"Pathfinding returned an empty route");return end
                    j.blocked=path.Blocked:Connect(function(blockedIndex)if blockedIndex>=index then replan=true end end)
                    plannedGoal=destination;lastPlan=tick();replan=false
                end
                if replan then hum:Move(Vector3.zero)
                elseif waypoints then
                    while index<=#waypoints and flat(root.Position,waypoints[index].Position)<(index<#waypoints and 1.75 or math.min(range,1))
                        and math.abs(root.Position.Y-waypoints[index].Position.Y)<6 do index+=1 end
                    local waypoint=waypoints[index]
                    if not waypoint then replan=true
                    else
                        N.Status="walking around obstacles"
                        if waypoint.Action==Enum.PathWaypointAction.Jump then hum.Jump=true end
                        hum:MoveTo(waypoint.Position)
                    end
                end
                task.wait(0.15)
            end
        end)
        if not ok then fail(j,"Ground path error: "..tostring(err))end
    end)
    return true
end
return N

end)()

env.__TensenAutoQuest = (function()
-- Quest-only controller. Idle until explicitly enabled; never auto-loaded from config.
local g = getgenv()
local Q = { Enabled = false, Status = "off", Mode = "Sandora - Desert Bandits (Noah)", TargetOverride = "" }
Q.Modes = { "Sandora - Desert Bandits (Noah)", "Use current quest (accept manually)" }
Q.ProfileList = {
    {label=Q.Modes[1],giver="Noah",enemies={"Desert Bandit"},minLevel=10,tested=true},
    {label="Beginnings - Bandits (Daph, test)",giver="Daph",enemies={"Bandit"},minLevel=0},
    {label="Beginnings - Bandit Boss (Ronny, test)",giver="Ronny",enemies={"Bandit Boss"},minLevel=5,boss=true},
    {label="Sandora - Lucid (Tyrone, test)",giver="Tyrone",enemies={"Lucid"},minLevel=15,boss=true},
    {label="Shell's Town - Marines (Robert, test)",giver="Robert",enemies={"Corrupt Marine","Corrupted Marine"},minLevel=20},
    {label="Shell's Town - Bandits (Kevin, test)",giver="Kevin",enemies={"Shell's Bandit","Shells Bandit","Shell Bandit"},minLevel=25},
    {label="Shell's Town - Logan (Gozen, test)",giver="Gozen",enemies={"Axe Hand Logan"},minLevel=30,boss=true},
}
Q.Profiles = {}
for i,profile in ipairs(Q.ProfileList)do
    profile.placeId=3978370137
    Q.Profiles[profile.label]=profile
    if i>1 then Q.Modes[#Q.Modes+1]=profile.label end
end
Q.AutoMode="Recommended nearby quest (test)"
Q.CustomMode="Custom quest giver and enemy (test)"
Q.Modes[#Q.Modes+1]=Q.AutoMode;Q.Modes[#Q.Modes+1]=Q.CustomMode
Q.CustomGiver=""
local lastFailure, lastFailureTime = nil, -math.huge
function Q.Configure(mode, target, giver)
    if Q.Enabled then Q.Set(false); if Q.Toggle then Q.Toggle:Set(false) end end
    if mode then Q.Mode = mode end
    if giver ~= nil then Q.CustomGiver=tostring(giver):match("^%s*(.-)%s*$") end
    if target ~= nil then Q.TargetOverride = tostring(target):match("^%s*(.-)%s*$") end
    Q.Status = "off - " .. Q.Mode
end
local generation, cachedNoah, lastScan = 0, nil, -math.huge
local priorNPCSettings = nil
local lastChoiceButton, lastChoiceText, choiceAttempts = nil, nil, 0
local started, lastInput, travelStarted, travelRequested = nil, -math.huge, nil, false
local function normalize(text)
    return tostring(text or ""):lower():gsub("<[^>]*>", ""):gsub("[^%w]", "")
end
local function visible(item, gui)
    while item and item ~= gui do
        if item:IsA("GuiObject") and not item.Visible then return false end
        if item:IsA("ScreenGui") and not item.Enabled then return false end
        item = item.Parent
    end
    return item == gui
end
local function stopOwnTravel()
    if travelRequested and type(g.StopCurrentTween) == "function" then pcall(g.StopCurrentTween) end
    if g.__YanusGround then g.__YanusGround.Stop("quest") end
    travelRequested, travelStarted = false, nil
end
local function release()
    stopOwnTravel()
    g.AutoQuestBusy = false
    started = nil
    lastChoiceButton, lastChoiceText, choiceAttempts = nil, nil, 0
end
function Q.Set(enabled)
    generation += 1
    release()
    if priorNPCSettings then
        if g.__YanusGround then g.__YanusGround.Stop() end
        if type(g.StopCurrentTween) == "function" then pcall(g.StopCurrentTween) end
        g.TweenToNPC = false -- stopping Auto Farm must stop its NPC driver
        g.SelectedNPC = priorNPCSettings.selected
        priorNPCSettings = nil
    end
    Q.ActiveProfile = nil
    Q.Enabled = enabled == true
    Q.Status = Q.Enabled and "checking level and quest" or "off"
    if not Q.Enabled then return end
    if type(g.TweenToMob2) ~= "function" or type(g.Level) ~= "function" then
        Q.Fail("Full hub is not ready. Run the normal hub loader, wait for it to finish, then enable Auto Farm")
        return
    end
    local ok, level = pcall(g.Level)
    level = ok and tonumber(level) or nil
    if not level then Q.Fail("Could not read your character level from the HUD"); return end
    if Q.Mode ~= Q.Modes[2] then
        local profile,reason=Q.SelectProfile(level)
        if not profile then Q.Fail(reason or "No suitable quest profile nearby");return end
        if level<profile.minLevel then Q.Fail(profile.giver .. " requires level " .. profile.minLevel .. " or above");return end
        if game.PlaceId~=profile.placeId then Q.Fail("Travel to First Sea for this quest");return end
        Q.ActiveProfile=profile
    end
    if g.autofarm then
        Q.Fail("Turn off Recovered Quest Routes (Advanced) before using the main Auto Farm button")
        return
    end
    priorNPCSettings = {enabled = g.TweenToNPC, selected = g.SelectedNPC}
    local target = Q.ActiveProfile and Q.ProfileTarget(Q.ActiveProfile) or "Desert Bandit"
    if Q.Mode == Q.Modes[2] then
        local data, errorKind = Q.ReadQuest()
        if not data then Q.Fail("Accept the quest you want to farm first (" .. tostring(errorKind) .. ")"); return end
        target = Q.ResolveTarget(data.progress)
        if not target then Q.Fail("Could not match the quest enemy. Enter its exact NPC name in Quest enemy (optional)"); return end
    end
    g.SelectedNPC = target
    g.TweenToNPC = true
    local token = generation
    task.spawn(function()
        while Q.Enabled and token == generation do
            local ok, err = pcall(Q.Step)
            if not ok then Q.Fail("Quest error: " .. tostring(err)) end
            task.wait(0.5)
        end
    end)
end
function Q.Fail(reason)
    Q.Set(false)
    Q.Status = "stopped - " .. reason
    local showFailure = reason ~= lastFailure or tick() - lastFailureTime >= 15
    if showFailure then
        lastFailure, lastFailureTime = reason, tick()
        warn("[Auto Quest] " .. reason)
        local ui = g.TensenUILib
        if ui and type(ui.Notify) == "function" then
            pcall(function() ui:Notify({Title = "Auto Farm stopped", Content = reason, Duration = 6}) end)
        end
    end
    if Q.Toggle and type(Q.Toggle.Set) == "function" then pcall(function() Q.Toggle:Set(false) end) end
    -- Keep the reason visible even when the toggle's callback runs.
    Q.Status = "stopped - " .. reason
end
function Q.ReadQuest()
    local player = game:GetService("Players").LocalPlayer
    local gui = player:FindFirstChild("PlayerGui")
    local quest = gui and gui:FindFirstChild("Quest")
    local main = quest and quest:FindFirstChild("Main")
    local info = main and main:FindFirstChild("Info")
    local top = info and info:FindFirstChild("Top")
    local nameLabel = top and top:FindFirstChild("QuestName")
    local progressLabel = top and top:FindFirstChild("Progress")
    if not main or not info or not nameLabel or not progressLabel then return nil, "quest panel missing" end
    if not visible(info, gui) then return nil, "no active quest" end
    return {title = nameLabel.Text, progress = progressLabel.Text}
end
function Q.ResolveTarget(progress)
    local npcs = workspace:FindFirstChild("NPCs")
    local explicit = Q.TargetOverride ~= "" and Q.TargetOverride or nil
    local wanted = tostring(progress or ""):match("%d+%s*/%s*%d+%s*(.+)")
    local key = wanted and normalize(wanted:gsub("%(s%)", "")):gsub("s$", "")
    for _, model in ipairs(npcs and npcs:GetChildren() or {}) do
        if model:IsA("Model") and model:FindFirstChildOfClass("Humanoid") then
            if explicit and model.Name == explicit then return model.Name end
            if not explicit and key and normalize(model.Name):gsub("s$", "") == key then return model.Name end
        end
    end
    return nil
end
local function enemyKey(text)
    return normalize(tostring(text or ""):gsub("%(s%)", "")):gsub("s$", "")
end
function Q.Matches(profile,data)
    local wanted=tostring(data.progress or ""):match("%d+%s*/%s*%d+%s*(.+)")
    for _,name in ipairs(profile.enemies)do
        if wanted and enemyKey(wanted)==enemyKey(name)then return true end
        if not wanted and normalize(data.title):find(normalize(name),1,true)then return true end
    end
    return false
end
function Q.FindGiver(profile)
    local player=game:GetService("Players").LocalPlayer
    local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local npcs=workspace:FindFirstChild("NPCs")
    if not root then return nil end
    for _,model in ipairs(npcs and npcs:GetChildren()or {})do
        if model:IsA("Model")then
            local hum=model:FindFirstChildOfClass("Humanoid")
            if normalize(model.Name)==normalize(profile.giver)or(hum and normalize(hum.DisplayName)==normalize(profile.giver))then
                local part=model:FindFirstChild("HumanoidRootPart")or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart",true)
                if part and(part.Position-root.Position).Magnitude<1500 then return model end
            end
        end
    end
end
function Q.ProfileTarget(profile)
    local npcs=workspace:FindFirstChild("NPCs")
    for _,model in ipairs(npcs and npcs:GetChildren()or {})do
        if model:IsA("Model")and model:FindFirstChildOfClass("Humanoid")then
            for _,name in ipairs(profile.enemies)do if enemyKey(model.Name)==enemyKey(name)then return model.Name end end
        end
    end
    return profile.enemies[1]
end
function Q.SelectProfile(level)
    if Q.Mode==Q.CustomMode then
        if Q.CustomGiver==""or Q.TargetOverride==""then return nil,"Custom quest requires both a giver name and an enemy name"end
        return {label="Custom - "..Q.CustomGiver,giver=Q.CustomGiver,enemies={Q.TargetOverride},minLevel=0,placeId=game.PlaceId}
    end
    if Q.Mode~=Q.AutoMode then return Q.Profiles[Q.Mode]end
    local current=Q.ReadQuest()
    local best
    for _,profile in ipairs(Q.ProfileList)do
        if not profile.boss and level>=profile.minLevel and game.PlaceId==profile.placeId and Q.FindGiver(profile)then
            if current and Q.Matches(profile,current)then return profile end
            if not best or profile.minLevel>best.minLevel then best=profile end
        end
    end
    return best,"No eligible quest giver is loaded nearby. Travel to the island manually, or choose a quest explicitly"
end
local function questState()
    local data,reason=Q.ReadQuest()
    if not data then return reason=="no active quest"and"none"or"unknown"end
    if Q.Mode==Q.Modes[2]or(Q.ActiveProfile and Q.Matches(Q.ActiveProfile,data))then return "active",data.progress end
    return "other",data.progress
end
-- Select by visible meaning and button hierarchy, never left/middle/right position.
local function choiceText(item)
    local text=""
    pcall(function()text=item.ContentText or item.Text or ""end)
    if text==""then pcall(function()text=item.Text or ""end)end
    if text==""then
        for _,child in ipairs(item:GetDescendants())do
            if child:IsA("TextLabel")and visible(child,item)then
                pcall(function()text=child.ContentText or child.Text or ""end)
                if text~=""then break end
            end
        end
    end
    return tostring(text)
end
function Q.FindChoice(gui)
    local chat=gui:FindFirstChild("NPCCHAT")
    if not chat or not visible(chat,gui)then chat=gui:FindFirstChild("Dialogue")end
    if not chat or not visible(chat,gui)then return nil end
    local best,bestText,bestScore=nil,nil,-1
    local purchase=false
    local positives={howcanihelp=100,alright=100,accept=100,acceptquest=100,yes=90,sure=90,okay=90,ok=90,
        continue=80,next=80,understood=80,letsdoit=90}
    for _,item in ipairs(chat:GetDescendants())do
        if (item:IsA("GuiButton")or item:IsA("TextLabel"))and visible(item,gui)then
            local text=choiceText(item)
            local key=normalize(text)
            local label=text:match("^%s*(.-)%s*$")
            local dots=label=="..."or label=="…"
            local button=item:IsA("GuiButton")and item or item:FindFirstAncestorWhichIsA("GuiButton")
            local score=positives[key]or(dots and 70)or 0
            local denied=key=="bye"or key=="no"or key=="leave"or key=="close"or key=="cancel"
                or key:find("sorry",1,true)or key:find("notready",1,true)or key:find("decline",1,true)
            local buying=key:find("robux",1,true)or key:find("purchase",1,true)or key:find("pay",1,true)or key:find("buy",1,true)
            if buying then purchase=true end
            -- Some old layouts expose the positive choice as an input-frame label.
            if not button and score>0 and not dots then button=item end
            if button and not denied and not buying and visible(button,gui)then
                if normalize(button.Name)=="go"then score=math.max(score,60)end
                if score>0 and button.AbsoluteSize.X>0 and button.AbsoluteSize.Y>0 then
                    if normalize(button.Name)=="go"then score+=1 end
                    if score>bestScore then best,bestText,bestScore=button,text,score end
                end
            end
        end
    end
    if best then return best,bestText end
    if purchase then return nil,nil,"The dialogue is offering a purchase rather than a recognized quest choice"end
end
function Q.ClickChoice(button, label)
    if button ~= lastChoiceButton or label ~= lastChoiceText then
        lastChoiceButton, lastChoiceText, choiceAttempts = button, label, 0
    end
    choiceAttempts += 1
    -- Prefer the existing handler for one click event. Never fire multiple
    -- event types for the same choice, which could double-advance dialogue.
    if choiceAttempts == 1 and type(getconnections) == "function" and button:IsA("GuiButton") then
        for _, eventName in ipairs({"MouseButton1Click", "Activated"}) do
            local got, connections = pcall(function() return getconnections(button[eventName]) end)
            if got and type(connections) == "table" then
                local fired = false
                for _, connection in ipairs(connections) do
                    local ok, dispatched = pcall(function()
                        if connection.Enabled == false or type(connection.Fire) ~= "function" then return false end
                        connection:Fire()
                        return true
                    end)
                    fired = fired or (ok and dispatched)
                end
                if fired then return "button handler" end
            end
        end
    end
    -- Fallback: target the rendered choice, correcting for the GUI inset.
    local pos = button.AbsolutePosition + button.AbsoluteSize / 2
    local screen = button
    while screen and not screen:IsA("ScreenGui") do screen = screen.Parent end
    if screen and not screen.IgnoreGuiInset then
        local ok, inset = pcall(function() return game:GetService("GuiService"):GetGuiInset() end)
        if ok and inset then pos = pos + inset end
    end
    local input = game:GetService("VirtualInputManager")
    pcall(function() input:SendMouseMoveEvent(pos.X, pos.Y, game) end)
    input:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 0)
    task.wait(0.05)
    input:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
    return "screen click"
end
function Q.Step()
    if not Q.Enabled then return end
    if (Q.ActiveProfile and game.PlaceId ~= Q.ActiveProfile.placeId)
        or (Q.Mode == Q.Modes[2] and game.PlaceId ~= 3978370137 and game.PlaceId ~= 7465136166) then
        Q.Fail("The selected mode is not supported in this place"); return
    end
    if g.autofarm or g.TweenToPlayer or g.haki or g.AutoFishing or g.AutoMerchant or g.StartTweenIsland then
        Q.Fail("Turn off other automatic travel/farm modes; keep your Desert Bandit Tween To NPC setting"); return
    end
    local player = game:GetService("Players").LocalPlayer
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local gui = player:FindFirstChild("PlayerGui")
    if not root or not hum or hum.Health <= 0 or not gui then release(); Q.Status = "waiting to respawn"; return end
    if Q.Mode==Q.AutoMode and not Q.ReadQuest()then
        local ok,level=pcall(g.Level)
        local nextProfile=ok and tonumber(level)and Q.SelectProfile(tonumber(level))
        if nextProfile and nextProfile~=Q.ActiveProfile then
            release()
            if type(g.StopCurrentTween)=="function"then pcall(g.StopCurrentTween)end
            Q.ActiveProfile=nextProfile;g.SelectedNPC=Q.ProfileTarget(nextProfile)
        end
    end
    local state, progress = questState()
    if state == "active" then
        if Q.Mode == Q.Modes[2] then
            local target = Q.ResolveTarget(progress)
            if not target then Q.Fail("Quest enemy not found nearby; enter the exact name in Quest enemy (optional)"); return end
            if g.SelectedNPC ~= target then
                if type(g.StopCurrentTween) == "function" then pcall(g.StopCurrentTween) end
                g.SelectedNPC = target
            end
        end
        release()
        Q.Status = g.SelectedNPC .. " - " .. tostring(progress or "")
        return
    end
    if state == "other" then Q.Fail("Another quest is active; finish or quit it first"); return end
    if state == "unknown" then Q.Fail("Quest panel was not found; send the Auto Quest console message"); return end
    if Q.Mode == Q.Modes[2] then
        if not g.AutoQuestBusy then
            g.AutoQuestBusy = true
            if type(g.StopCurrentTween) == "function" then pcall(g.StopCurrentTween) end
        end
        Q.Status = "Quest finished - accept another quest manually to continue"
        return
    end
    local profile=Q.ActiveProfile
    if not profile then Q.Fail("Choose a quest profile first");return end
    local noah = Q.FindGiver(profile)
    local part = noah and (noah:FindFirstChild("HumanoidRootPart") or noah.PrimaryPart or noah:FindFirstChildWhichIsA("BasePart", true))
    if not part then Q.Fail(profile.giver .. " is not loaded nearby. Travel to the island and stand near the quest giver"); return end
    if not g.AutoQuestBusy then
        g.AutoQuestBusy = true
        if type(g.StopCurrentTween) == "function" then pcall(g.StopCurrentTween) end
        Q.Status = "pausing NPC movement to collect the quest"
        return -- Give the existing NPC loop one tick to release its movement.
    end
    local prompt = noah:FindFirstChildWhichIsA("ProximityPrompt", true)
    local interactionRange = math.max(1.5, math.min(6, (prompt and prompt.MaxActivationDistance or 8) - 0.75))
    local verticalGap = math.abs(root.Position.Y - part.Position.Y)
    if (part.Position - root.Position).Magnitude > interactionRange or verticalGap > 1.5 then
        Q.Status = "returning to " .. profile.giver
        travelStarted = travelStarted or tick()
        if tick() - travelStarted > 120 then Q.Fail("Could not reach " .. profile.giver .. " within 120 seconds"); return end
        local state = g.__TensenTweenState
        if not state or not state.Enabled then
            local move = g.TweenToMob2 or (g.__F2Tween and g.__F2Tween.TweenToMob2)
            if type(move) ~= "function" then Q.Fail("The NPC movement helper is not ready"); return end
            travelRequested = true
            -- Quest interaction uses Noah's facing, not a world-space combat offset.
            local look = part.CFrame.LookVector
            local flat = Vector3.new(look.X, 0, look.Z)
            local forward = flat.Magnitude > 0.001 and flat.Unit or Vector3.new(0, 0, 1)
            local standDistance = math.min(3, interactionRange - 0.25)
            move({MobName = noah.Name, Container = noah.Parent,
                Offset = forward * standDistance, BehindDistance = 0,
                -- No BossKey: NPC hover/shuffle settings must not affect a quest giver.
                Raycast = false, TeleportOnClose = false, StopDistance = 0.5,
                Speed = math.clamp(tonumber(g.TweenSpeedMaster) or 20, 8, 24),
                WalkOnWater = false, MaxTime = 15})
        end
        return
    end
    stopOwnTravel()
    started = started or tick()
    Q.Status = "accepting " .. profile.label
    if tick() - started > 25 then Q.Fail("Quest was not confirmed; accept it manually and send the last Auto Farm status"); return end
    if tick() - lastInput < 1.5 then return end
    lastInput = tick()
    local button,label,choiceError=Q.FindChoice(gui)
    if choiceError then Q.Fail(choiceError);return end
    if button then
        local method = Q.ClickChoice(button, label)
        Q.Status = profile.giver .. " - selected " .. label .. " (" .. method .. ")"
    else
        local chat = gui:FindFirstChild("NPCCHAT")
        if chat and visible(chat, gui) then
            Q.Status = profile.giver .. " - waiting for dialogue choices"
            return -- Do not restart an open conversation while its text is appearing.
        end
        local input = game:GetService("VirtualInputManager")
        local prompt = noah:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt and prompt.Enabled and type(fireproximityprompt) == "function" then fireproximityprompt(prompt)
        else
            local key = prompt and prompt.KeyboardKeyCode or Enum.KeyCode.T
            input:SendKeyEvent(true, key, false, game)
            task.wait(math.max(prompt and prompt.HoldDuration or 0, 0.1))
            input:SendKeyEvent(false, key, false, game)
        end
    end
end
return Q

end)()

-- ============================================================================
-- 2. Startup
-- ============================================================================

repeat
	task.wait()
until game:IsLoaded()

-- reads the executor name, nothing uses it
if getexecutorname then
	getexecutorname()
end

-- ============================================================================
-- 3. Big Mom module
-- ============================================================================

do
	local function noop() end
	guardNoop = noop
	hubLog = noop -- logging is off

	-- sets up every Big Mom helper on getgenv() and starts its loops; StartBigMom runs it in a pcall
	local function initBigMom()
		local bigMomLog
		local ReplicatedStorage, RunService, VirtualInputManager, Workspace, getCharacter, stopAttach, stopTween

		do
			bigMomLog = noop

			if not getgenv().TensenHubBigMom then
				getgenv().EnableBigMom = true
				getgenv().WeaponType = "Sword"
				getgenv().HitWait = 0.4
				getgenv().Buso = true
				getgenv().TweenSpeed = 60
				getgenv().AutoStoreFruit = true
				getgenv().BigMomPlaceId = 0
			end

			getCharacter = nil
			stopTween = nil
			stopAttach = nil
			getgenv().IgnoredNPC = true

			repeat
				wait(1)
			until game:IsLoaded()

			ReplicatedStorage = game:GetService("ReplicatedStorage")
			local crabStrangler = ReplicatedStorage:FindFirstChild("Crab_Strangler")

			if crabStrangler then
				crabStrangler:Destroy()
			end

			Workspace = game:GetService("Workspace")
			RunService = game:GetService("RunService")
			VirtualInputManager = cloneref(Instance.new("VirtualInputManager"))
		end

		-- --------------------------------------------------------------------
		-- 3.1 Big Mom / player, character and run generation
		-- --------------------------------------------------------------------

		local Players = game:GetService("Players")
		local localPlayer = Players.LocalPlayer
		localPlayer:WaitForChild("PlayerGui")
		localPlayer:WaitForChild("Backpack")
		local existingCharacter = localPlayer.Character
		local startCharacter

		if existingCharacter then
			startCharacter = existingCharacter
		else
			local newCharacter = localPlayer.CharacterAdded:Wait()
			startCharacter = newCharacter
		end

		local startRoot = startCharacter:WaitForChild("HumanoidRootPart")
		local humanoid = startCharacter:WaitForChild("Humanoid")
		local npcFolder = Workspace:WaitForChild("NPCs")
		getgenv().BigMomDebug = false
		local function bmLog() end
		getgenv().BigMomPrint = bigMomLog
		local noopLog = bmLog
		getgenv().BM_Gen = (getgenv().BM_Gen or 0) + 1
		local bmGen = getgenv().BM_Gen

		local function bmStale()
			return getgenv().BM_Gen ~= bmGen
		end

		getgenv().bmStale = bmStale

		if getgenv().releaseFirebreathMovement then
			getgenv().releaseFirebreathMovement()
		end

		-- --------------------------------------------------------------------
		-- 3.2 Big Mom / firebreath hold, executor, ground memory
		-- --------------------------------------------------------------------

		do
			local heldRoot = nil
			local heldRootWasAnchored = nil

			-- lets go of the root the firebreath hold anchored and restores its Anchored state
			getgenv().releaseFirebreathMovement = function()
				if heldRoot and heldRoot.Parent then
					heldRoot.AssemblyLinearVelocity = Vector3.zero
					heldRoot.AssemblyAngularVelocity = Vector3.zero
					heldRoot.Anchored = heldRootWasAnchored
				end

				heldRoot = nil
				heldRootWasAnchored = nil
			end

			local releaseFirebreathMovement = getgenv().releaseFirebreathMovement

			-- while a block is pinned (BreathBlocking/ReactBlockPin), anchors the root in place; false when
			-- not holding
			getgenv().firebreathMovementHeld = function()
				local character = localPlayer.Character
				local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
				local holdingBlock = getgenv().BreathBlocking == true or getgenv().ReactBlockPin == true

				if
					not getgenv().EnableBigMom
					or getgenv().ReplayRunning
					or not holdingBlock
					or not humanoidRootPart
				then
					releaseFirebreathMovement()
					return false
				end

				if heldRoot ~= humanoidRootPart then
					releaseFirebreathMovement()
					local anchored = humanoidRootPart.Anchored
					heldRoot = humanoidRootPart
					heldRootWasAnchored = anchored
				end

				humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
				humanoidRootPart.AssemblyAngularVelocity = Vector3.zero
				humanoidRootPart.Anchored = true
				return true
			end

			local connection = nil

			connection = RunService.Stepped:Connect(function()
				if bmStale() then
					connection:Disconnect()
					releaseFirebreathMovement()
					return
				end

				getgenv().firebreathMovementHeld()
			end)
		end

		getgenv().ExecutorName = getexecutorname and getexecutorname() or "Unknown Executor"
		getgenv().MobileExecutors = getgenv().MobileExecutors or { "Delta", "Arceus" }

		-- true (with the name) when the executor is a mobile one
		getgenv().isMobileExecutor = function()
			local executorName = string.lower(tostring(getgenv().ExecutorName or ""))

			if executorName == "" then
				return false
			end

			local mobileExecutors = getgenv().MobileExecutors or {}

			for _, mobileExecutor in ipairs(mobileExecutors) do
				if mobileExecutor ~= "" and string.find(executorName, string.lower(mobileExecutor), 1, true) then
					return true, mobileExecutor
				end
			end

			return false
		end

		getgenv().NormalizeMemoMax = getgenv().NormalizeMemoMax or 4096

		do
			local memo = {}
			local memoSize = 0

			local function clearNormalizeMemo()
				memo = {}
				memoSize = 0
			end

			getgenv().ClearNormalizeMemo = clearNormalizeMemo

			-- lowercased move name with everything but letters and digits stripped (memoised)
			getgenv().normalizeMoveName = function(moveName)
				local key = tostring(moveName or "")
				local cached = memo[key]

				if cached ~= nil then
					return cached
				end

				local normalized = string.gsub(string.lower(key), "[^a-z0-9]", "")

				if (getgenv().NormalizeMemoMax or 4096) <= memoSize then
					local resetSize = 0
					memo = {}
					memoSize = resetSize
				end

				memo[key] = normalized
				memoSize += 1
				return normalized
			end
		end

		-- destroys the body movers / forces on an instance so nothing keeps pushing it
		getgenv().ClearMovementForces = function(instance)
			if not instance or not instance.Parent then
				return
			end

			local scriptMoverNames = getgenv().ScriptMoverNames or {}

			for _, child in ipairs(instance:GetChildren()) do
				if
					(
						child:IsA("BodyVelocity")
						or child:IsA("BodyGyro")
						or child:IsA("BodyThrust")
						or child:IsA("BodyForce")
						or child:IsA("LinearVelocity")
						or child:IsA("AngularVelocity")
					) and (scriptMoverNames[child.Name] or child.Name == child.ClassName)
				then
					pcall(function()
						child:Destroy()
					end)
				end
			end
		end

		getgenv().GroundYWatch = getgenv().GroundYWatch ~= false
		getgenv().GroundYRate = getgenv().GroundYRate or 0.1
		getgenv().GroundYMaxAge = getgenv().GroundYMaxAge or 30
		getgenv().GroundYTrust = getgenv().GroundYTrust or 25
		getgenv().GroundYLog = getgenv().GroundYLog ~= false
		getgenv().GroundYStood = nil
		getgenv().GroundYStoodAt = 0
		getgenv().GroundY = nil
		getgenv().GroundYAt = 0

		-- true when dodges should use the remembered floor height (forced, or on mobile executors)
		getgenv().useGroundMemory = function()
			if getgenv().GroundYForce == true then
				return true
			end

			if getgenv().GroundYForce == false then
				return false
			end

			return getgenv().isMobileExecutor() == true
		end

		-- true while a dodge, an evade or a reaction owns the character's height
		getgenv().altitudeIsOwned = function()
			return (
				getgenv().EvadingBoss
				or getgenv().EvadingKing
				or getgenv().EvadingUlt
				or getgenv().EvadingDive
				or getgenv().EvadingAfterImage
				or getgenv().LowHealthActive
				or getgenv().LowHealthAnchored
				or getgenv().PerchedOnBarrier
				or getgenv().PerchEngaging
				or getgenv().BarrierFlightActive
				or getgenv().ReplayRunning
			) == true
		end

		-- the floor height remembered recently (stood on, or before a dodge) and where it came from
		getgenv().rememberedGroundY = function()
			local now = tick()
			local groundYMaxAge = getgenv().GroundYMaxAge or 30

			if getgenv().GroundYStood and now - (getgenv().GroundYStoodAt or 0) <= groundYMaxAge then
				return getgenv().GroundYStood, "the floor it last stood on"
			end

			if getgenv().GroundY and now - (getgenv().GroundYAt or 0) <= groundYMaxAge then
				return getgenv().GroundY, "the altitude it was at before the dodge"
			end

			return nil
		end

		getgenv().MobileGroundY = getgenv().MobileGroundY or 233.6

		-- --------------------------------------------------------------------
		-- 3.3 Big Mom / stage names and finding the boss
		-- --------------------------------------------------------------------

		local getText

		do
			getgenv().MobileGroundLift = getgenv().MobileGroundLift or 10
			getgenv().MobileGroundLog = getgenv().MobileGroundLog ~= false
			getgenv().MobileGroundByStage = getgenv().MobileGroundByStage
				or { ["DRAGON EMPEROR"] = 163.496, KING = 237.196 }
			local trustedGroundYs = { ["DRAGON EMPEROR"] = { [163] = true }, KING = {} }
			local groundYByStage = { ["DRAGON EMPEROR"] = 163.496, KING = 237.196 }

			for k, trusted in pairs(trustedGroundYs) do
				local current = getgenv().MobileGroundByStage[k]

				if current == nil or trusted[current] then
					getgenv().MobileGroundByStage[k] = groundYByStage[k]
				end
			end

			-- the known floor height of the current stage (+ MobileGroundLift), the floor itself, and the
			-- stage
			getgenv().mobileGroundY = function()
				local mobileGroundY = getgenv().MobileGroundY
				local mobileGroundByStage = getgenv().MobileGroundByStage or {}
				local cleanStageName = getgenv().cleanStageName and getgenv().cleanStageName() or nil

				if cleanStageName and mobileGroundByStage[cleanStageName] ~= nil then
					mobileGroundY = mobileGroundByStage[cleanStageName]
				end

				if type(mobileGroundY) ~= "number" then
					return nil
				end

				return mobileGroundY + (getgenv().MobileGroundLift or 10), mobileGroundY, cleanStageName
			end

			-- picks the floor Y to dodge onto: the remembered floor or the known stage floor when the ray
			-- looks wrong
			getgenv().dodgeGroundY = function(rayY, label)
				if not getgenv().useGroundMemory() then
					return rayY
				end

				local memY, memSource = getgenv().rememberedGroundY()

				if memY == nil then
					local mobileY, floorY, stage = getgenv().mobileGroundY()

					if mobileY == nil then
						return rayY
					end

					if rayY ~= nil and math.abs(rayY - floorY) <= (getgenv().GroundYTrust or 25) then
						return rayY
					end

					local bmLog = getgenv().MobileGroundLog ~= false and getgenv().BMLog

					if bmLog then
						local now = tick()
						bmLog = now - (getgenv().LastMobileGroundLog or 0) >= 2
					end

					if bmLog then
						getgenv().LastMobileGroundLog = tick()
						local log = getgenv().BMLog
						label = label or "Dodge"
						local labelText = tostring(label)
						local rayText = rayY == nil and "nothing at all" or string.format("Y %d", math.floor(rayY))
						local stageText = tostring(stage or "?")
						local floorYInt = math.floor(floorY)
						log(
							string.format(
								"[Ground] %s: no remembered floor and the ray says %s - using the known '%s' floor Y %d + %d = Y %d (%s).",
								labelText,
								rayText,
								stageText,
								floorYInt,
								math.floor(getgenv().MobileGroundLift or 10),
								math.floor(mobileY),
								tostring(getgenv().ExecutorName)
							)
						)
					end

					return mobileY
				end

				local nearMemory = rayY ~= nil and math.abs(rayY - memY) <= (getgenv().GroundYTrust or 25)

				if nearMemory then
					return rayY
				end

				local bmLog = getgenv().GroundYLog ~= false and getgenv().BMLog

				if bmLog then
					local elapsed = tick() - (getgenv().LastGroundYLog or 0)
					bmLog = elapsed >= 2
				end

				if bmLog then
					getgenv().LastGroundYLog = tick()
					local log = getgenv().BMLog
					local labelStr = tostring(label or "Dodge")
					local rayText = (rayY == nil and "nothing at all") or string.format("Y %d", math.floor(rayY))

					local memYInt = math.floor(memY)
					local memText = tostring(memSource)
					log(
						string.format(
							"[Ground] %s: the floor ray says %s, which is not where we were - coming back to Y %d instead (%s, %s).",
							labelStr,
							rayText,
							memYInt,
							memText,
							tostring(getgenv().ExecutorName)
						)
					)
				end

				return memY
			end

			task.spawn(function()
				while task.wait(getgenv().GroundYRate or 0.1) do
					if bmStale() then
						break
					end

					if
						not (
							getgenv().GroundYWatch ~= false
							and getgenv().EnableBigMom
							and not getgenv().altitudeIsOwned()
						)
					then
						continue
					end

					local character = localPlayer.Character
					local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
					local humanoid = character and character:FindFirstChildOfClass("Humanoid")

					if
						not (
							humanoidRootPart
							and humanoid
							and not (humanoid.Health <= 0)
							and not (getgenv().isCharacterDowned and getgenv().isCharacterDowned(character))
						)
					then
						continue
					end

					local y = humanoidRootPart.Position.Y
					local now = tick()
					getgenv().GroundY = y
					getgenv().GroundYAt = now
					local floorMaterial = nil

					pcall(function()
						floorMaterial = humanoid.FloorMaterial
					end)

					if floorMaterial and floorMaterial ~= Enum.Material.Air then
						local stoodAt = tick()
						getgenv().GroundYStood = y
						getgenv().GroundYStoodAt = stoodAt
					end
				end
			end)

			getgenv().LandTimeout = getgenv().LandTimeout or 3
			getgenv().LandRate = getgenv().LandRate or 0.05
			getgenv().LandDrop = getgenv().LandDrop or 3

			-- stops all movement and drops the character onto the ground below; returns whether it landed
			getgenv().LandOnGround = function(reason)
				local character = localPlayer.Character
				local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
				local hum = character and character:FindFirstChildOfClass("Humanoid")

				if not humanoidRootPart or not hum then
					return false
				end

				pcall(stopTween)

				if stopAttach then
					pcall(stopAttach)
				end

				if getgenv().ClearMovementForces then
					getgenv().ClearMovementForces(humanoidRootPart)
				end

				pcall(function()
					hum.PlatformStand = false
					hum.AutoRotate = true
					local canMove = not getgenv().firebreathMovementHeld()

					if canMove then
						humanoidRootPart.Anchored = false
					end
				end)
				local nonBarrierGroundY = nil

				if getgenv().FindNonBarrierGroundY then
					nonBarrierGroundY = getgenv().FindNonBarrierGroundY(humanoidRootPart.Position)
				end

				local groundY = getgenv().dodgeGroundY(nonBarrierGroundY, "Land")

				if groundY then
					pcall(function()
						if not getgenv().firebreathMovementHeld() then
							humanoidRootPart.CFrame = CFrame.new(
								humanoidRootPart.Position.X,
								groundY + (getgenv().LandDrop or 3),
								humanoidRootPart.Position.Z
							) * humanoidRootPart.CFrame.Rotation
						end

						humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
						humanoidRootPart.AssemblyAngularVelocity = Vector3.zero
					end)
				end

				local now = tick()
				local touched = false

				while tick() - now < (getgenv().LandTimeout or 3) do
					task.wait(getgenv().LandRate or 0.05)
					local character = localPlayer.Character
					humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
					hum = character and character:FindFirstChildOfClass("Humanoid")

					if not humanoidRootPart or not hum then
						return false
					end

					if hum.PlatformStand then
						hum.PlatformStand = false
					end

					if not getgenv().firebreathMovementHeld() and humanoidRootPart.Anchored then
						humanoidRootPart.Anchored = false
					end

					if getgenv().ClearMovementForces then
						getgenv().ClearMovementForces(humanoidRootPart)
					end

					local floorMaterial = nil

					pcall(function()
						floorMaterial = hum.FloorMaterial
					end)

					if floorMaterial and floorMaterial ~= Enum.Material.Air then
						touched = true
						break
					end
				end

				if getgenv().BMLog then
					if touched then
						local bmLog = getgenv().BMLog
						local y = math.floor(humanoidRootPart.Position.Y)
						local elapsed = tick() - now
						reason = reason or "landing"
						bmLog(
							string.format(
								"[Ground] Touching the floor at Y %d after %.2fs (%s) - safe to use a tool now.",
								y,
								elapsed,
								tostring(reason)
							)
						)
					else
						getgenv().BMLog(
							string.format(
								"[Ground] Still not touching the floor after %.1fs (Y %d, %s) - carrying on anyway.",
								getgenv().LandTimeout or 3,
								math.floor(humanoidRootPart.Position.Y),
								tostring(reason or "landing")
							)
						)
					end
				end

				return touched
			end

			local function getStageName()
				local playerGui = game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui")
				local objectivesGui = playerGui
					and playerGui:FindFirstChild(getgenv().ObjectivesGui or "KaidoObjectives")
				local mainFrame = objectivesGui and objectivesGui:FindFirstChild("Main")
				return mainFrame and mainFrame:FindFirstChild("StageName")
			end

			task.spawn(function()
				while wait(0.1) do
					if bmStale() then
						break
					end

					local playerScripts = localPlayer:FindFirstChild("PlayerScripts")
					local ragdolls = playerScripts and playerScripts:FindFirstChild("Ragdolls")
					local ragdollClient = ragdolls and ragdolls:FindFirstChild("Ragdoll_Client")

					if ragdollClient then
						ragdollClient:Destroy()
					end
				end
			end)

			task.spawn(function()
				local connection

				connection = game:GetService("RunService").Heartbeat:Connect(function()
					if bmStale() then
						if connection then
							connection:Disconnect()
							connection = nil
						end

						return
					end

					if not getgenv().EnableBigMom then
						return
					end

					local character = localPlayer.Character
					local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")

					if not humanoidRootPart then
						return
					end

					local isCharacterDowned = getgenv().isCharacterDowned

					if isCharacterDowned and isCharacterDowned(character) then
						pcall(function()
							humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
							humanoidRootPart.AssemblyAngularVelocity = Vector3.zero
						end)

						for _, child in ipairs(humanoidRootPart:GetChildren()) do
							if child:IsA("BodyVelocity") or child:IsA("BodyThrust") or child:IsA("BodyForce") then
								pcall(function()
									child.Velocity = Vector3.zero
								end)

								continue
							end

							if not child:IsA("LinearVelocity") then
								continue
							end
						end

						return
					end

					local maxVelocity = getgenv().MaxVelocity or math.max((getgenv().TweenSpeed or 60) * 2, 120)

					if humanoidRootPart.AssemblyLinearVelocity.Magnitude > maxVelocity then
						humanoidRootPart.AssemblyLinearVelocity = humanoidRootPart.AssemblyLinearVelocity.Unit
							* maxVelocity
					end

					local maxAngularVelocity = getgenv().MaxAngularVelocity or 40

					if maxAngularVelocity < humanoidRootPart.AssemblyAngularVelocity.Magnitude then
						humanoidRootPart.AssemblyAngularVelocity = humanoidRootPart.AssemblyAngularVelocity.Unit
							* maxAngularVelocity
					end
				end)
			end)

			getText = function()
				local stageName = getStageName()
				return stageName and stageName:IsA("TextLabel") and stageName.Text or nil
			end

