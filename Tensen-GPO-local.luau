		-- records an animation Big Mom played; mutes ambient ones and logs unlisted ones as candidates
		getgenv().spyBigMomAnim = function(track)
			if getgenv().AnimSpy == false then
				return false
			end

			local animation = track and track.Animation

			if not animation then
				return false
			end

			local digits = getgenv().animDigits(animation.AnimationId)

			if not digits then
				return false
			end

			local plays, damage = getgenv().animStats(digits)

			if (getgenv().AnimSpyAmbient or 150) <= plays then
				if not getgenv().AmbientAnims[digits] then
					getgenv().AmbientAnims[digits] = plays
					getgenv().AnimMuted[digits] = true

					if getgenv().BMLog then
						getgenv().BMLog(
							string.format(
								"[Spy] %s has played %d times - ambient, not a move. Muted and kept out of the damage credit.",
								digits,
								plays
							)
						)
					end
				end

				return false
			end

			local notMuted = not getgenv().AnimMuted[digits]
			local logArgs

			if notMuted then
				local enoughPlays = plays >= (getgenv().AnimSpyMinPlays or 4)
				logArgs = enoughPlays
			else
				logArgs = notMuted
			end

			if logArgs and damage <= 0 then
				getgenv().AnimMuted[digits] = true

				if getgenv().BMLog then
					getgenv().BMLog(
						string.format(
							"[Spy] muting %s %s - %d plays and it has never hurt us.",
							digits,
							tostring(getgenv().AnimLabels[digits] or ""),
							plays
						)
					)
				end

				return false
			end

			if getgenv().AnimMuted[digits] then
				if not (damage > 0) or getgenv().AmbientAnims[digits] or (getgenv().AnimNeverAttack or {})[digits] then
					return false
				end

				getgenv().AnimMuted[digits] = nil
			end

			local now = tick()

			if now - (getgenv().AnimSaidAt[digits] or 0) < (getgenv().AnimSpyRepeat or 3) then
				return false
			end

			getgenv().AnimSaidAt[digits] = now
			local count = 0
			local logLength = getgenv().AnimSpyLen ~= false

			if logLength then
				pcall(function()
					count = tonumber(track.Length) or 0
				end)
			end

			local perHit = damage / math.max(plays, 1)
			local candidate = not getgenv().inReactList(digits)
				and perHit >= (getgenv().ReactCandidateDmg or 40)
				and plays >= 3
			local note = ""

			if candidate then
				note = "   <<< NOT IN ANY LIST - candidate"

				if not getgenv().ReactCandidates[digits] then
					getgenv().ReactCandidates[digits] = true

					if getgenv().BMLog then
						getgenv().BMLog(
							string.format(
								"[React] NEW CANDIDATE: %s %s does %.0f dmg/play over %d plays and nothing reacts to it.",
								digits,
								tostring(getgenv().AnimLabels[digits] or "unnamed"),
								perHit,
								plays
							)
						)
					end
				end
			end

			if getgenv().BMLog then
				local bmLog = getgenv().BMLog
				local label = tostring(getgenv().AnimLabels[digits] or "UNKNOWN")
				bmLog(
					string.format(
						"[Spy] %s  %s  |  %s  |  %.1fs%s",
						label,
						digits,
						damage > 0 and string.format("%.0f dmg/play over %d plays", perHit, plays)
							or string.format("no damage yet (%d plays)", plays),
						count,
						note
					)
				)
			end

			return true
		end

