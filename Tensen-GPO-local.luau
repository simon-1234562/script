		-- --------------------------------------------------------------------
		-- 3.28 Big Mom / dodging: spots, barriers, rise and return
		-- --------------------------------------------------------------------

		getgenv().reactAwaySpot = function(instance, side)
			local bigMom = getgenv().findBigMom and getgenv().findBigMom()
			local bigMomPosition = bigMom and getgenv().bigMomPosition and getgenv().bigMomPosition(bigMom) or nil

			if not ((instance and instance.Parent) and bigMomPosition) then
				return
			end

			local vector =
				Vector3.new(instance.Position.X - bigMomPosition.X, 0, instance.Position.Z - bigMomPosition.Z)
			local unit

			if vector.Magnitude > 3 then
				unit = vector.Unit
			else
				local lookVector = instance.CFrame.LookVector
				local flatLook = Vector3.new(lookVector.X, 0, lookVector.Z)
				local lookDir = flatLook.Magnitude > 0.01 and flatLook.Unit or Vector3.new(1, 0, 0)
				unit = Vector3.new(-lookDir.Z, 0, lookDir.X) * (side or 1)
			end

			local reactAwayDist = getgenv().ReactAwayDist or 180
			local _roomName, roomModel = getgenv().currentCakeStage()
			local cframe = nil
			local roomSize = nil

			if roomModel then
				cframe, roomSize = getgenv().roomBox(roomModel)
			end

			local reactAwayEdge = getgenv().ReactAwayEdge or 10
			local awaySpot = nil

			for _, shrink in ipairs({ 1, 0.75, 0.5, 0.35 }) do
				awaySpot = bigMomPosition + unit * reactAwayDist * shrink

				if cframe and roomSize then
					local localPos = cframe:PointToObjectSpace(Vector3.new(awaySpot.X, cframe.Position.Y, awaySpot.Z))

					if
						math.abs(localPos.X) > roomSize.X / 2 - reactAwayEdge
						or math.abs(localPos.Z) > roomSize.Z / 2 - reactAwayEdge
					then
						awaySpot = nil
						continue
					end
				end

				break
			end

			if not awaySpot then
				return nil
			end

			local findNonBarrierGroundY = getgenv().FindNonBarrierGroundY

			if findNonBarrierGroundY then
				local groundYFn = getgenv().FindNonBarrierGroundY
				findNonBarrierGroundY =
					groundYFn(Vector3.new(awaySpot.X, bigMomPosition.Y + 50, awaySpot.Z), { instance.Parent })
			end

			if getgenv().dodgeGroundY then
				findNonBarrierGroundY = getgenv().dodgeGroundY(findNonBarrierGroundY, "React away")
					or findNonBarrierGroundY
			end

			local awayY = (findNonBarrierGroundY or bigMomPosition.Y) + (getgenv().ReactAwayRise or 40)
			local spot = Vector3.new(
				awaySpot.X,
				getgenv().barrierSafeY(awaySpot.X, awayY, awaySpot.Z, "the sideways dodge") or awayY,
				awaySpot.Z
			)
			local flatSpot = Vector3.new(spot.X, 0, spot.Z)
			return spot, (flatSpot - Vector3.new(bigMomPosition.X, 0, bigMomPosition.Z)).Magnitude
		end

