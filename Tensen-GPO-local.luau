		-- true (with a reason) when the post-boss mirror is visible
		getgenv().mirrorVisible = function()
			local mirrors = getgenv().mirrorParts()

			if #mirrors == 0 then
				return false, "no mirror part is loaded", nil
			end

			local minTransparency = 2
			local visiblePart = nil

			for _, mirror in ipairs(mirrors) do
				local transparency = 1

				pcall(function()
					transparency = mirror.Transparency
				end)

				if transparency < minTransparency then
					visiblePart = mirror
					minTransparency = transparency
				end
			end

			if minTransparency >= (getgenv().MirrorVisibleTol or 0.95) then
				return false,
					string.format(
						"%d mirror part(s) loaded but the clearest is %.2f transparent",
						#mirrors,
						minTransparency
					),
					visiblePart
			end

			return true,
				string.format(
					"%s is %.2f transparent (%d loaded)",
					tostring(visiblePart and visiblePart.Name),
					minTransparency,
					#mirrors
				),
				visiblePart
