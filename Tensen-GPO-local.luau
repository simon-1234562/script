			-- the ocean folder from OceanPath / OceanFallbackPaths, or nil
			getgenv().findOceanFolder = function()
				local path = getgenv().resolvePath(Workspace, getgenv().OceanPath)

				if not path then
					local oceanFallbackPaths = getgenv().OceanFallbackPaths or {}

					for _, oceanFallbackPath in ipairs(oceanFallbackPaths) do
						path = getgenv().resolvePath(Workspace, oceanFallbackPath)

						if path then
							break
						end
					end
				end

				if not path then
					return nil
				end

				return path:FindFirstChild("OceanMeshes") or path
