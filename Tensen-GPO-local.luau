			-- devil fruit names read from the game's SkillCallbacks (cached for FruitNameRescan seconds)
			getgenv().listFruitNames = function(force)
				local fruitNameCache = getgenv().FruitNameCache
				local now = tick()
				local names = not force
					and fruitNameCache.names
					and now - (fruitNameCache.at or 0) < (getgenv().FruitNameRescan or 30)

				if names then
					return fruitNameCache.names
