				local nearestDist = math.huge
				local name = nil

				for _, char in ipairs(playerChars) do
					local magnitude = (origin - char.pos).Magnitude

					if magnitude < nearestDist then
						name = char.name
						nearestDist = magnitude
					end
				end

				local bossReach = nearestDist + (getgenv().BossEffectMargin or 12)

				if bossReach < math.min(magnitude, kingDist) then
					if getgenv().MoveFilterLog and getgenv().BMLog then
						local bmLog = getgenv().BMLog
						local effectName = tostring(instance.Name)
						local nearestDistFloor = math.floor(nearestDist)
						local ownerName = tostring(name)
						bmLog(
