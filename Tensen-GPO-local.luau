		-- goes to a prompt: teleports when within snapMax studs, otherwise walks there (never teleports far)
		getgenv().WalkOrSnapTo = function(cFrame, label, snapMax)
			if not cFrame then
				return false, math.huge
			end

			local promptSnapMax = snapMax or getgenv().PromptSnapMax or 5

			-- our root part (the one from the start, else the current character's)
			local function getRoot()
				local root = startRoot
				local rootParent = startRoot

				if root then
					rootParent = root.Parent
				end

				if rootParent then
					return root
				end

				local character = localPlayer.Character
				return character and character:FindFirstChild("HumanoidRootPart")
			end

			local function distToTarget()
				local root = getRoot()

				if root and root.Parent then
					return (root.Position - cFrame.Position).Magnitude
				end

				return math.huge
			end

			-- teleports straight onto the prompt when it is close enough; true when it did
			local function snapTo()
				local root = getRoot()

				if not root or not root.Parent then
					return false
				end

				pcall(function()
					if not getgenv().firebreathMovementHeld() then
						root.CFrame = cFrame
					end

					root.AssemblyLinearVelocity = Vector3.zero

					root.Velocity = Vector3.zero
				end)
				return true
			end

			local dist = distToTarget()

			if dist <= promptSnapMax then
				snapTo()
				return true, dist
			end

			if getgenv().PromptWalkLog ~= false and getgenv().BMLog then
				getgenv().BMLog(
					string.format(
						"[Prompt] %s is %d studs away (over the %d stud snap limit) - WALKING there instead of teleporting.",
						tostring(label or "the prompt"),
						math.floor(dist),
						math.floor(promptSnapMax)
