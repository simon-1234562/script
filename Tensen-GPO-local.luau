		-- the part for one step of the exit chain out of Katakuri's mirror
		getgenv().mochiExitPart = function(stage)
			local chain = (getgenv().MochiExitChain or {})[stage]

			if not chain then
				return nil
			end

			local path = getgenv().resolvePath(Workspace, chain.path)

			if path and path:IsA("BasePart") then
				getgenv().MochiExitCache[stage] = { part = path, at = tick(), how = "the exact path" }
				return path, chain.why, "the exact path"
			end

			local cached = getgenv().MochiExitCache[stage]

			if
				cached
				and cached.part
				and cached.part.Parent
				and tick() - (cached.at or 0) <= (getgenv().BrickCacheHold or 10)
			then
				return cached.part, chain.why, tostring(cached.how) .. " (held)"
			end

			if cached and cached.miss and tick() - cached.miss < (getgenv().BrickScanGap or 3) then
				return nil, chain.why
			end

			local tpBrickBy = getgenv().findTPBrickBy(chain.hints)

			if not tpBrickBy then
				getgenv().MochiExitCache[stage] = { miss = tick() }
				return nil, chain.why
			end

			local how = "found by name under " .. table.concat(chain.hints or {}, " / ")
			getgenv().MochiExitCache[stage] = { part = tpBrickBy, at = tick(), how = how }
			return tpBrickBy, chain.why, how
		end

		-- one step of leaving the mirror after Katakuri dies and walking back to the start gate
		getgenv().mochiExitTick = function(_unused, root)
			local chainLen = #(getgenv().MochiExitChain or {})
			local mochiExitStage = getgenv().MochiExitStage or 1

			if chainLen < mochiExitStage then
				local gateCF, gateLabel = getgenv().bigMomStartAt()
				local magnitude = (gateCF and (root.Position - gateCF.Position).Magnitude) or math.huge

				if gateCF and magnitude > (getgenv().MochiGateReach or 25) then
					getgenv().BigMomStep = string.format(
						"out of the mirror - tweening back to %s to restart (%.0f studs)",
						tostring(gateLabel),
						magnitude
					)
					getgenv().BigMomBusy = true
					pcall(getgenv().goTo, gateCF, tostring(gateLabel), getgenv().MochiGateReach or 25)
					getgenv().BigMomBusy = false
					return false
				end

				local doorOpen, doorWhy = getgenv().chateauDoorOpen()
				getgenv().MochiGateSince = getgenv().MochiGateSince or tick()
				local elapsed = tick() - getgenv().MochiGateSince

				if (doorOpen ~= true) and elapsed <= (getgenv().MochiGateWait or 180) then
					getgenv().BigMomStep = string.format(
						"at the gate - waiting for it to reopen (%s, %.0fs of %.0f)",
						tostring(doorWhy),
						elapsed,
						getgenv().MochiGateWait or 180
					)
					local bmLog = getgenv().BMLog
					local shouldLog

					if bmLog then
						local now = tick()
						shouldLog = now - (getgenv().LastGateWaitLog or 0) >= 15
					else
						shouldLog = bmLog
					end

					if shouldLog then
						getgenv().LastGateWaitLog = tick()
						getgenv().BMLog(
							string.format(
								"[Restart] Back at %s after the %s kill, but the gate reads %s (%s) - holding here until it opens rather than restarting onto a door we cannot use.",
								tostring(gateLabel),
								tostring(getgenv().MochiName),
								doorOpen == nil and "UNREADABLE" or "SHUT",
								tostring(doorWhy)
							)
						)
					end

					return false
				end

				getgenv().MochiGateSince = nil
				local farmRestart = getgenv().farmRestart
				local mochiName = tostring(getgenv().MochiName)
				local gateText = tostring(gateLabel)
				local doorText = doorOpen == true and "OPEN"
					or string.format("still not open after %.0fs - restarting anyway", elapsed)

				farmRestart(
					string.format("%s is dead, we are back at %s and the gate is %s", mochiName, gateText, doorText)
				)
				return true
			end

			local mochiExitSeatPos = getgenv().MochiExitSeatPos
				and (root.Position - getgenv().MochiExitSeatPos).Magnitude > (getgenv().AfterBossJump or 250)

			if mochiExitSeatPos then
				getgenv().MochiExitStage = mochiExitStage + 1
				getgenv().MochiExitSince = nil
				getgenv().MochiExitSeatPos = nil
				getgenv().MochiExitCache = {}
				pcall(getgenv().clearPortalKnock)

				if getgenv().BMLog then
					getgenv().BMLog(
						string.format(
							"[MochiExit] step %d teleported us - on to step %d of %d.",
							mochiExitStage,
							getgenv().MochiExitStage,
							chainLen + 1
						)
					)
				end

				return false
			end

			local exitPart, exitLabel, exitWhy = getgenv().mochiExitPart(mochiExitStage)

			if not exitPart then
				getgenv().MochiExitSince = getgenv().MochiExitSince or tick()
				local elapsed = tick() - getgenv().MochiExitSince

				if (getgenv().MochiExitWait or 60) < elapsed then
					if getgenv().BMLog then
						getgenv().BMLog(
							string.format(
								"[MochiExit] %s never loaded in %.0fs - giving up on the mirror exit and letting the run find its own way back.",
								tostring(exitLabel),
								elapsed
							)
						)
					end

					getgenv().farmRestart("the mirror exit bricks never loaded")
					return true
				end

				local bigMomStep = string.format("%s is not loaded yet (%.0fs)", tostring(exitLabel), elapsed)
				getgenv().BigMomStep = bigMomStep
				return false
			end

			local exitSpot = getgenv().standAtPart(exitPart)

			if not exitSpot then
				return false
			end

			if
				getgenv().MochiExitSeatPos
				and (root.Position - getgenv().MochiExitSeatPos).Magnitude > (getgenv().AfterBossJump or 250)
			then
				getgenv().MochiExitStage = mochiExitStage + 1
				getgenv().MochiExitSince = nil
				getgenv().MochiExitSeatPos = nil
				getgenv().MochiExitCache = {}
				pcall(getgenv().clearPortalKnock)

				if getgenv().BMLog then
					getgenv().BMLog(
						string.format(
							"[MochiExit] %s teleported us - on to step %d of %d.",
							tostring(exitLabel),
							getgenv().MochiExitStage,
							chainLen + 1
						)
					)
				end

				return false
			end

			local magnitude = (root.Position - exitSpot.Position).Magnitude

			if getgenv().insidePart(exitPart, root.Position) then
				getgenv().MochiExitSeatPos = exitSpot.Position
				getgenv().BigMomStep = "standing on " .. tostring(exitLabel) .. ", waiting to be taken"
				getgenv().knockPortal(exitPart, exitSpot, tostring(exitLabel))
				return false
			end

			if magnitude > (getgenv().ExitSeatFrom or 22) then
				local approachCF = getgenv().exitApproachCF(exitPart, exitSpot, root.Position)
				local mochiName = tostring(getgenv().MochiName)
				local exitText = tostring(exitLabel)
				local bigMomStep = string.format(
					"%s is dead - heading for %s (%.0f studs, %s)",
					mochiName,
					exitText,
					magnitude,
					tostring(exitWhy)
				)
				getgenv().BigMomStep = bigMomStep
				pcall(getgenv().clearPortalKnock)
				getgenv().BigMomBusy = true
				local goTo = getgenv().goTo
				local floorLabel = "the floor in front of " .. tostring(exitLabel)

				if bigMomStep then
					pcall(goTo, approachCF, floorLabel, getgenv().AfterBossReach or 3)
					getgenv().BigMomBusy = false
					return false
				end
			else
				getgenv().MochiExitSeatPos = exitSpot.Position
				getgenv().BigMomStep =
					string.format("%.1f studs from %s - stepping onto it", magnitude, tostring(exitLabel))

				if not getgenv().knockPortal(exitPart, exitSpot, tostring(exitLabel)) then
					getgenv().stepTo(root, exitSpot.Position, tostring(exitLabel))
					return false
				end
			end

			return false
		end

		getgenv().MochiExitActive = false
		getgenv().MochiKilledAt = 0

		-- confirms Katakuri is dead (zero health) and starts the exit chain
		getgenv().confirmMochiDeath = function(mochiConfirmedNPC, reason)
			if bmStale() or not getgenv().EnableBigMom or getgenv().MochiExit == false then
				return false
			end

			if not (mochiConfirmedNPC and reason and reason.Health <= 0) then
				return false
			end

			if getgenv().MochiConfirmedNPC == mochiConfirmedNPC then
				return false
			end

			getgenv().MochiConfirmedNPC = mochiConfirmedNPC
			getgenv().MochiKilledAt = tick()
			getgenv().MochiKills = (getgenv().MochiKills or 0) + 1
			getgenv().MochiExitActive = true
			getgenv().MochiExitStage = 1
			getgenv().MochiExitSince = nil
			getgenv().MochiExitSeatPos = nil
			getgenv().MochiExitCache = {}

			if getgenv().BMLog then
				getgenv().BMLog("[MochiExit] Confirmed zero health - leaving the mirror and restarting the farm.")
			end

			return true
		end

		-- report on the mirror exit chain
		getgenv().MochiExitInfo = function()
			local exitState = getgenv().MochiExit == false and "OFF" or "on"
			local activeText = tostring(getgenv().MochiExitActive)
			local mochiExitStage = getgenv().MochiExitStage or 1
			local chainLen = #(getgenv().MochiExitChain or {})

			local lines = {
				string.format(
					"[MochiExit] %s | active=%s | step %d of %d+gate | kills %d | farm restarts %d",
					exitState,
					activeText,
					mochiExitStage,
					chainLen,
					getgenv().MochiKills or 0,
					getgenv().FarmRestarts or 0
				),
			}

			local mochiExitChain = getgenv().MochiExitChain or {}

			for k, step in ipairs(mochiExitChain) do
				local instance, _label, why = getgenv().mochiExitPart(k)
				lines[#lines + 1] = string.format(
					"   %d. %-44s %s%s",
					k,
					tostring(step.why),
					instance and "FOUND" or "missing",
					instance and "  (" .. tostring(why) .. ")  " .. instance:GetFullName() or ""
				)
			end

			local gateLabel
			gateLabel, gateLabel = getgenv().bigMomStartAt()
			local doorOpen, doorWhy = getgenv().chateauDoorOpen()
			lines[#lines + 1] = string.format("   then: tween to %s and restart", tostring(gateLabel))
			local row = #lines + 1
			local doorText = doorOpen == nil and "UNREADABLE" or doorOpen and "OPEN" or "SHUT"
			local doorWhyText = tostring(doorWhy)
			local plan = doorOpen == true and "would restart straight away"
				or string.format("would wait up to %.0fs for it to open", getgenv().MochiGateWait or 180)

			lines[row] = string.format("   gate right now: %s (%s) -> %s", doorText, doorWhyText, plan)
			local nextRow = #lines + 1
			lines[nextRow] = string.format(
				"   a shut gate means 'finished' only while %s is still alive - he died %s",
				tostring(getgenv().MochiName),
				(getgenv().MochiKilledAt or 0) > 0 and string.format("%.0fs ago", tick() - getgenv().MochiKilledAt)
					or "never this session"
			)
			local report = table.concat(lines, "\n")

			pcall(function()
				getgenv().BigMomPrint(report)
			end)
			return report
		end

		-- one tick of what happens after Big Mom is beaten: the portal, the mirror and Katakuri
		getgenv().afterBossTick = function(instance)
			if getgenv().AfterBoss == false then
				return true
			end

			local humanoidRootPart = instance and instance:FindFirstChild("HumanoidRootPart")

			if not humanoidRootPart then
				return true
			end

			local elapsed = tick() - (getgenv().AfterBossStoodDown or 0)

			if elapsed < (getgenv().AfterBossRetry or 120) then
				return true
			end

			if getgenv().MochiExitActive ~= true then
				local roomName, _room, how = getgenv().currentCakeStage()
				local num = how == "inside" and tonumber(roomName) or nil

				if num and num < 5 then
					if
						getgenv().BigMomBeaten
						or (getgenv().AfterBossStage or 1) ~= 1
						or (getgenv().CampCleared or {})["5"]
					then
						getgenv().BigMomBeaten = false
						getgenv().BigMomBeatenAt = 0
						getgenv().BigMomBeatenHow = nil
						getgenv().AfterBossStage = 1
						getgenv().AfterBossSince = nil
						getgenv().AfterBossSeatPos = nil

						if getgenv().CampCleared then
							getgenv().CampCleared["5"] = nil
						end

						pcall(getgenv().clearPortalKnock)

						if getgenv().BMLog then
							getgenv().BMLog(
								string.format(
									"[Beaten] In room %d - the run is still going, so the beaten flag was stale. Cleared it; carrying on with the dungeon.",
									num
								)
							)
						end
					end

					return true
				end
			end

			local mochi = getgenv().mochiEmperor()

			if mochi then
				getgenv().DeathOnAfterBoss = 0
			end

			local diedAfterBoss = (getgenv().DeathOnAfterBoss or 0) > 0

			if diedAfterBoss then
				local now = tick()
				diedAfterBoss = now - getgenv().DeathOnAfterBoss < (getgenv().MochiBackHold or 180)
			end

			local bigMom = getgenv().findBigMom and getgenv().findBigMom()

			if bigMom and not mochi and diedAfterBoss then
				local bmLog = getgenv().BMLog

				if bmLog then
					local now = tick()
					bmLog = now - (getgenv().LastHisRunLog or 0) >= 15
				end

				if bmLog then
					getgenv().LastHisRunLog = tick()
					local log = getgenv().BMLog
					log(
						string.format(
							"[AfterBoss] She is up and %s is not loaded, but we died on him %.0fs ago - he is streamed out, not gone. Staying on the after-boss chain instead of starting her again (up to %.0fs).",
							tostring(getgenv().MochiName),
							tick() - getgenv().DeathOnAfterBoss,
							getgenv().MochiBackHold or 180
						)
					)
				end
			elseif bigMom and not mochi then
				getgenv().MenuWaitSince = nil

				if (getgenv().AfterBossStage or 1) ~= 1 then
					getgenv().AfterBossStage = 1
					getgenv().AfterBossSince = nil
					getgenv().AfterBossSeatPos = nil
				end

				local bigMomBeaten = getgenv().BigMomBeaten and getgenv().wholeCakeLive() ~= true

				if bigMomBeaten then
					getgenv().BigMomBeaten = false
					getgenv().BigMomBeatenHow = nil

					if getgenv().BMLog then
						getgenv().BMLog(
							"[Beaten] She is alive again - clearing the beaten flag, this is a fresh fight."
						)
					end
				end

				if not getgenv().MochiExitActive then
					return true
				end

				getgenv().MochiExitActive = false
				getgenv().MochiExitStage = 1
				getgenv().MochiExitSince = nil
				getgenv().MochiExitSeatPos = nil
				return true
			end

			if getgenv().BigMomOnly == true and getgenv().bossFightDone() then
				getgenv().MenuWaitSince = getgenv().MenuWaitSince or tick()
				local now = tick()
				local menuWaitSince = getgenv().MenuWaitSince
				local teleportToMenu
				local waited = now - menuWaitSince
				local menuDelay = tonumber(getgenv().MenuTeleportDelay) or 5

				if waited < menuDelay then
					getgenv().BigMomStep = string.format("Big Mom is down - main menu in %.1fs", menuDelay - waited)
					return false
				end

				getgenv().BigMomStep = "Big Mom is done - teleporting to the main menu"

				if not (tick() - (getgenv().LastMenuTeleport or 0) >= (getgenv().MenuTeleportRetry or 15)) then
					return false
				end

				getgenv().LastMenuTeleport = tick()

				if not getgenv().BMLog then
					teleportToMenu = function()
						game:GetService("TeleportService")
							:Teleport(getgenv().MainMenuPlaceId or 1730877806, localPlayer)
					end

					pcall(teleportToMenu)
					return false
				end

				getgenv().BMLog(
					string.format(
						"[BigMomOnly] Big Mom is beaten (%s) - teleporting to the main menu (%d).",
						tostring(getgenv().BigMomBeatenHow),
						getgenv().MainMenuPlaceId or 1730877806
					)
				)

				teleportToMenu = function()
					game:GetService("TeleportService"):Teleport(getgenv().MainMenuPlaceId or 1730877806, localPlayer)
				end

				pcall(teleportToMenu)

				return false
			end

			local exitActive = getgenv().MochiExit ~= false and getgenv().MochiExitActive == true

			if exitActive then
				if not getgenv().mochiEmperor() then
					if getgenv().reactionOwnsUs() then
						return false
					end

					return getgenv().mochiExitTick(instance, humanoidRootPart)
				end

				getgenv().MochiExitActive = false
				getgenv().MochiKilledAt = 0
				getgenv().MochiExitSince = nil
				getgenv().MochiExitSeatPos = nil
				local chainLen = #(getgenv().AfterBossChain or {})
				getgenv().AfterBossStage = chainLen + 1
			end

			if not getgenv().bossFightDone() then
				return true
			end

			local sinceBeaten = tick() - (getgenv().BigMomBeatenAt or 0)
			local tooSoon = (getgenv().AfterBossStage or 1) == 1
				and (getgenv().BigMomBeatenAt or 0) > 0
				and sinceBeaten < (getgenv().AfterBossDelay or 5)

			if tooSoon then
				getgenv().BigMomStep = string.format(
					"Big Mom is down - waiting %.1fs more before going for the way out",
					(getgenv().AfterBossDelay or 5) - sinceBeaten
				)
				return false
			end

			local afterBossStage = getgenv().AfterBossStage or 1
			local chainName = "AfterBossChain"

			if afterBossStage <= #(getgenv().AfterBossChain or {}) and getgenv().MochiSkipToFight ~= false then
				local mochiNow = getgenv().mochiEmperor()
				local npcRoot = mochiNow and getgenv().npcRoot

				if npcRoot then
					local npcRootFn = getgenv().npcRoot
					npcRoot = npcRootFn(mochiNow)
				end

				if npcRoot and npcRoot.Parent then
					local magnitude = (humanoidRootPart.Position - npcRoot.Position).Magnitude

					if magnitude <= (getgenv().MochiSkipRange or 1500) then
						afterBossStage = #(getgenv().AfterBossChain or {}) + 1
						getgenv().AfterBossStage = afterBossStage
						getgenv().AfterBossSince = nil
						getgenv().AfterBossSeatPos = nil
						local bmLog = getgenv().BMLog

						if bmLog then
							local sinceSkipLog = tick() - (getgenv().LastMochiSkipLog or 0)
							bmLog = sinceSkipLog >= 10
						end

						if bmLog then
							getgenv().LastMochiSkipLog = tick()
							getgenv().BMLog(
								string.format(
									"[AfterBoss] %s is only %.0f studs away - skipping the TPBrick chain and going straight at him.",
									tostring(mochiNow.Name),
									magnitude
								)
							)
						end
					end
				end
			end

			if #(getgenv().AfterBossChain or {}) < afterBossStage then
				local mochiModel = getgenv().mochiEmperor()
				local bmMochiHold = humanoidRootPart:FindFirstChild("BM_MochiHold")
				local mochiGone = not mochiModel
				local holdHere, reactionOwnsUs, holdVel, stopDrift, format, mochiName, mochiText, now, mochiSeenAt, dropMochiHold

				if mochiGone then
					local sinceSeen = tick() - (getgenv().MochiSeenAt or 0)
					local recentlyLost = sinceSeen <= (getgenv().MochiLostHold or 6)

					if chainName then
						holdHere = recentlyLost

						if holdHere then
							reactionOwnsUs = getgenv().reactionOwnsUs
							holdHere = not reactionOwnsUs()
						end

						if holdHere then
							if not bmMochiHold then
								holdVel = Instance.new("BodyVelocity")
								holdVel.Name = "BM_MochiHold"
								holdVel.MaxForce = Vector3.new(1e9, 1e9, 1e9)
								holdVel.Velocity = Vector3.zero
								holdVel.Parent = humanoidRootPart
							end

							stopDrift = function()
								humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
							end

							pcall(stopDrift)
							format = string.format
							mochiName = getgenv().MochiName
							mochiText = tostring(mochiName)
							now = tick()
							mochiSeenAt = getgenv().MochiSeenAt or 0

							getgenv().BigMomStep = format(
								"%s streamed out %.1fs ago - hovering here until he is back",
								mochiText,
								now - mochiSeenAt
							)
							return false
						end

						if bmMochiHold then
							dropMochiHold = function()
								bmMochiHold:Destroy()
							end

							pcall(dropMochiHold)
						end
					end
				else
					holdHere = mochiGone

					if holdHere then
						reactionOwnsUs = getgenv().reactionOwnsUs
						holdHere = not reactionOwnsUs()
					end

					if holdHere then
						if not bmMochiHold then
							holdVel = Instance.new("BodyVelocity")
							holdVel.Name = "BM_MochiHold"
							holdVel.MaxForce = Vector3.new(1e9, 1e9, 1e9)
							holdVel.Velocity = Vector3.zero
							holdVel.Parent = humanoidRootPart
						end

						stopDrift = function()
							humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
						end

						pcall(stopDrift)
						format = string.format
						mochiName = getgenv().MochiName
						mochiText = tostring(mochiName)
						now = tick()
						mochiSeenAt = getgenv().MochiSeenAt or 0

						getgenv().BigMomStep = format(
							"%s streamed out %.1fs ago - hovering here until he is back",
							mochiText,
							now - mochiSeenAt
						)
						return false
					end

					if bmMochiHold then
						dropMochiHold = function()
							bmMochiHold:Destroy()
						end

						pcall(dropMochiHold)
					end
				end

				if mochiGone then
					getgenv().AfterBossSince = getgenv().AfterBossSince or tick()
					local sinceAfterBoss = tick() - getgenv().AfterBossSince
					local gateShut = getgenv().chateauDoorOpen() == false
					local afterBossMochiMaxShut = gateShut and (getgenv().AfterBossMochiMaxShut or 600)
						or getgenv().AfterBossMochiMax
						or 60

					if sinceAfterBoss > afterBossMochiMaxShut then
						local afterBossStandDown = getgenv().afterBossStandDown
						local mochiName = tostring(getgenv().MochiName)
						gateShut = gateShut
							and " (and the Chateau door is shut, so there is no run to go back to either)"
						afterBossStandDown(
							string.format("the %s never appeared in %.0fs%s", mochiName, sinceAfterBoss, gateShut or "")
						)
						return true
					end

					local bigMomStep = string.format(
						"through both TPBricks - waiting for the %s (%.0fs of %.0f%s)",
						tostring(getgenv().MochiName),
						sinceAfterBoss,
						afterBossMochiMaxShut,
						gateShut and ", farm is finished so nothing else to do" or ""
					)
					getgenv().BigMomStep = bigMomStep
					return false
				end

				getgenv().AfterBossSince = nil
				local npcRoot = getgenv().npcRoot and getgenv().npcRoot(mochiModel)

				if npcRoot then
					npcRoot = (humanoidRootPart.Position - npcRoot.Position).Magnitude
				end

				npcRoot = npcRoot or -1

				if not getgenv().weaponInHand(instance) then
					getgenv().askWeaponEquip("the " .. tostring(getgenv().MochiName) .. " fight")
				end

				getgenv().BigMomStep = string.format(
					"fighting the %s (%.0f studs)%s",
					tostring(mochiModel.Name),
					npcRoot,
					tweenState.Enabled and ", chasing" or ""
				)

				if getgenv().reactionOwnsUs() then
					if tweenState.Enabled then
						pcall(stopTween)
					end

					return false
				end

				local shouldChase = not tweenState.Enabled or tweenState.AtGoal and getgenv().CampChaseAlways ~= false

				if
					shouldChase
					and tweenState.Enabled
					and tick() - (getgenv().LastMochiChase or 0) < (getgenv().CampChaseRefire or 1)
				then
					shouldChase = false
				end

				if shouldChase then
					getgenv().LastMochiChase = tick()

					if tweenState.Enabled then
						pcall(stopTween)
					end

					pcall(function()
						tweenToMob({
							TargetMob = mochiModel,
							Speed = getgenv().CampChaseSpeed or 60,
							Offset = getgenv().CampOffset,
							Container = function()
								local mochiNow = getgenv().mochiEmperor()
								return mochiNow and { mochiNow } or {}
							end,
						})
					end)
				end

				return false
			end

			local afterBossSeatPos = getgenv().AfterBossSeatPos
				and (humanoidRootPart.Position - getgenv().AfterBossSeatPos).Magnitude
					> (getgenv().AfterBossJump or 250)

			if afterBossSeatPos then
				getgenv().afterBossAdvance("stage " .. tostring(afterBossStage) .. " teleported us")
				return false
			end

			local stepPart, stepLabel, stepWhy = getgenv().afterBossPart(afterBossStage)

			if not stepPart then
				getgenv().AfterBossSince = getgenv().AfterBossSince or tick()
				local sinceAfterBoss = tick() - getgenv().AfterBossSince
				local afterBossWaypoint = getgenv().AfterBossWaypoint
				local tries = (getgenv().WaypointTried or {})[afterBossStage] or 0

				if
					afterBossWaypoint
					and tick() - tries >= (getgenv().AfterBossWaypointRetry or 20)
					and sinceAfterBoss <= (getgenv().AfterBossWaypointMax or 45)
				then
					local magnitude = (humanoidRootPart.Position - afterBossWaypoint).Magnitude

					if (getgenv().AfterBossWaypointReach or 12) < magnitude then
						getgenv().BigMomStep = string.format(
							"can't find %s - going to the waypoint first (%.0f studs)",
							tostring(stepLabel),
							magnitude
						)
						getgenv().BigMomBusy = true
						pcall(
							getgenv().goTo,
							CFrame.new(afterBossWaypoint),
							"the after-boss waypoint",
							getgenv().AfterBossWaypointReach or 12
						)
						getgenv().BigMomBusy = false
						return false
					end

					local waypointTried = getgenv().WaypointTried
					waypointTried[afterBossStage] = tick()

					if getgenv().BMLog then
						local portalOpen = getgenv().postBossPortalOpen()
						local bmLog = getgenv().BMLog
						local x = afterBossWaypoint.X
						local y = afterBossWaypoint.Y
						local z = afterBossWaypoint.Z
						local stepText = tostring(stepLabel)
						bmLog(
							string.format(
								"[AfterBoss] On the waypoint (%.0f, %.0f, %.0f) looking for %s again. Portal open=%s.",
								x,
								y,
								z,
								stepText,
								tostring(portalOpen)
							)
						)
					end

					if select(1, getgenv().afterBossPart(afterBossStage)) then
						return false
					end
				end

				if (getgenv().AfterBossWait or 20) < sinceAfterBoss then
					if getgenv().findTPBrickBy({}) == nil then
						getgenv().afterBossStandDown(
							string.format(
								"%s is missing and there is no TPBrick anywhere in the world",
								tostring(stepLabel)
							)
						)
						return true
					end

					getgenv().afterBossAdvance(tostring(stepLabel) .. " never appeared")
					return false
				end

				getgenv().BigMomStep =
					string.format("%s is not loaded yet (%.0fs)", tostring(stepLabel), sinceAfterBoss)
				return false
			end

			local stepSpot = getgenv().standAtPart(stepPart)

			if not stepSpot then
				return false
			end

			local afterBossSeatPos = getgenv().AfterBossSeatPos

			if afterBossSeatPos then
				afterBossSeatPos = (humanoidRootPart.Position - getgenv().AfterBossSeatPos).Magnitude
					> (getgenv().AfterBossJump or 250)
			end

			if afterBossSeatPos then
				getgenv().afterBossAdvance(tostring(stepLabel) .. " teleported us")
				return false
			end

			local magnitude = (humanoidRootPart.Position - stepSpot.Position).Magnitude

			if getgenv().insidePart(stepPart, humanoidRootPart.Position) then
				getgenv().AfterBossSeatPos = stepSpot.Position
				getgenv().BigMomStep = "standing on " .. tostring(stepLabel) .. ", waiting to be taken"
				getgenv().knockPortal(stepPart, stepSpot, tostring(stepLabel))
				return false
			end

			if magnitude > (getgenv().ExitSeatFrom or 22) then
				local approachCF = getgenv().exitApproachCF(stepPart, stepSpot, humanoidRootPart.Position)
				getgenv().BigMomStep = string.format(
					"Big Mom is down - heading for %s (%.0f studs, %s)",
					tostring(stepLabel),
					magnitude,
					tostring(stepWhy)
				)
				getgenv().clearPortalKnock()
				getgenv().BigMomBusy = true
				pcall(
					getgenv().goTo,
					approachCF,
					"the floor in front of " .. tostring(stepLabel),
					getgenv().AfterBossReach or 3
				)
				getgenv().BigMomBusy = false
				return false
			end

			getgenv().AfterBossSeats = (getgenv().AfterBossSeats or 0) + 1
			getgenv().AfterBossSeatPos = stepSpot.Position
			getgenv().BigMomStep =
				string.format("%.1f studs from %s - stepping onto it", magnitude, tostring(stepLabel))

			if getgenv().knockPortal(stepPart, stepSpot, tostring(stepLabel)) then
				return false
			end

			getgenv().stepTo(humanoidRootPart, stepSpot.Position, tostring(stepLabel))

			if getgenv().BMLog and getgenv().AfterBossSeats % 5 == 1 then
				local bmLog = getgenv().BMLog
				local stepText = tostring(stepLabel)
				bmLog(
					string.format(
						"[AfterBoss] Big Mom is down - stepping onto %s to leave (%s, x%d).",
						stepText,
						tostring(stepWhy),
						getgenv().AfterBossSeats
					)
				)
			end

			return false
		end

		-- report on the after-boss chain
		getgenv().AfterBossInfo = function()
			local afterBossState = getgenv().AfterBoss == false and "OFF" or "on"

			local lines = {
				string.format(
					"[AfterBoss] %s | stage %d of %d+fight | bossDone=%s",
					afterBossState,
					getgenv().AfterBossStage or 1,
					#(getgenv().AfterBossChain or {}),
					tostring(getgenv().bossFightDone())
				),
			}

			local afterBossChain = getgenv().AfterBossChain or {}

			for k, step in ipairs(afterBossChain) do
				local instance, _label, why = getgenv().afterBossPart(k)
				lines[#lines + 1] = string.format(
					"   %d. %-26s %s%s",
					k,
					tostring(step.why),
					instance and "FOUND" or "missing",
					instance and "  (" .. tostring(why) .. ")  " .. instance:GetFullName() or ""
				)
			end

			local doorOpen, doorWhy = getgenv().chateauDoorOpen()
			lines[#lines + 1] = string.format(
				"   Chateau door: %s (%s) -> farm %s",
				doorOpen == nil and "unreadable" or doorOpen and "OPEN" or "SHUT",
				tostring(doorWhy),
				doorOpen == nil and "unknown" or doorOpen and "still to do" or "finished"
			)
			local portalOpen, portalWhy = getgenv().postBossPortalOpen()
			lines[#lines + 1] = string.format(
				"   portal open=%s%s  <- this is the real gate",
				tostring(portalOpen),
				portalOpen and " (stage " .. tostring(portalWhy) .. ")" or ""
			)
			local mirrorVisible, mirrorWhy = getgenv().mirrorVisible()
			lines[#lines + 1] = string.format(
				"   mirror: visible=%s (%s) - decoration, not a gate",
				tostring(mirrorVisible),
				tostring(mirrorWhy)
			)
			local row = #lines + 1
			lines[row] = string.format(
				"   waypoint: %s | last tried: %s",
				tostring(getgenv().AfterBossWaypoint),
				next(getgenv().WaypointTried or {}) == nil and "never" or "recently"
			)
			local mochi = getgenv().mochiEmperor()
			local nextRow = #lines + 1
			local fightLine = "   fight: "
				.. tostring(getgenv().MochiName)
				.. " -> "
				.. (mochi and "alive, " .. mochi:GetFullName() or "not present")
			lines[nextRow] = fightLine
			local report = table.concat(lines, "\n")

			return report
		end

		-- --------------------------------------------------------------------
		-- 3.35 Big Mom / room bookkeeping and offsets
		-- --------------------------------------------------------------------

		getgenv().declareRoomDone = function(roomName, why)
			local doneKey = string.format("%s in room %s", tostring(why), tostring(roomName))
			local hadExit = getgenv().ExitFromRoom ~= nil

			if hadExit then
				getgenv().ExitFromRoom = nil
			end

			if getgenv().FinishedHandled == doneKey then
				getgenv().FinishedHandled = nil
			end

			return doneKey
		end

		getgenv().MobOffsetByName = getgenv().MobOffsetByName
			or { ["Juice Empress"] = Vector3.new(0, 13, 0), ["Big Mama"] = Vector3.new(0, 13, 0) }

		if getgenv().MobOffsetByName["Big Mama"] == nil then
			getgenv().MobOffsetByName["Big Mama"] = Vector3.new(0, 13, 0)
		end

		getgenv().MobOffsetByName["Mochi Emperor"] = Vector3.new(0, getgenv().MochiOffsetY or 12, 0)

		getgenv().NamedOffsetLog = getgenv().NamedOffsetLog ~= false
		getgenv().BigMomOffsetName = getgenv().BigMomOffsetName or "Big Mama"

		-- sets (or shows) how high above Big Mom we sit; returns whether it changed
		getgenv().BigMomOffset = function(newY)
			local bigMomOffsetName = getgenv().BigMomOffsetName or "Big Mama"
			getgenv().MobOffsetByName = getgenv().MobOffsetByName or {}
			local oldOffset = getgenv().MobOffsetByName[bigMomOffsetName]

			if newY ~= nil then
				local num = tonumber(newY)

				if not num then
					pcall(function()
						getgenv().BigMomPrint("[Offset] give it a number, e.g. getgenv().BigMomOffset(13)")
					end)
					return "[Offset] give it a number, e.g. getgenv().BigMomOffset(13)"
				end

				getgenv().MobOffsetByName[bigMomOffsetName] = Vector3.new(0, num, 0)
			end

			local offset = getgenv().MobOffsetByName[bigMomOffsetName]
			local bigMom = getgenv().findBigMom and getgenv().findBigMom()
			local bigMomPosition = bigMom and getgenv().bigMomPosition and getgenv().bigMomPosition(bigMom) or nil
			local humanoidRootPart = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
			local changed

			if bigMomPosition and humanoidRootPart then
				local magnitude = (
					Vector3.new(humanoidRootPart.Position.X, 0, humanoidRootPart.Position.Z)
					- Vector3.new(bigMomPosition.X, 0, bigMomPosition.Z)
				).Magnitude
				offset = offset and string.format("%.0f", offset.Y) or "none"
				local wasText = newY ~= nil and oldOffset and string.format(" (was %.0f)", oldOffset.Y) or ""
				changed = string.format(
					"[Offset] %s: asked %s%s | RIGHT NOW dY %+.1f, flat %.1f studs off her",
					bigMomOffsetName,
					offset,
					wasText,
					humanoidRootPart.Position.Y - bigMomPosition.Y,
					magnitude
				)
			else
				if offset then
					offset = string.format("%.0f", offset.Y)
				end

				changed = string.format(
					"[Offset] %s: asked %s%s | she is not loaded, so there is nothing to measure against yet",
					bigMomOffsetName,
					offset or "none",
					newY ~= nil and oldOffset and string.format(" (was %.0f)", oldOffset.Y) or ""
				)
			end

			pcall(function()
				getgenv().BigMomPrint(changed)
			end)
			return changed
		end

		-- the per-name chase offset for this NPC, and the name it matched
		getgenv().namedChaseOffset = function(npc)
			if not (npc and npc.Name) then
				return nil
			end

			local mobOffsetByName = getgenv().MobOffsetByName or {}
			local offset = mobOffsetByName[npc.Name]

			if offset then
				return offset, npc.Name
			end

			for k, offset in pairs(mobOffsetByName) do
				if type(k) == "string" and k ~= "" and string.find(npc.Name, k, 1, true) then
					return offset, k
				end
			end

			return nil
		end

		-- report on the camp room we are in: mobs alive, seen, and whether it is cleared
		getgenv().CampInfo = function()
			local campRoom, instances, reportLines, format, aliveCount

			while true do
				local _campModel
				campRoom, _campModel, instances = getgenv().campCheck()

				if campRoom then
					reportLines = {}
					format = string.format
					aliveCount = #instances

					if not aliveCount then
						continue
					end

					break
				end

				local roomName = getgenv().currentCakeStage()
				local campNames = {}
				local campRooms = getgenv().CampRooms or {}

				for k in pairs(campRooms) do
					campNames[#campNames + 1] = k
				end

				local report = string.format(
					"[Camp] room %s is not a camp room (camps: %s)",
					tostring(roomName),
					table.concat(campNames, ", ")
				)

				return report
			end

			local seen = getgenv().CampSeen[campRoom] or 0
			local clearedPacked = table.pack(tostring(getgenv().CampCleared[campRoom] == true))

			do
				local values = table.pack(
					format(
						"[Camp] room %s - %d alive, %d seen, cleared=%s",
						campRoom,
						aliveCount,
						seen,
						table.unpack(clearedPacked, 1, clearedPacked.n)
					)
				)
				table.move(values, 1, values.n, 1, reportLines)
			end

			local humanoidRootPart = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")

			for _, instance in ipairs(instances) do
				local hum = instance:FindFirstChildOfClass("Humanoid")
				local root = getgenv().npcRoot(instance)
