					local callbacks =
						ReplicatedStorage:FindFirstChild(getgenv().FruitCallbackFolder or "SkillCallbacks")
					callbacks = callbacks and callbacks:FindFirstChild(getgenv().FruitCallbackChild or "DevilFruit")

					if not callbacks then
						return
					end

					for _, tool in ipairs(callbacks:GetChildren()) do
						local front = getgenv().fruitFrontName(tool.Name)

						if front and not seen[front] then
							seen[front] = true
							table.insert(names, front)
