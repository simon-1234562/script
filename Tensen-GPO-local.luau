		-- --------------------------------------------------------------------
		-- 3.40 Big Mom / puzzle: soul orbs
		-- --------------------------------------------------------------------

		getgenv().isOrbPing = function(sound)
			if not sound or sound.ClassName ~= "Sound" then
				return false
			end

			if sound.Name == (getgenv().OrbPingName or "Ping") then
				return true
			end

			local pingId = tostring(getgenv().OrbPingId or "")

			if pingId ~= "" then
				local soundId = tostring(sound.SoundId or "")

				if soundId == pingId then
					return true
				end

				local pingDigits = string.match(pingId, "%d+")

				if pingDigits and string.find(soundId, pingDigits, 1, true) then
					return true
				end
			end

			return false
		end

		-- remembers that an orb ping was heard; false when pings are not used
		getgenv().notePing = function()
			if getgenv().OrbUsePing == false then
				return false
			end

			local now = tick()

			if now - (getgenv().LastOrbPing or 0) < (getgenv().OrbPingDebounce or 0.05) then
				return false
			end

			getgenv().LastOrbPing = now
			getgenv().OrbPingHeard = (getgenv().OrbPingHeard or 0) + 1
			local orbPingQueue = getgenv().OrbPingQueue
			orbPingQueue[#orbPingQueue + 1] = now
			return true
		end

		-- the dungeon room with the soul orb tree (CenterTree)
		getgenv().orbRoom = function()
			for _, wholeCakeRoom in ipairs(getgenv().wholeCakeRooms()) do
				local interactables = wholeCakeRoom:FindFirstChild("Interactables")

				if interactables and interactables:FindFirstChild("CenterTree") then
					return wholeCakeRoom
				end
			end

			return nil
		end

		-- the soul orb part in the orb room
		getgenv().orbPart = function(room)
			local orbRoom = room or getgenv().orbRoom()

			if not orbRoom then
				return nil
			end

			local orbPath = getgenv().OrbPath or {}

			for _, name in ipairs(orbPath) do
				orbRoom = orbRoom and orbRoom:FindFirstChild(name)
			end

			if orbRoom and orbRoom:IsA("BasePart") then
				return orbRoom
			end

			return nil
		end

		-- the folder with the sunflowers in the orb room
		getgenv().soulFlowers = function(room)
			local orbRoom = room or getgenv().orbRoom()

			if not orbRoom then
				return nil
			end

			local flowerPath = getgenv().FlowerPath or {}

			for _, name in ipairs(flowerPath) do
				orbRoom = orbRoom and orbRoom:FindFirstChild(name)
			end

			return orbRoom
		end

		-- the OrbPalette colour name closest to a Color3, and the distance
		getgenv().orbColourName = function(colour)
			local bestDist = math.huge
			local iterFn, iterState, iterStart = ipairs(getgenv().OrbPalette or {})
			local name = nil

			for _, entry in iterFn, iterState, iterStart do
				local dist = math.sqrt(
					(colour.R - entry.colour.R) ^ 2 + (colour.G - entry.colour.G) ^ 2 + (colour.B - entry.colour.B) ^ 2
				)

				if dist < bestDist then
					name = entry.name
					bestDist = dist
				end
			end

			return name, bestDist
		end

		-- the sunflower for a colour, the part to stand on, and how it was matched
		getgenv().flowerFor = function(name, flowers)
			local flowerFolder = flowers or getgenv().soulFlowers()

			if not (flowerFolder and name) then
				return nil
			end

			local flower = flowerFolder:FindFirstChild(name)
			local how = "by name"

			if not flower then
				local orbPalette = getgenv().OrbPalette or {}
				local colour = nil

				for _, entry in ipairs(orbPalette) do
					if entry.name == name then
						colour = entry.colour
						break
					end

					colour = nil
				end

				if colour then
					local bestDist = math.huge
					flower = nil

					for _, book in ipairs(flowerFolder:GetChildren()) do
						local bookColor = book:FindFirstChild(getgenv().BookColorName or "Recolorable", true)
						bookColor = bookColor and getgenv().firstBasePart(bookColor)

						if bookColor then
							local color = bookColor.Color
							local dist = math.sqrt(
								(color.R - colour.R) ^ 2 + (color.G - colour.G) ^ 2 + (color.B - colour.B) ^ 2
							)

							if dist < bestDist then
								bestDist = dist
								flower = book
							end
						end
					end

					how = "by its Recolorable colour"
				end
			end

			if not flower then
				return nil
			end

			local bookTouch = flower:FindFirstChild(getgenv().BookTouchName or "Part")

			if not (bookTouch and bookTouch:IsA("BasePart")) then
				bookTouch = getgenv().biggestBasePart(flower)
			end

			return flower, bookTouch, how
		end

		getgenv().FlowerCamLook = getgenv().FlowerCamLook ~= false
		getgenv().FlowerCamBack = getgenv().FlowerCamBack or 8
		getgenv().FlowerCamUp = getgenv().FlowerCamUp or 4
		getgenv().FlowerCamSettle = getgenv().FlowerCamSettle or 0.15
		getgenv().FlowerCamHold = getgenv().FlowerCamHold or 0.2

		-- empty in the dump (its body is missing)
		getgenv().flowerPrompt = function() end

		-- world position of a prompt's parent (attachment, part or model)
		getgenv().promptWorldPos = function(instance)
			local parent = instance and instance.Parent

			if not parent then
				return
			end

			if parent:IsA("Attachment") then
				return parent.WorldPosition
			end

			if parent:IsA("BasePart") then
				return parent.Position
			end

			local ok, result = pcall(function()
				return parent:GetPivot()
			end)

			return ok and result and result.Position or nil
		end

		do
			-- presses E on a sunflower. The camera is switched to Scriptable around the press but never aimed
			-- (the dump lost the aiming), then put back
			local function pressFlowerE(instance, prompt, label)
				if getgenv().FlowerCamLook == false or not (instance and instance.Parent) then
					return getgenv().tapE(0)
				end

				prompt = prompt or instance.Parent
				local currentCamera = Workspace.CurrentCamera
				local rootPart = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
				local flowerPrompt = getgenv().flowerPrompt(instance, prompt)

				if not (currentCamera and rootPart) then
					return getgenv().tapE(0)
				end

				local cameraType = currentCamera.CameraType

				pcall(function()
					currentCamera.CameraType = Enum.CameraType.Scriptable
				end)
				task.wait(getgenv().FlowerCamSettle or 0.15)
				local tapped = getgenv().tapE(0)
				task.wait(getgenv().FlowerCamHold or 0.2)

				pcall(function()
					if currentCamera.Parent and currentCamera.CameraType == Enum.CameraType.Scriptable then
						currentCamera.CameraType = cameraType
					end
				end)

				if getgenv().BMLog then
					getgenv().BMLog(
						string.format(
							"[Orb] Camera on %s's prompt (%s) for the E press.",
							tostring(label or instance.Name),
							flowerPrompt and flowerPrompt:GetFullName() or "no prompt found, aimed at the part"
						)
					)
				end

				return tapped
			end

			getgenv().pressFlowerE = pressFlowerE
		end

		-- walks to each sunflower of the orb's colour pattern in order and presses it; true when all were
		-- pressed
		getgenv().answerOrbPattern = function(pattern)
			local flowers = getgenv().soulFlowers()

			if not flowers then
				return false, 0, 0
			end

			local cakeTweenSpeed = getgenv().CakeTweenSpeed
			getgenv().CakeTweenSpeed = getgenv().OrbAnswerSpeed or 120
			local now = tick()
			local lastColour = nil
			local lastPress = 0
			local pressed = 0

			for i, colour in ipairs(pattern) do
				if bmStale() or not getgenv().EnableBigMom then
					break
				end

				local how, instance = getgenv().flowerFor(colour, flowers)

				if instance and instance.Parent then
					local humanoidRootPart = localPlayer.Character
						and localPlayer.Character:FindFirstChild("HumanoidRootPart")
					local magnitude = humanoidRootPart and (humanoidRootPart.Position - instance.Position).Magnitude
						or math.huge
					local sameAsLast = lastColour ~= nil and lastColour == colour

					local heldFor = 0

					if not (lastPress > 0) then
						if bmStale() or not getgenv().EnableBigMom then
							break
						end

						if (getgenv().FlowerReach or 10) + 2 < magnitude then
							getgenv().BigMomStep = string.format(
								"soul orbs %d/%d - walking to the %s sunflower",
								i,
								#pattern,
								tostring(colour)
							)
							local goTo = getgenv().goTo
							local spot = getgenv().standAtPart(instance)
							local flowerLabel = "the " .. tostring(colour) .. " sunflower"

							pcall(goTo, spot, flowerLabel, getgenv().FlowerReach or 10)
							local humanoidRootPart = localPlayer.Character
								and localPlayer.Character:FindFirstChild("HumanoidRootPart")
							magnitude = humanoidRootPart and (humanoidRootPart.Position - instance.Position).Magnitude
								or math.huge
						else
							getgenv().waitBeforeClick(string.format("the %s sunflower", tostring(colour)))
						end

						if bmStale() or not getgenv().EnableBigMom then
							break
						end

						getgenv().BigMomStep =
							string.format("soul orbs %d/%d - pressing E on %s", i, #pattern, tostring(colour))
						getgenv().pressFlowerE(instance, how, tostring(colour))
						lastPress = tick()
						pressed += 1

						if getgenv().OrbLog ~= false and getgenv().BMLog then
							getgenv().BMLog(
								string.format(
									"[Orb] %5.1fs  %d/%d  E on the %s sunflower at %.1f studs%s.",
									tick() - now,
									i,
									#pattern,
									tostring(colour),
									magnitude,
									heldFor > 0
											and string.format(
												" (held %.1fs first%s)",
												heldFor,
												sameAsLast and ", same flower twice" or ""
											)
										or ""
								)
							)
						end

						lastColour = colour
						continue
					end
				end

				if getgenv().BMLog then
					getgenv().BMLog(
						string.format(
							"[Orb] no '%s' sunflower in the room - skipping it, which will cost this round.",
							tostring(colour)
						)
					)
				end
			end

			getgenv().CakeTweenSpeed = cakeTweenSpeed

			return pressed == #pattern, pressed, tick() - now
		end

		do
			-- the orb puzzle report (in the dump it hits the anti-tamper trap when the orb exists)
			local function orbInfo()
				local room = getgenv().orbRoom()
				local orb = getgenv().orbPart(room)
				local flowers = getgenv().soulFlowers(room)
				local lines = {}
				local name = room and room.Name
				local character

				if not name then
					name = "not found"
				end

				local orbText = orb and "found" or "MISSING"
				local flowerText

				if flowers then
					character = flowers
					flowerText = #character:GetChildren() .. " models"
				else
					flowerText = flowers
				end

				flowerText = flowerText or "MISSING"

				do
					local values =
						table.pack(string.format("[Orb] room %s | orb %s | flowers %s", name, orbText, flowerText))
					table.move(values, 1, values.n, 1, lines)
				end

				local iterFn

				if orb then
					local _colourDist
					character, _colourDist = getgenv().orbColourName(orb.Color)

					lines[#lines + 1] = "Orb color: " .. tostring(character)
				end

				local myRoot = localPlayer.Character

				if myRoot then
					character = localPlayer.Character
					myRoot = character:FindFirstChild("HumanoidRootPart")
				end

				local iterState, iterStart
				iterFn, iterState, iterStart = ipairs(getgenv().OrbPalette or {})

				for _, flower in iterFn, iterState, iterStart do
					local name = flower.name

					if getgenv().OrbWhiteName then
						break
					end

					if name == "WHITE" then
						continue
					end

					local how, flowerDist
					how, character, flowerDist = getgenv().flowerFor(flower.name, flowers)
					local idx = #lines + 1
					local flowerName = flower.name
					how = how and tostring(flowerDist) .. ", stand at " .. (character and character.Name or "?")
						or "NOT FOUND"
					local distText = character and myRoot

					if distText then
						character = myRoot.Position - character.Position
						distText = string.format(" (%.0f studs)", character.Magnitude)
					end

					lines[idx] = string.format("  %-7s %s%s", flowerName, how, distText or "")
				end
			end

			getgenv().OrbInfo = orbInfo
		end

		-- colour name of an orb ping part (when close enough to a palette colour)
		getgenv().adoptOrbColour = function(instance)
			if not (instance and instance.Parent) then
				return nil
			end

			local colourName, colourDist = getgenv().orbColourName(instance.Color)

			if colourDist <= (getgenv().OrbSettleTol or 0.06) then
				return colourName
			end

			return nil
		end

		-- answers an orb round with the recorded pattern; the last round (OrbFinalLength colours) counts as
		-- won
		getgenv().orbAnswerNow = function(pattern, label)
			local count = #pattern

			if (getgenv().OrbFinalLength or 4) <= count then
				getgenv().OrbSolved = true
				getgenv().OrbSolvedAt = tick()

				if getgenv().BMLog then
					getgenv().BMLog(
						string.format(
							"[Orb] that was a %d-colour round, which is the last one - treating the minigame as WON and heading for the door without waiting for her to say so.",
							#pattern
						)
					)
				end
			end

			getgenv().OrbPattern = {}
			getgenv().OrbRounds = (getgenv().OrbRounds or 0) + 1

			if getgenv().BMLog then
				getgenv().BMLog(
					string.format(
						"[Orb] %s - answering %d: %s",
						tostring(label),
						#pattern,
						table.concat(pattern, " -> ")
					)
				)
			end

			getgenv().BigMomBusy = true
			local cakeTweenSpeed = getgenv().CakeTweenSpeed
			local ran, answered, pressedCount, total = pcall(getgenv().answerOrbPattern, pattern)
			getgenv().CakeTweenSpeed = cakeTweenSpeed
			getgenv().BigMomBusy = false
			getgenv().OrbQuietSince = tick()

			if not getgenv().BMLog then
				return
			end

			local bmLog = getgenv().BMLog

			if ran then
				local pressedNum = tonumber(pressedCount) or 0
				local patternLen = #pattern
				local totalNum = tonumber(total) or 0
				ran = string.format(
					"[Orb] pressed %d of %d in %.1fs (round %d).",
					pressedNum,
					patternLen,
					totalNum,
					getgenv().OrbRounds or 0
				)
			end

			bmLog(ran or "[Orb] the answer errored: " .. tostring(answered))
		end

		-- records the colour pattern the orb shows and answers it once the orb goes quiet
		getgenv().orbRecord = function(pattern, source)
			if not pattern then
				return false
			end

			local orbWhiteName = getgenv().OrbWhiteName or "WHITE"
			getgenv().OrbQuietSince = tick()

			if pattern ~= orbWhiteName then
				local orbPattern = getgenv().OrbPattern or {}
				orbPattern[#orbPattern + 1] = pattern
				getgenv().OrbPattern = orbPattern

				if getgenv().OrbSolved then
					getgenv().OrbSolved = false

					if getgenv().BMLog then
						getgenv().BMLog(
							"[Orb] the orb is showing colours again, so the round we called finished was not - back to solving."
						)
					end
				end

				if getgenv().OrbLog ~= false and getgenv().BMLog then
					local bmLog = getgenv().BMLog
					local patternText = tostring(pattern)
					local sourceText = tostring(source or "poll")
					bmLog(
						string.format(
							"[Orb] %s (%s) -> pattern: %s",
							patternText,
							sourceText,
							table.concat(orbPattern, " -> ")
						)
					)
				end

				return true
			end

			local orbPattern = getgenv().OrbPattern or {}

			if #orbPattern == 0 then
				if getgenv().OrbLog ~= false and getgenv().BMLog then
					getgenv().BMLog("[Orb] white with nothing recorded - that is the start of a round, watching.")
				end

				return false
			end

			getgenv().orbAnswerNow(orbPattern, "white, the round is over")
			return true
		end

		-- true when an orb ping was heard within OrbPingGrace seconds
		getgenv().orbPingLive = function()
			if getgenv().OrbUsePing == false then
				return false
			end

			if (getgenv().OrbPingHeard or 0) <= 0 then
				return false
			end

			return tick() - (getgenv().LastOrbPing or 0) < (getgenv().OrbPingGrace or 45)
		end

		task.spawn(function()
			local obj = setmetatable({}, { __mode = "k" })

			-- watches for the orb's colour pings
			local function onOrbPing(descendant, late)
				if obj[descendant] then
					return
				end

				if not getgenv().isOrbPing(descendant) then
					return
				end

				obj[descendant] = true

				if late then
					getgenv().notePing()
				end

				pcall(function()
					descendant.Played:Connect(function()
						if bmStale() then
							return
						end

						getgenv().notePing()
					end)
				end)
			end

			for _, descendant in ipairs(Workspace:GetDescendants()) do
				onOrbPing(descendant, false)
			end

			Workspace.DescendantAdded:Connect(function(descendant)
				if bmStale() then
					return
				end

				onOrbPing(descendant, true)
			end)
		end)

		task.spawn(function()
			while task.wait(0.03) do
				if bmStale() then
					break
				end

				local orbPingQueue = getgenv().OrbPingQueue

				if not (orbPingQueue and #orbPingQueue ~= 0) then
					continue
				end

				local ping = table.remove(orbPingQueue, 1)

				if getgenv().SoulOrbPuzzle == false then
					continue
				end

				if not getgenv().EnableBigMom then
					continue
				end

				local room = getgenv().orbRoom()

				if not room then
					continue
				end

				local roomNow
				roomNow, roomNow = getgenv().currentCakeStage()

				if roomNow ~= room then
					continue
				end

				while tick() - ping < (getgenv().OrbPingSettle or 0.12) do
					task.wait(0.02)
				end

				local orbSettleTol = getgenv().OrbSettleTol or 0.06
				local deadline = tick() + (getgenv().OrbPingWait or 0.4)
				local colourName = nil
				local colourDist = nil

				while true do
					local orb = getgenv().orbPart(room)

					if orb and orb.Parent then
						colourName, colourDist = getgenv().orbColourName(orb.Color)
					end

					if not (colourName and colourDist and colourDist <= orbSettleTol) then
						task.wait(0.02)

						if not (tick() > deadline) then
							continue
						end
					end

					break
				end

				if colourName and colourDist and colourDist <= orbSettleTol then
					getgenv().OrbPingUsed = (getgenv().OrbPingUsed or 0) + 1
					getgenv().orbRecord(colourName, "ping")
				else
					getgenv().OrbPingMissed = (getgenv().OrbPingMissed or 0) + 1

					if getgenv().OrbLog ~= false and getgenv().BMLog then
						getgenv().BMLog(
							string.format(
								"[Orb] a ping fired but the orb never settled on a palette colour within %.2fs (closest %s, off by %.3f) - that step is lost (x%d).",
								getgenv().OrbPingWait or 0.4,
								tostring(colourName),
								tonumber(colourDist) or -1,
								getgenv().OrbPingMissed
							)
						)
					end
				end
			end
		end)

		task.spawn(function()
			getgenv().OrbQuietSince = tick()

			while true do
				if not task.wait(getgenv().OrbWatchRate or 0.05) then
					return
				end

				if bmStale() then
					return
				end

				if getgenv().SoulOrbPuzzle == false then
					continue
				end

				if not getgenv().EnableBigMom then
					continue
				end

				local room = getgenv().orbRoom()
				local orb = getgenv().orbPart(room)
				local answered = false

				if room then
					local roomNow
					roomNow, roomNow = getgenv().currentCakeStage()
					answered = roomNow == room
				end

				if orb and orb.Parent and answered then
					break
				end

				getgenv().OrbQuietSince = tick()

				if 0 < #(getgenv().OrbPattern or {}) then
					getgenv().OrbPattern = {}
				end
			end
		end)

		getgenv().DeathReturn = getgenv().DeathReturn ~= false

		getgenv().DeathReturnDelay = getgenv().DeathReturnDelay or 2

		getgenv().DeathReturnReach = getgenv().DeathReturnReach or 12
		getgenv().DeathReturnSpeed = getgenv().DeathReturnSpeed or 150
		getgenv().DeathReturnTries = getgenv().DeathReturnTries or 4

		getgenv().DeathReturnGiveUp = getgenv().DeathReturnGiveUp or 150

		getgenv().DeathReturnLog = getgenv().DeathReturnLog ~= false
		getgenv().Deaths = getgenv().Deaths or 0
		getgenv().DeathAt = getgenv().DeathAt or 0
		getgenv().DeathRoom = getgenv().DeathRoom
		getgenv().DeathPos = getgenv().DeathPos
		getgenv().DeathDeepest = getgenv().DeathDeepest
		getgenv().ReturnAfterDeath = false
		getgenv().ReturnTries = 0
		getgenv().RespawnedAt = getgenv().RespawnedAt or 0
		getgenv().LastDeathChar = nil

		-- --------------------------------------------------------------------
		-- 3.41 Big Mom / death return
		-- --------------------------------------------------------------------

		getgenv().cakeRoomByName = function(roomName)
			if roomName == nil then
				return nil
			end

			for _, wholeCakeRoom in ipairs(getgenv().wholeCakeRooms()) do
				if wholeCakeRoom.Name == tostring(roomName) then
					return wholeCakeRoom
				end
			end

			return nil
		end

		-- drops a pending walk-back after death and logs why
		getgenv().clearDeathReturn = function(reason)
			if getgenv().ReturnAfterDeath and getgenv().DeathReturnLog ~= false and getgenv().BMLog then
				getgenv().BMLog(
					string.format(
						"[Death] %s - picking the run up from here; the cake, the orbs and the boss are not being redone.",
						tostring(reason)
					)
				)
			end

			getgenv().ReturnAfterDeath = false
			getgenv().ReturnTries = 0
		end

		-- remembers where and in which room we died so we can walk back there
		getgenv().noteDeath = function(deathPos, reason)
			deathPos = deathPos or getgenv().LastInsidePos or getgenv().LastDungeonPos
			local roomName, _room, how = getgenv().currentCakeStage(deathPos)
			getgenv().Deaths = (getgenv().Deaths or 0) + 1
			getgenv().DeathAt = tick()
			getgenv().DeathPos = deathPos or getgenv().DeathPos
			getgenv().DeathRoom = how == "inside" and roomName ~= nil and tostring(roomName) or nil
			getgenv().DeathDeepest = getgenv().DeepestRoom
			getgenv().ReturnTries = 0
			getgenv().LastDeathChar = localPlayer.Character

			if getgenv().DeathReturn == false then
				return
			end

			local bossFightDone = getgenv().bossFightDone

			if bossFightDone then
				local bossFightDoneFn = getgenv().bossFightDone
				bossFightDone = bossFightDoneFn()
			end

			if bossFightDone then
				getgenv().afterBossRestart(string.format("death #%d", getgenv().Deaths or 0))
				return
			end

			if not (getgenv().DeathRoom or getgenv().DeepestRoom or getgenv().LastInsideRoom) then
				getgenv().ReturnAfterDeath = false

				if getgenv().DeathReturnLog ~= false and getgenv().BMLog then
					getgenv().BMLog("[Death] Died outside the dungeon - nothing to walk back to, starting normally.")
				end

				return
			end

			getgenv().ReturnAfterDeath = true

			if getgenv().DeathReturnLog ~= false and getgenv().BMLog then
				getgenv().BMLog(
					string.format(
						"[Death] Death #%d on %s%s (%s). Floors already done stay done - going back to that spot once we are up again.",
						getgenv().Deaths,
						tostring(getgenv().cakeStageLabel(getgenv().DeathRoom) or "no room"),
						deathPos and string.format(" at %.0f, %.0f, %.0f", deathPos.X, deathPos.Y, deathPos.Z) or "",
						tostring(reason or "Humanoid.Died")
					)
				)
			end
		end

		-- hooks a character's death so noteDeath runs when it dies
		getgenv().watchDeath = function(lastDeathChar)
			if not lastDeathChar then
				return
			end

			local hum = lastDeathChar:FindFirstChildOfClass("Humanoid") or lastDeathChar:WaitForChild("Humanoid", 10)

			if not hum then
				return
			end

			local ok, result = pcall(function()
				return hum:GetAttribute("BMDeathWatch")
			end)

			if ok and result then
				return
			end

			pcall(function()
				hum:SetAttribute("BMDeathWatch", true)
			end)

			hum.Died:Connect(function()
				if bmStale() then
					return
				end

				if getgenv().LastDeathChar == lastDeathChar then
					return
				end

				getgenv().LastDeathChar = lastDeathChar
				local humanoidRootPart = lastDeathChar:FindFirstChild("HumanoidRootPart")
				getgenv().noteDeath(humanoidRootPart and humanoidRootPart.Position or nil)
			end)
		end

		-- after respawning, walks back to the room we died in; true when there (or nothing to do)
		getgenv().returnToDeathFloor = function(instance)
			local returnOff = getgenv().DeathReturn == false
			local skipReturn = returnOff or not getgenv().ReturnAfterDeath

			if skipReturn then
				return true
			end

			instance = instance and instance:FindFirstChild("HumanoidRootPart")

			if not instance then
				getgenv().BigMomStep = "died - waiting for the new character"
				return false
			end

			local deathLabel = getgenv().cakeStageLabel(getgenv().DeathRoom) or "the spot we died on"
			local elapsed = tick() - math.max(getgenv().RespawnedAt or 0, getgenv().DeathAt or 0)

			if elapsed < (getgenv().DeathReturnDelay or 2) then
				getgenv().BigMomStep = string.format("died on %s - letting the respawn settle", tostring(deathLabel))
				return false
			end

			if (getgenv().DeathReturnGiveUp or 150) < tick() - (getgenv().DeathAt or 0) then
				getgenv().clearDeathReturn(
					string.format("%.0fs of trying to get back was enough", tick() - (getgenv().DeathAt or 0))
				)
				return true
			end

			local deathRoom = getgenv().DeathRoom and getgenv().cakeRoomByName(getgenv().DeathRoom) or nil

			if getgenv().DeathRoom and not deathRoom then
				local clearDeathReturn = getgenv().clearDeathReturn
				local deathRoomText = tostring(getgenv().DeathRoom)
				clearDeathReturn(
					"room " .. deathRoomText .. " is not in the workspace any more, so the dungeon was reset"
				)
				return true
			end

			local deathPos = getgenv().DeathPos

			if not deathPos and deathRoom then
				deathPos = getgenv().roomBox(deathRoom)
				deathPos = deathPos and deathPos.Position or nil
			end

			if not deathPos then
				getgenv().clearDeathReturn("nothing was recorded about where we died")
				return true
			end

			local roomName, _room, how = getgenv().currentCakeStage()
			local magnitude = (instance.Position - deathPos).Magnitude
			local backInRoom = getgenv().DeathRoom ~= nil and how == "inside"

			if backInRoom then
				local roomText = tostring(roomName)
				backInRoom = roomText == tostring(getgenv().DeathRoom)
			end

			if backInRoom or magnitude <= (getgenv().DeathReturnReach or 12) then
				local deepestBefore = tonumber(getgenv().DeathDeepest) or -1
				local num = tonumber(getgenv().DeathRoom)
				local deepest = math.max(deepestBefore, num or -1)

				if deepest >= 0 then
					local num = tonumber(getgenv().DeepestRoom)

					if not num or deepest > num then
						getgenv().DeepestRoom = tostring(math.floor(deepest))
						getgenv().DeepestAt = tick()
					end
				end

				getgenv().OutsideSince = nil
				getgenv().clearDeathReturn(
					backInRoom and "back on " .. tostring(deathLabel)
						or string.format("back within %.0f studs of the spot", magnitude)
				)
				return true
			end

			if (getgenv().ReturnTries or 0) >= (getgenv().DeathReturnTries or 4) then
				getgenv().clearDeathReturn(
					string.format("%d trips back did not land us there", getgenv().ReturnTries or 0)
				)
				return true
			end

			getgenv().ReturnTries = (getgenv().ReturnTries or 0) + 1
			getgenv().BigMomStep = string.format(
				"died on %s - going back (%.0f studs, try %d)",
				tostring(deathLabel),
				magnitude,
				getgenv().ReturnTries
			)

			if getgenv().DeathReturnLog ~= false and getgenv().BMLog then
				local bmLog = getgenv().BMLog
				local labelText = tostring(deathLabel)
				bmLog(
					string.format(
						"[Death] Up again %.0f studs from %s - tweening back to it instead of restarting the run (try %d/%d).",
						magnitude,
						labelText,
						getgenv().ReturnTries,
						getgenv().DeathReturnTries or 4
					)
				)
			end

			local cakeTweenSpeed = getgenv().CakeTweenSpeed
			getgenv().CakeTweenSpeed = getgenv().DeathReturnSpeed or cakeTweenSpeed
			getgenv().BigMomBusy = true
			pcall(getgenv().goTo, CFrame.new(deathPos), "the spot we died on", getgenv().DeathReturnReach or 12)
			getgenv().BigMomBusy = false
			getgenv().CakeTweenSpeed = cakeTweenSpeed
			return false
		end

		getgenv().RespawnIsDeath = getgenv().RespawnIsDeath ~= false
		getgenv().RespawnMemory = getgenv().RespawnMemory or 60
		getgenv().MochiDeathMemory = getgenv().MochiDeathMemory or 30
		local connection = nil

		connection = localPlayer.CharacterAdded:Connect(function(character)
			if bmStale() then
				if connection then
					connection:Disconnect()
					connection = nil
				end

				return
			end

			getgenv().RespawnedAt = tick()

			if getgenv().RespawnIsDeath == false or getgenv().DeathReturn == false then
				return
			end

			if getgenv().ReturnAfterDeath then
				return
			end

			if
				tick() - (getgenv().MochiSeenAt or 0) <= (getgenv().MochiDeathMemory or 30)
				or (getgenv().AfterBossStage or 1) > #(getgenv().AfterBossChain or {})
			then
				getgenv().Deaths = (getgenv().Deaths or 0) + 1
				getgenv().DeathAt = tick()
				getgenv().LastDeathChar = character
				pcall(
					getgenv().afterBossRestart,
					string.format(
						"respawned %.0fs after last seeing %s",
						tick() - (getgenv().MochiSeenAt or 0),
						tostring(getgenv().MochiName)
					)
				)
				return
			end

			local lastInsidePos = getgenv().LastInsidePos or getgenv().LastDungeonPos
			local lastInsideAt = math.max(getgenv().LastInsideAt or 0, getgenv().LastDungeonAt or 0)

			if not lastInsidePos or tick() - lastInsideAt > (getgenv().RespawnMemory or 60) then
				return
			end

			getgenv().LastDeathChar = character
			pcall(getgenv().noteDeath, lastInsidePos, "respawned, no Died event")
		end)

		-- --------------------------------------------------------------------
		-- 3.42 Big Mom / main farm loop
		-- --------------------------------------------------------------------

		task.spawn(function()
			getgenv().watchDeath(localPlayer.Character)
		end)

		getgenv().HandledOrder = getgenv().HandledOrder or nil
		getgenv().BigMomBusyMax = getgenv().BigMomBusyMax or 60
		getgenv().BigMomBusyFreed = getgenv().BigMomBusyFreed or 0

		task.spawn(function()
			local backtrackingRoom, startGateLabel
			local arrivedRoom, backtrackFrom, bookRoom, cakeOrder, cakesLeft, campMobs, campRoom
			local campRoomModel, chaseCoolingDown, deepestRoom, deliverRan, deliverWhy, delivered
			local deliveredCount, dialogueAt, dialogueKey, dialogueKind, doorWhy, dungeonWhy, exitCheckRoom
			local exitDoorWhy, exitLabel, exitPart, finishedRoom, floorRoom, gateCF, matchedBook, nearestMob
			local orbRoomNow, waitForBoss
			local busySince = nil

			-- main farm loop
			while true do
				if not task.wait(getgenv().BigMomRate or 0.25) then
					break
				end

				if bmStale() then
					break
				end

				if not getgenv().EnableBigMom then
					getgenv().BigMomStep = "off"
					continue
				end

				if not getgenv().inDungeonPlace() then
					getgenv().BigMomStep = "wrong place"
					continue
				end

				local character = getCharacter()
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")

				if not character or not humanoid or humanoid.Health <= 0 then
					getgenv().BigMomStep = "dead"
					local isNewDeath = (character and humanoid and humanoid.Health <= 0)
						and getgenv().LastDeathChar ~= character

					if isNewDeath then
						getgenv().LastDeathChar = character
						local deathPos = character:FindFirstChild("HumanoidRootPart")
						local noteDeath = getgenv().noteDeath

						if deathPos then
							deathPos = deathPos.Position
						end

						if not deathPos then
							deathPos = nil
						end

						pcall(noteDeath, deathPos)
					end

					continue
				end

				if getgenv().ReturnAfterDeath and not getgenv().returnToDeathFloor(character) then
					continue
				end

				if getgenv().BigMomBusy then
					if not busySince then
						busySince = tick()
					end

					local busyFor = tick() - busySince

					if busyFor <= (getgenv().BigMomBusyMax or 60) then
						continue
					end

					getgenv().BigMomBusy = false
					local freedCount = getgenv().BigMomBusyFreed or 0
					getgenv().BigMomBusyFreed = freedCount + 1
					getgenv().BMLog(
						string.format(
							"[BigMom] busy has been held for %.0fs with nothing finishing - clearing it and carrying on (x%d). Whatever was called never returned; see the Char() note.",
							busyFor,
							getgenv().BigMomBusyFreed
						)
					)
					busySince = nil
				else
					busySince = nil
				end

				-- what is she saying
				do
					local _
					dialogueKey, _, dialogueAt = getgenv().dialogueText()
				end

				do
					local _
					dialogueKind, _, cakeOrder = getgenv().classifyDialogue(dialogueKey)
				end

				getgenv().BigMomKind = dialogueKind

				if dialogueAt then
					dialogueAt = dialogueAt.At
				end

				if dialogueAt then
					dialogueKey = dialogueAt
				end

				do
					local roomName, roomHow

					do
						local _
						roomName, _, roomHow = getgenv().currentCakeStage()
					end

					getgenv().noteRoomDepth(roomName, roomHow)
					getgenv().noteInsideRoom(roomName, roomHow, character:FindFirstChild("HumanoidRootPart"))
				end

				-- inside the dungeon
				if not getgenv().backIntoRoom(character) then
					continue
				end

				if getgenv().BacktrackRoom and dialogueKind ~= "finished" then
					local currentRoom = getgenv().currentCakeStage()

					if currentRoom ~= getgenv().BacktrackRoom then
						getgenv().BacktrackRoom = nil
					else
						if getgenv().cakeExitPart() then
							dialogueKey = getgenv().declareRoomDone(currentRoom, "backtracking")
							dialogueKind = "finished"
						else
							getgenv().BacktrackGaveUp[tostring(currentRoom)] = true
							getgenv().BacktrackRoom = nil
							local shouldLog = getgenv().BMLog and getgenv().LastNoExitSaid ~= tostring(currentRoom)

							if shouldLog then
								local lastNoExitSaid = tostring(currentRoom)
								getgenv().LastNoExitSaid = lastNoExitSaid
								getgenv().BMLog(
									string.format(
										"[Room] Room %s has no exit to walk back out of - solving it normally instead of waiting on a door that is not there.",
										tostring(currentRoom)
									)
								)
							end
						end
					end
				end

				if not getgenv().afterBossTick(character) then
					continue
				end

				-- camp rooms: kill everything, then wait for her
				local checkCamp = getgenv().CampClear ~= false

				if checkCamp then
					local backtrackFn = getgenv().backtrackingNow
					local isBacktracking = backtrackFn and getgenv().backtrackingNow()
					checkCamp = not isBacktracking
				end

				if checkCamp then
					campRoom, campRoomModel, campMobs = getgenv().campCheck()

					if campRoom then
						local campSince = getgenv().CampSince
						local seenSince = getgenv().CampSince[campRoom]
						local firstSeenAt = seenSince or tick()
						campSince[campRoom] = firstSeenAt

						if #campMobs > 0 then
							local campSeen = getgenv().CampSeen
							local seenBefore = getgenv().CampSeen[campRoom] or 0
							campSeen[campRoom] = math.max(seenBefore, #campMobs)
							getgenv().CampClearAt[campRoom] = nil

							if not getgenv().weaponInHand(character) then
								getgenv().askWeaponEquip(
									string.format("camp %s with %d up", tostring(campRoom), #campMobs)
								)
							end

							local rootPart = character:FindFirstChild("HumanoidRootPart")
							nearestMob = nil
							local nearestDist = math.huge

							for _, mob in ipairs(campMobs) do
								local mobRoot = getgenv().npcRoot(mob)

								if mobRoot and rootPart then
									local dist = (rootPart.Position - mobRoot.Position).Magnitude

									if dist < nearestDist then
										nearestMob = mob
										nearestDist = dist
									end
								end
							end

							if nearestMob then
								local roomLabel = tostring(campRoom)
								getgenv().BigMomStep = string.format(
									"camp %s - %d left, on %s (%.0f studs)%s",
									roomLabel,
									#campMobs,
									nearestMob.Name,
									nearestDist,
									tweenState.Enabled and ", chasing" or ""
								)

								if getgenv().reactionOwnsUs() then
									if tweenState.Enabled then
										pcall(stopTween)
									end

									local heldRoomLabel = tostring(campRoom)
									getgenv().BigMomStep = string.format(
										"camp %s - %s, chase held off",
										heldRoomLabel,
										tostring(getgenv().ReactingWhy or "reacting")
									)
									continue
								end

								local shouldChase = not tweenState.Enabled
									or tweenState.AtGoal and getgenv().CampChaseAlways ~= false
								local chaseActive = shouldChase and tweenState.Enabled

								if chaseActive then
									local now = tick()
									local sinceLastChase = now - (getgenv().LastCampChase or 0)
									chaseCoolingDown = sinceLastChase < (getgenv().CampChaseRefire or 1)
								else
									chaseCoolingDown = chaseActive
								end

								if chaseCoolingDown then
									shouldChase = false
								end

								if shouldChase then
									shouldChase = getgenv().CampChaseAlways ~= false

									if not shouldChase then
										shouldChase = nearestDist > (getgenv().CampReach or 18)
									end
								end

								if shouldChase then
									getgenv().LastCampChase = tick()

									if tweenState.Enabled then
										pcall(stopTween)
									end
								end
							else
								getgenv().BigMomStep = string.format(
									"camp %s - %d left, none of them reachable",
									tostring(campRoom),
									#campMobs
								)
							end

							continue
						end

						if not getgenv().CampCleared[campRoom] then
							local seenCount = getgenv().CampSeen[campRoom] or 0
							local sawMobs = seenCount > 0
							local inRoomFor = tick() - getgenv().CampSince[campRoom]
							local campGrace = getgenv().CampGrace or 25
							local neverSawMobs = not sawMobs

							if neverSawMobs then
								local bossOnlyRooms = getgenv().CampBossOnly
								waitForBoss = (bossOnlyRooms or {})[campRoom] == true
							else
								waitForBoss = neverSawMobs
							end

							if waitForBoss then
								if getgenv().bossFightDone() then
									getgenv().CampCleared[campRoom] = true
									getgenv().BigMomStep = string.format(
										"room %s - she is already beaten, heading out",
										tostring(campRoom)
									)
									continue
								end

								if (getgenv().BossAppearMax or 60) < inRoomFor then
									getgenv().noteBeaten(
										string.format(
											"she never appeared in room %s after %.0fs",
											tostring(campRoom),
											inRoomFor
										)
									)
									getgenv().CampCleared[campRoom] = true
									continue
								end

								local waitingRoomLabel = tostring(campRoom)
								getgenv().BigMomStep = string.format(
									"room %s - waiting for Big Mom to appear (%.0fs of %.0f)",
									waitingRoomLabel,
									inRoomFor,
									getgenv().BossAppearMax or 60
								)
								continue
							end

							local roomDone = getgenv().CampEmptyDone ~= false and #campMobs == 0

							if roomDone then
								local bossOnlyRooms = getgenv().CampBossOnly or {}
								roomDone = bossOnlyRooms[campRoom] ~= true
							end

							if roomDone then
								roomDone = getgenv().exitDoorSaysDone(campRoomModel) == true
							end

							local shouldLogEmpty = roomDone and getgenv().CampEmptySaid ~= campRoom and getgenv().BMLog

							if shouldLogEmpty then
								getgenv().CampEmptySaid = campRoom
								getgenv().BMLog(
									string.format(
										"[Camp] Room %s has no NPCs in it and its exit door is open - that is done, not still loading. Skipping the %.0fs grace.",
										tostring(campRoom),
										campGrace
									)
								)
							end

							if neverSawMobs and not roomDone and inRoomFor < campGrace then
								getgenv().BigMomStep = string.format(
									"camp %s - empty so far, giving it %.0fs more to load",
									tostring(campRoom),
									campGrace - inRoomFor
								)
								continue
							end

							local campClearAt = getgenv().CampClearAt
							local clearSince = getgenv().CampClearAt[campRoom] or tick()
							campClearAt[campRoom] = clearSince
							local stillSettling = not roomDone

							if stillSettling then
								local clearFor = tick() - getgenv().CampClearAt[campRoom]
								stillSettling = clearFor < (getgenv().CampClearHold or 3)
							end

							if stillSettling then
								getgenv().BigMomStep = "camp " .. tostring(campRoom) .. " - reads clear, making sure"
								continue
							end

							local campCleared = getgenv().CampCleared
							campCleared[campRoom] = true
							pcall(stopTween)
							local clearLog = getgenv().BMLog
							local clearedLabel = tostring(campRoom)
							local killed = getgenv().CampSeen[campRoom] or 0
							clearLog(
								string.format(
									"[Camp] Room %s is clear - %d killed. Heading for the exit.",
									clearedLabel,
									killed
								)
							)
						end

						if dialogueKind ~= "finished" then
							dialogueKey = getgenv().declareRoomDone(campRoom, "camp cleared")
							dialogueKind = "finished"
						end
					end
				end

				-- cake floor done?
				local checkCakeFloor = getgenv().CakeFloorDone ~= false
					and dialogueKind ~= "finished"
					and (not cakeOrder or dialogueKey == getgenv().HandledOrder)

				if checkCakeFloor then
					floorRoom, floorRoom = getgenv().currentCakeStage()
					local stageRoom = getgenv().cakeStageRoom()

					if floorRoom and stageRoom and floorRoom == stageRoom then
						local floorDone
						floorDone, cakesLeft = getgenv().cakeFloorFinished()

						if floorDone then
							dialogueKey =
								getgenv().declareRoomDone(floorRoom.Name, string.format("%d cakes left", cakesLeft))
							local shouldLogFloor = getgenv().CakeFloorSaid ~= floorRoom.Name and getgenv().BMLog

							if shouldLogFloor then
								getgenv().CakeFloorSaid = floorRoom.Name
								local floorLog = getgenv().BMLog
								local floorLabel = tostring(floorRoom.Name)
								floorLog(
									string.format(
										"[Cake] Only %d cakes left in room %s (%d or fewer means the floor is done) - heading for the door instead of waiting for another order.",
										cakesLeft,
										floorLabel,
										getgenv().CakeFloorLeft or 6
									)
								)
							end

							dialogueKind = "finished"
						else
							if getgenv().CakeFloorSaid == floorRoom.Name then
								getgenv().CakeFloorSaid = nil
							end
						end
					end
				end

				-- orb puzzle done?
				local orbSolved = getgenv().SoulOrbPuzzle ~= false
					and getgenv().OrbSolved
					and dialogueKind ~= "finished"

				if orbSolved then
					orbRoomNow, orbRoomNow = getgenv().currentCakeStage()
					local inOrbRoom = orbRoomNow and orbRoomNow == getgenv().orbRoom()

					if inOrbRoom then
						dialogueKey = getgenv().declareRoomDone(orbRoomNow.Name, "orbs solved")
						dialogueKind = "finished"
					end
				end

				if dialogueKind ~= "finished" then
					exitCheckRoom, exitCheckRoom = getgenv().currentCakeStage()
					local doorDone
					doorDone, exitDoorWhy = getgenv().exitDoorSaysDone(exitCheckRoom)

					if doorDone then
						dialogueKey = getgenv().declareRoomDone(exitCheckRoom.Name, "the exit door is lit")
						local shouldLogDoor = getgenv().ExitDoorSaid ~= exitCheckRoom.Name and getgenv().BMLog
						dialogueKind = "finished"

						if shouldLogDoor then
							getgenv().ExitDoorSaid = exitCheckRoom.Name
							getgenv().BMLog(
								string.format(
									"[Door] Room %s is finished - %s reads open, so the stage is done whatever the puzzle thinks. Heading for it.",
									tostring(exitCheckRoom.Name),
									tostring(exitDoorWhy)
								)
							)
						end
					end
				end

				-- went through a door
				local checkLeftRoom = dialogueKind == "finished"
					and getgenv().inCakeRoom()
					and getgenv().FinishedHandled ~= dialogueKey

				if checkLeftRoom then
					arrivedRoom, arrivedRoom = getgenv().currentCakeStage()

					if arrivedRoom then
						arrivedRoom = arrivedRoom.Name
					end

					if not arrivedRoom then
						arrivedRoom = nil
					end

					local leftRoom = getgenv().ExitFromRoom and arrivedRoom and arrivedRoom ~= getgenv().ExitFromRoom

					if leftRoom then
						getgenv().FinishedHandled = dialogueKey
						getgenv().BigMomStep = string.format(
							"through the door - room %s now, that dismissal is spent",
							tostring(arrivedRoom)
						)
						getgenv().BMLog(
							string.format(
								"[Exit] Left room %s and arrived in room %s - not using the same line to leave this one too.",
								tostring(getgenv().ExitFromRoom),
								tostring(arrivedRoom)
							)
						)
						getgenv().ExitFromRoom = nil
						pcall(getgenv().closeDialogue, "the dismissal is spent")
						dialogueKind = "spent"
					end
				end

				-- room done, head for the exit
				local readyToExit = dialogueKind == "finished"
					and getgenv().inCakeRoom()
					and getgenv().FinishedHandled ~= dialogueKey

				if readyToExit then
					do
						local _
						_, finishedRoom = getgenv().currentCakeStage()
					end

					if finishedRoom then
						finishedRoom = finishedRoom.Name
					end

					if not finishedRoom then
						finishedRoom = nil
					end

					if not getgenv().mayLeaveRoom(finishedRoom) then
						getgenv().BigMomStep = string.format(
							"room %s is finished - staying put, StopAtRoom is %s",
							tostring(finishedRoom),
							tostring(getgenv().StopAtRoom)
						)

						if not getgenv().StopAtRoomLogged[tostring(finishedRoom)] then
							getgenv().StopAtRoomLogged[tostring(finishedRoom)] = true
							getgenv().BMLog(
								string.format(
									"[Exit] Room %s is done and she has dismissed us, but StopAtRoom is %s - NOT going through the door. Set getgenv().StopAtRoom = false to carry on.",
									tostring(finishedRoom),
									tostring(getgenv().StopAtRoom)
								)
							)
						end
					else
						getgenv().ExitFromRoom = finishedRoom
						exitPart, exitLabel = getgenv().cakeExitPart()
						local exitSpot = getgenv().standAtPart(exitPart)

						if not exitSpot then
							if exitLabel then
								exitLabel = "waiting - " .. tostring(exitLabel)
							end

							getgenv().BigMomStep = exitLabel or "she is done, but the exit door is not in the room yet"
						else
							local exitRoot = character:FindFirstChild("HumanoidRootPart")
							local exitDist = exitRoot and (exitRoot.Position - exitSpot.Position).Magnitude or math.huge
							local approachCF = exitRoot
									and getgenv().exitApproachCF(exitPart, exitSpot, exitRoot.Position)
								or exitSpot
							local insideExit = exitRoot and getgenv().insidePart(exitPart, exitRoot.Position)

							if insideExit then
								getgenv().BigMomStep = "standing in "
									.. tostring(exitLabel or "the exit")
									.. ", waiting to be taken out"

								if getgenv().knockPortal(exitPart, exitSpot, tostring(exitLabel or "the exit")) then
									local noteSeat = getgenv().noteExitSeat

									if not exitLabel then
										exitLabel = "the exit"
									end

									noteSeat(tostring(exitLabel), finishedRoom)
								end
							else
								if (getgenv().ExitSeatFrom or 22) < exitDist then
									getgenv().BigMomStep = string.format(
										"she is done - heading for %s (%.0f studs, stopping in front of it)",
										tostring(exitLabel or "the exit"),
										exitDist
									)
									getgenv().clearPortalKnock()
									getgenv().BigMomBusy = true
									local goTo = getgenv().goTo

									if not exitLabel then
										exitLabel = "the exit"
									end

									pcall(
										goTo,
										approachCF,
										"the floor in front of " .. tostring(exitLabel),
										getgenv().ExitReachDist
									)
									getgenv().BigMomBusy = false
								else
									if exitRoot then
										local seatsSoFar = getgenv().ExitSeats
										getgenv().ExitSeats = (seatsSoFar or 0) + 1
										getgenv().BigMomStep = string.format(
											"%.1f studs from %s but not inside it - seating onto it",
											exitDist,
											tostring(exitLabel or "the exit")
										)

										if
											not getgenv().noteExitSeat(tostring(exitLabel or "the exit"), finishedRoom)
										then
											if
												not getgenv().knockPortal(
													exitPart,
													exitSpot,
													tostring(exitLabel or "the exit")
												)
											then
												getgenv().stepTo(
													exitRoot,
													exitSpot.Position,
													tostring(exitLabel or "the exit")
												)
												local shouldLogSeat = getgenv().BMLog

												if shouldLogSeat then
													shouldLogSeat = (getgenv().ExitSeats or 0) % 5 == 1
												end

												if shouldLogSeat then
													local seatLog = getgenv().BMLog

													if not exitLabel then
														exitLabel = "the exit"
													end

													local seatLabel = tostring(exitLabel)
													seatLog(
														string.format(
															"[Exit] Stopped %.1f studs from '%s' without entering it - re-seating onto the trigger (x%d).",
															exitDist,
															seatLabel,
															getgenv().ExitSeats
														)
													)
												end
											end
										end
									else
										getgenv().BigMomStep = "at the exit, waiting to be taken out"
									end
								end
							end
						end
					end
					continue
				end

				local noPendingOrder = not cakeOrder or dialogueKey == getgenv().HandledOrder

				if noPendingOrder then
					do
						local backtracking
						backtracking, backtrackingRoom, backtrackFrom, deepestRoom = getgenv().backtrackingNow()

						if backtracking then
							local backtrackSince = getgenv().BacktrackSince
							local backtrackStart = getgenv().BacktrackSince[backtrackingRoom] or tick()
							backtrackSince[backtrackingRoom] = backtrackStart
							local backtrackFor = tick() - getgenv().BacktrackSince[backtrackingRoom]

							if backtrackFor < (getgenv().BacktrackGiveUp or 45) then
								getgenv().BacktrackRoom = backtrackingRoom
								getgenv().BigMomStep = string.format(
									"passing back through room %d to get to room %d (%.0fs)",
									backtrackFrom,
									deepestRoom,
									backtrackFor
								)
								local shouldLogBacktrack = getgenv().BMLog
									and getgenv().LastBacktrackSaid ~= backtrackingRoom

								if shouldLogBacktrack then
									getgenv().LastBacktrackSaid = backtrackingRoom
									getgenv().BMLog(
										string.format(
											"[Room] Room %d is already finished and we had reached room %d - taking its exit rather than re-solving it. Dying keeps the floors before the one you died on.",
											backtrackFrom,
											deepestRoom
										)
									)
								end

								continue
							end

							getgenv().BacktrackGaveUp[backtrackingRoom] = true
							getgenv().BacktrackRoom = nil
							getgenv().BMLog(
								string.format(
									"[Room] %.0fs trying to walk back out of room %d and it has not let us through - treating it as a floor that must be redone, and solving it normally.",
									backtrackFor,
									backtrackFrom
								)
							)
						end
					end

					if getgenv().BookPuzzle ~= false then
						do
							local _dist, _books, _near
							matchedBook, _dist, _books, _near, bookRoom = getgenv().bookMatch()
						end

						if matchedBook then
							local bookSpot = getgenv().bookTouchPart(matchedBook)

							if bookSpot then
								bookSpot = getgenv().standAtPart(bookSpot)
							end

							local bookRoot = character:FindFirstChild("HumanoidRootPart")

							if bookSpot and bookRoot then
								local bookDist = (bookRoot.Position - bookSpot.Position).Magnitude

								if bookDist > (getgenv().BookReachDist or 6) then
									if bookRoom then
										bookRoom = bookRoom.Name
									end

									if not bookRoom then
										bookRoom = "?"
									end

									getgenv().BigMomStep = string.format(
										"book puzzle in %s - walking to the %s book",
										tostring(bookRoom),
										tostring(matchedBook.Name)
									)
									getgenv().BigMomBusy = true
									pcall(
										getgenv().goTo,
										bookSpot,
										"the matching book '" .. tostring(matchedBook.Name) .. "'",
										getgenv().BookReachDist
									)
									getgenv().BigMomBusy = false
								else
									getgenv().BigMomStep = "standing on '" .. tostring(matchedBook.Name) .. "'"
								end

								continue
							end
						end
					end

					-- waiting for an order / at the gate
					if getgenv().inCakeRoom() then
						if 0 < (getgenv().DoorSeats or 0) then
							getgenv().DoorSeats = 0
						end

						getgenv().DoorBackoffAt = 0

						if cakeOrder then
							cakeOrder = "in the room, waiting for the next order"
						end

						getgenv().BigMomStep = cakeOrder or "in the room, waiting for an order"
					else
						gateCF, startGateLabel = getgenv().bigMomStartAt()
						local doorPart = getgenv().chateauDoorPart()
						local gateRoot = character:FindFirstChild("HumanoidRootPart")
						local doorReachDist = getgenv().DoorReachDist or 3
						local doorOpen
						doorOpen, doorWhy = getgenv().chateauDoorOpen()

						if doorOpen == false then
							getgenv().clearPortalKnock()
							getgenv().DoorSeats = 0
							local now = tick()
							local sinceMochiDied = now - (getgenv().MochiKilledAt or 0)
							local waitForReopen = (getgenv().MochiKilledAt or 0) > 0

							if waitForReopen then
								waitForReopen = sinceMochiDied <= (getgenv().MochiDeadHold or 600)
							end

							if waitForReopen then
								waitForReopen = not getgenv().mochiEmperor()
							end

							local gateStep = waitForReopen
								and string.format(
									"at the gate - it is shut, waiting for it to reopen (%s died %.0fs ago)",
									tostring(getgenv().MochiName),
									sinceMochiDied
								)
							getgenv().BigMomStep = gateStep
								or "the Cake Chateau door is shut - the farm is finished, not knocking"
							local shouldLogShut = getgenv().BMLog

							if shouldLogShut then
								local nowShut = tick()
								local lastShutLog = getgenv().DoorWaitSaid
								shouldLogShut = nowShut - (lastShutLog or 0) >= 20
							end

							if shouldLogShut then
								getgenv().DoorWaitSaid = tick()
								local shutLog = getgenv().BMLog

								if waitForReopen then
									waitForReopen = string.format(
										"[Door] %s is SHUT (%s), but %s died %.0fs ago - this is the gate not having reopened for the next run, so waiting here.",
										tostring(startGateLabel),
										tostring(doorWhy),
										tostring(getgenv().MochiName),
										sinceMochiDied
									)
								end

								if not waitForReopen then
									waitForReopen = string.format(
										"[Door] %s is SHUT (%s) - that means the Big Mom farm is finished, so there is nothing to knock on.",
										tostring(startGateLabel),
										tostring(doorWhy)
									)
								end

								shutLog(waitForReopen)
							end
						else
							do
								local dungeonReady
								dungeonReady, dungeonWhy = getgenv().dungeonLoaded()

								if not dungeonReady then
									local shouldLogDungeon = getgenv().BMLog

									if shouldLogDungeon then
										local nowDungeon = tick()
										local lastDungeonLog = getgenv().DoorWaitSaid
										shouldLogDungeon = nowDungeon - (lastDungeonLog or 0) >= 15
									end

									if shouldLogDungeon then
										getgenv().DoorWaitSaid = tick()
										local dungeonLog = getgenv().BMLog
										dungeonLog(
											string.format(
												"[Door] %s - that is expected out here, the rooms only load once the gate takes us in. Going to %s anyway.",
												tostring(dungeonWhy),
												tostring(startGateLabel)
											)
										)
									end

									if getgenv().DungeonWaitBlocks == true then
										getgenv().clearPortalKnock()
										getgenv().DoorSeats = 0
										getgenv().BigMomStep = "waiting for the dungeon to come back ("
											.. tostring(dungeonWhy)
											.. ")"
										continue
									end
								end
							end

							local nowGate = tick()
							local sinceBackoff = nowGate - (getgenv().DoorBackoffAt or 0)
							local doorRetryAfter = getgenv().DoorRetryAfter or 20

							if sinceBackoff < doorRetryAfter then
								getgenv().clearPortalKnock()
								local gateLabel = tostring(startGateLabel)
								local retryAfter = getgenv().DoorRetryAfter or 20
								local nowBackoff = tick()
								getgenv().BigMomStep = string.format(
									"backing off %s for %.0fs - it was not taking us",
									gateLabel,
									retryAfter - (nowBackoff - (getgenv().DoorBackoffAt or 0))
								)
							else
								local seatCount = getgenv().DoorSeats or 0
								local doorSeatMax = getgenv().DoorSeatMax or 20

								if doorSeatMax <= seatCount then
									getgenv().DoorSeats = 0
									getgenv().DoorBackoffAt = tick()
									getgenv().clearPortalKnock()

									if getgenv().BMLog then
										local backoffLog = getgenv().BMLog
										backoffLog(
											string.format(
												"[Door] %d seats on %s and it has not taken us - standing off it for %ds instead of hammering.",
												getgenv().DoorSeatMax or 20,
												tostring(startGateLabel),
												getgenv().DoorRetryAfter or 20
											)
										)
									end
								else
									local gateDist = gateRoot and (gateRoot.Position - gateCF.Position).Magnitude
										or math.huge
									local insideGate = gateRoot
										and doorPart
										and getgenv().insidePart(doorPart, gateRoot.Position)

									if insideGate then
										getgenv().BigMomStep = "standing in "
											.. tostring(startGateLabel)
											.. ", waiting to be taken in"
										getgenv().knockPortal(doorPart, gateCF, tostring(startGateLabel))
									else
										if doorReachDist < gateDist then
											getgenv().BigMomStep = "heading to " .. tostring(startGateLabel)
											getgenv().clearPortalKnock()
											getgenv().BigMomBusy = true
											pcall(getgenv().goTo, gateCF, startGateLabel, doorReachDist)
											getgenv().BigMomBusy = false
											gateRoot = character:FindFirstChild("HumanoidRootPart")
											gateDist = gateRoot and (gateRoot.Position - gateCF.Position).Magnitude
												or math.huge
										end

										if gateRoot and gateDist <= doorReachDist then
											local seatsBefore = getgenv().DoorSeats
											getgenv().DoorSeats = (seatsBefore or 0) + 1
											getgenv().BigMomStep = string.format(
												"%.1f studs from %s - snapping onto it",
												gateDist,
												tostring(startGateLabel)
											)
											local knocked = doorPart
												and getgenv().knockPortal(doorPart, gateCF, tostring(startGateLabel))

											if knocked then
												continue
											end

											getgenv().stepTo(gateRoot, gateCF.Position, tostring(startGateLabel))
											local shouldLogSnap = getgenv().BMLog

											if shouldLogSnap then
												local seatsNow = getgenv().DoorSeats or 0
												shouldLogSnap = seatsNow % 5 == 1
											end

											if shouldLogSnap then
												local snapLog = getgenv().BMLog
												-- broken in the dump: the message never got passed, so this logs nothing
												-- ("[Door] Within %d studs of '%s' - snapping straight onto the trigger so it definitely touches (x%d).")
												snapLog()
											end
										else
											getgenv().BigMomStep = "on the start point, waiting for the portal"
										end
									end
								end
							end
						end
					end
					continue
				end

				-- deliver the cake
				getgenv().BigMomBusy = true
				deliverRan, delivered, deliveredCount, deliverWhy = pcall(getgenv().deliverCake, cakeOrder)
				getgenv().BigMomBusy = false

				if deliverRan and delivered then
					getgenv().HandledOrder = dialogueKey
					getgenv().BigMomStep = string.format(
						"delivered %d x %s - waiting for the next order",
						tonumber(deliveredCount) or 0,
						tostring(cakeOrder)
					)
					continue
				end

				if deliverRan then
					if not deliverWhy then
						deliverWhy = "nothing delivered"
					end
				else
					deliverWhy = deliverRan
				end

				if deliverWhy then
					delivered = deliverWhy
				end

				getgenv().BigMomStep = "delivery stopped: " .. tostring(delivered)
				getgenv().BMLog("[Cake] " .. getgenv().BigMomStep)
				task.wait(1)
			end
		end)

		-- --------------------------------------------------------------------
		-- 3.43 Big Mom / diagnostics
		-- --------------------------------------------------------------------

		getgenv().BigMomFPS = function(enabled)
			local delay = tonumber(enabled) or 6

			local function log(key)
				pcall(function()
					getgenv().BigMomPrint(key)
				end)
			end

			local frames = 0
			local slowFrames = 0
			local worstMs = 0
			local worstAt = 0
			local buckets = {}
			local worst = {}
			local bucketNames = { "under 12ms", "12-17ms", "17-25ms", "25-50ms", "over 50ms" }
			local heartbeat = RunService.Heartbeat

			local conn = heartbeat.Connect(heartbeat, function(dt)
				frames += 1
				slowFrames += dt
			end)
			log(string.format("[FPS] sampling %.0fs...", delay))
			task.wait(delay)
			conn:Disconnect()

			if frames == 0 then
				log("[FPS] no frames sampled")
				return
			end

			local lines = {
				string.format(
					"[FPS] %.1f fps over %.0fs | avg frame %.2f ms | WORST %.1f ms at %.1fs",
					frames / slowFrames,
					slowFrames,
					slowFrames / frames * 1000,
					worstMs,
					worstAt
				),
			}

			for _, bucketName in ipairs(bucketNames) do
				if buckets[bucketName] then
					lines[#lines + 1] = string.format(
						"   %-10s %5d frames (%2.0f%%)",
						bucketName,
						buckets[bucketName],
						buckets[bucketName] / frames * 100
					)
				end
			end

			local idx = #lines + 1
			lines[idx] = "   spikes over 25ms: " .. (#worst > 0 and table.concat(worst, ", ") or "none")
			local npcs = Workspace:FindFirstChild("NPCs")
			local effects = Workspace:FindFirstChild("Effects")
			local cakeFolders = getgenv().cakeFolders and getgenv().cakeFolders() or {}
			local count = 0

			for _, cakeFolder in ipairs(cakeFolders) do
				count += #cakeFolder:GetChildren()
			end

			lines[#lines + 1] = string.format(
				"   gen %s | step '%s' | busy %s | tween %s | stage %s",
				tostring(getgenv().BM_Gen),
				tostring(getgenv().BigMomStep),
				tostring(getgenv().BigMomBusy),
				tostring(tweenState.Enabled),
				tostring(getgenv().currentStageName)
			)
			lines[#lines + 1] = string.format(
				"   NPCs %d | Effects %d | cakes in the room %d | skywalk %s every %.2fs",
				npcs and #npcs:GetChildren() or 0,
				effects and #effects:GetChildren() or 0,
				count,
				tostring(getgenv().SkyWalkKeepAlive ~= false),
				getgenv().SkyWalkRate or 0.1
			)

			if not tweenState.Enabled then
				local character = localPlayer.Character

				if character then
					local upperTorso = character:FindFirstChild("UpperTorso")
						or character:FindFirstChild("Torso")
						or character:FindFirstChild("HumanoidRootPart")
					character = upperTorso
				end

				if character and not character.CanCollide then
					local printOk = pcall(function()
						local character = character
						character.CanCollide = true
					end)
					task.wait(0.15)

					if printOk and not character.CanCollide then
						lines[#lines + 1] =
							"   LEAK: something is still forcing CanCollide off with no tween running - that is a stranded noclip loop from an older execution. Rejoin to clear it."
					end
				end
			end

			local report = table.concat(lines, "\n")
			log(report)
			return report
		end

		-- report on why the farm is doing what it is doing right now
		local function bigMomWhy()
			local character = localPlayer.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
			local lineText, lineSource = getgenv().dialogueText()
			local lines = {}
			local stepLine = "[BigMom] step: "
				.. tostring(getgenv().BigMomStep)
				.. " | status: "
