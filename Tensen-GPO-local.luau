		-- true when the Chateau door VFX are lit (open), with a reason and counts; nil when not loaded
		getgenv().chateauDoorOpen = function()
			local door = getgenv().ChateauDoorNode()

			if not door then
				return nil, "the Chateau door is not loaded", 0, 0
			end

			local vfx = door:FindFirstChild("VFX") or door
			local count = 0
			local beamCount = 0
			local liveBeamCount = 0
			local liveBeams = 0

			pcall(function()
				for _, descendant in ipairs(vfx:GetDescendants()) do
					local isParticleEmitter = descendant:IsA("ParticleEmitter")
					local isBeam = descendant:IsA("Beam")

					if not (isParticleEmitter or isBeam) then
						continue
					end

					local enabled = true

					pcall(function()
						enabled = descendant.Enabled
					end)

					if isParticleEmitter then
						beamCount += 1

						if enabled ~= false then
							count += 1
						end
					else
						liveBeams += 1

						if enabled ~= false then
							liveBeamCount += 1
						end
					end
				end
			end)

			local liveTotal = count + liveBeamCount
			local total = beamCount + liveBeams

			if liveTotal > 0 then
				return true,
					string.format(
						"%d of %d door VFX are live (%d/%d emitters, %d/%d beams)",
						liveTotal,
						total,
						count,
						beamCount,
						liveBeamCount,
						liveBeams
					),
					liveTotal,
					total
			end

			if beamCount == 0 then
				return nil,
					string.format(
						"no emitters under the door to read yet (%d beams present) - still streaming in",
						liveBeams
					),
					0,
					total
			end

			return false, string.format("all %d emitters are dark (%d beams present)", beamCount, liveBeams), 0, total
		end

