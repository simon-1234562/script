			local remaining = distToTarget()

			if remaining <= promptSnapMax then
				snapTo()
				return true, remaining
			end

			if getgenv().PromptWalkLog ~= false and getgenv().BMLog then
				getgenv().BMLog(
					string.format(
						"[Prompt] Walked and still %d studs from %s - NOT teleporting the rest, the caller will retry.",
						math.floor(remaining),
						tostring(label or "the prompt")
					)
				)
			end

			return false, remaining
		end

