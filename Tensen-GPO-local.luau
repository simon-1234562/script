		-- walks to cfg.CFrame with tweenToCFrame, retrying up to `tries` times; returns whether it got within
		-- reachDist
		getgenv().TweenToCFrameSafe = function(cfg, reachDist, tries)
			cfg = cfg or {}
			local cframe = cfg.CFrame

			if not cframe then
				return false, math.huge
			end

			reachDist = reachDist or 10
			tries = tries or 3
			local offset = cfg.Offset or Vector3.zero

			-- distance from us to the tween goal (math.huge without a root)
			local function distToGoal()
				local root = startRoot
					or localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")

				if not root or not root.Parent then
					return math.huge
				end

				return (root.Position - (cframe.Position + offset)).Magnitude
			end

			for i = 1, tries do
				if not getgenv().EnableBigMom then
					break
				end

				local dist = distToGoal()

				if dist <= reachDist then
					return true, dist
				end

				stopTween()
				local now = tick()

				while tweenState.Enabled and tick() - now < 2 do
					task.wait()
				end

				tweenToCFrame(cfg)

				if tweenState.Enabled then
					repeat
						task.wait()
					until not (tweenState.Enabled and getgenv().EnableBigMom)
				else
					task.wait(0.5)
				end

				stopTween()
				local remaining = distToGoal()

				if remaining <= reachDist then
					return true, remaining
				end

				noopLog(
					string.format(
						"[Tween] Walk %d/%d ended %d studs short of the goal - walking again (no teleport).",
						i,
						tries,
						math.floor(remaining)
					)
				)
				task.wait(0.25)
			end

			local dist = distToGoal()
			return dist <= reachDist, dist
		end

		getgenv().PromptSnapMax = getgenv().PromptSnapMax or 5
