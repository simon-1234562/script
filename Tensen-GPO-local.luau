						string.format(
							"[Water] WalkOnWater with no ocean part to stand on - holding the tween on %s at Y %.2f.",
							tostring(surfaceName),
							holdY
						)
					)
				end

				return true
			end

			local connection = nil
			local parts = {}

			-- puts back the CanCollide values noclip changed
			local function restoreCollisions()
				for k, part in pairs(parts) do
					if part and k and k.Parent then
						pcall(function()
							k.CanCollide = true
						end)
					end
				end

				parts = {}
			end

			-- true when noclip should pause for this character (dead, seated, ragdolled, ...)
			local function noclipSuspended(instance)
				local humanoid = instance and instance:FindFirstChildOfClass("Humanoid")

				if not humanoid then
					return true
				end

				if humanoid.Health <= 0 then
					return true
				end

				if not humanoid.PlatformStand then
					return true
				end

				local ok, result = pcall(function()
					return humanoid:GetState()
				end)

				if ok and fallStates[result] then
					return true
				end

				if instance:GetAttribute("Ragdoll") == true then
					return true
				end

				if instance:FindFirstChild("Ragdoll") then
					return true
				end

				return false
			end

			getgenv().noclipSuspended = noclipSuspended

			-- true when the character is stunned, ragdolled or knocked down
			isCharacterDowned = function(instance)
				instance = instance or localPlayer.Character

				if not instance then
					return true
				end

				if getgenv().IsStunnedOverride == true then
					return true
				end

				if instance:FindFirstChild("Stun") then
					return true
				end

				local function getAttribute()
					return instance:GetAttribute("Stun")
				end

				local attrOk, attrValue = pcall(getAttribute)

				if attrOk and attrValue == true then
					return true
				end

				if instance:GetAttribute("Ragdoll") == true then
					return true
				end

				if instance:FindFirstChild("Ragdoll") then
					return true
				end

				local humanoid = instance:FindFirstChildOfClass("Humanoid")

				if not humanoid then
					return true
				end

				if humanoid.Health <= 0 then
					return true
				end

				local zeroSpeedStun = getgenv().StunOnZeroWalkSpeed ~= false and humanoid.WalkSpeed == 0

				if zeroSpeedStun then
					return true
				end

				local function getState()
					return humanoid:GetState()
				end

				local ok, result = pcall(getState)

				if ok and fallStates[result] then
					return true
				end

				return false
			end

			getgenv().isCharacterDowned = isCharacterDowned
			getgenv().isStunned = isCharacterDowned
			getgenv().AutoRemoveStun = getgenv().AutoRemoveStun ~= false
			getgenv().RestoreWalkSpeedOnStun = getgenv().RestoreWalkSpeedOnStun ~= false
			getgenv().AllowStun = false

			task.spawn(function()
				local walkSpeed = 16

				-- true when stuns must be left alone (AutoRemoveStun off or AllowStun on)
				local function stunRemovalSuppressed()
					if getgenv().AutoRemoveStun == false then
						return true
					end

					if getgenv().AllowStun == true then
						return true
					end

					return false
				end

				getgenv().stunRemovalSuppressed = stunRemovalSuppressed

				-- removes a Stun child as soon as it is added to the character
				local function onChildAdded(child)
					if not child or child.Name ~= "Stun" then
						return
					end

					if bmStale() or not getgenv().EnableBigMom then
						return
					end

					if stunRemovalSuppressed() then
						return
					end

					pcall(function()
						child:Destroy()
					end)
				end

				-- watches a character so new Stun children get removed
				local function watchStunChildren(instance)
					if not instance then
						return
					end

					for _, child in ipairs(instance:GetChildren()) do
						onChildAdded(child)
					end

					instance.ChildAdded:Connect(onChildAdded)
				end

				watchStunChildren(localPlayer)
				watchStunChildren(localPlayer.Character)
				local characterAdded = localPlayer.CharacterAdded

				characterAdded.Connect(characterAdded, function(newCharacter)
					walkSpeed = 16
					watchStunChildren(newCharacter)
				end)

				while task.wait(0.1) do
					if bmStale() then
						break
					end

					if stunRemovalSuppressed() then
						continue
					end

					local character = localPlayer.Character

					if not character then
						continue
					end

					local stun = character:FindFirstChild("Stun") or localPlayer:FindFirstChild("Stun")

					if stun then
						pcall(function()
							stun:Destroy()
						end)
					end

					local function getAttribute()
						return character:GetAttribute("Stun")
					end

					local ok, result = pcall(getAttribute)

					if ok and result == true then
						pcall(function()
							character:SetAttribute("Stun", false)
						end)
					end

					if not getgenv().RestoreWalkSpeedOnStun then
						continue
					end

					local humanoid = character:FindFirstChildOfClass("Humanoid")

					if humanoid and humanoid.Health > 0 then
						if 0 < humanoid.WalkSpeed then
							walkSpeed = humanoid.WalkSpeed
						else
							pcall(function()
								humanoid.WalkSpeed = walkSpeed
							end)
						end
					end
				end
			end)

			-- turns noclip on or off for the local character
			setNoclip = function(enabled)
				if enabled then
					if connection then
						return
					end

					connection = RunService.Stepped:Connect(function()
						if bmStale() then
							restoreCollisions()

							if connection then
								connection:Disconnect()
								connection = nil
							end

							return
						end

						local character = localPlayer.Character

						if not character then
							return
						end

						if noclipSuspended(character) then
							restoreCollisions()
							return
						end

						local iterFn, iterState, iterStart = ipairs(character:GetDescendants())

						for _, part in iterFn, iterState, iterStart do
							if part:IsA("BasePart") and part.CanCollide then
								if parts[part] == nil then
									parts[part] = true
								end

								part.CanCollide = false
							end
						end
					end)
					return
				end

				if connection then
					connection:Disconnect()
					connection = nil
				end

				restoreCollisions()
			end

			getgenv().BarriersBlockSpots = getgenv().BarriersBlockSpots ~= false
		end

		-- --------------------------------------------------------------------
		-- 3.7 Big Mom / chase landing, walls and lure spots
		-- --------------------------------------------------------------------

		local function spotBlocked(point, filterDescendantsInstances, ignoreCharacters)
			if not point then
				return false
			end

			local blocked = false

			pcall(function()
				local overlapParams = OverlapParams.new()
				overlapParams.FilterType = Enum.RaycastFilterType.Exclude
				overlapParams.FilterDescendantsInstances = filterDescendantsInstances or {}
				overlapParams.MaxParts = getgenv().SpotBlockedMaxParts or 12

				for _, part in ipairs(Workspace:GetPartBoundsInRadius(point, 2.6, overlapParams)) do
					local isCharacterPart = false

					if ignoreCharacters then
						local parent = part.Parent
						isCharacterPart = parent ~= nil
							and (
								parent:FindFirstChildOfClass("Humanoid") ~= nil
								or parent.Parent ~= nil and parent.Parent:FindFirstChildOfClass("Humanoid") ~= nil
							)
					end

					if not isCharacterPart and part.CanCollide and part.Transparency < 1 then
						blocked = true
						break
					end

					if
						getgenv().BarriersBlockSpots ~= false
						and getgenv().isBarrierPart
						and getgenv().isBarrierPart(part)
					then
						blocked = true
						break
					end
				end
			end)

			return blocked
		end

		-- raises a point until it is no longer inside something (at most maxRise studs)
		local function getVector(vector, ignoreList, maxRise, ignoreCharacters)
			if not vector then
				return vector
			end

			maxRise = maxRise or 30
			local rise = 0
			local spot = vector

			while rise < maxRise and spotBlocked(spot, ignoreList, ignoreCharacters) do
				spot += Vector3.new(0, 3, 0)
				rise += 3
			end

			if spotBlocked(spot, ignoreList, ignoreCharacters) then
				return vector
			end

			return spot
		end

		getgenv().ChaseLandLower = getgenv().ChaseLandLower ~= false
		getgenv().ChaseLandStep = getgenv().ChaseLandStep or 2
		getgenv().ChaseLandFloor = getgenv().ChaseLandFloor or 1
		getgenv().ChaseLandLog = getgenv().ChaseLandLog ~= false
		getgenv().ChaseStuckInside = getgenv().ChaseStuckInside ~= false
		getgenv().ChaseStuckOffset = getgenv().ChaseStuckOffset or Vector3.new(0, 0, 0)
		getgenv().ChaseStuckKeepY = getgenv().ChaseStuckKeepY ~= false
		getgenv().ChaseStuckLog = getgenv().ChaseStuckLog ~= false
		getgenv().ChaseStuckFixes = getgenv().ChaseStuckFixes or 0

		-- a safe landing point under floorPos when it is lower than where we are, and the drop
		getgenv().chaseLandingBelow = function(floorPos, fromPos, ignoreList, ignoreCharacters)
			if getgenv().ChaseLandLower == false then
				return nil
			end

			if not (floorPos and fromPos) then
				return nil
			end

			local step = math.max(getgenv().ChaseLandStep or 2, 0.5)
			local minY = floorPos.Y + (getgenv().ChaseLandFloor or 1)
			local y = fromPos.Y - step

			while minY <= y do
				local vector = Vector3.new(fromPos.X, y, fromPos.Z)

				if not spotBlocked(vector, ignoreList, ignoreCharacters) then
					return vector, fromPos.Y - y
				end

				y -= step
			end

			return nil
		end

		getgenv().ArrowScanRate = getgenv().ArrowScanRate or 0.1
		getgenv().ArrowAvoidDist = getgenv().ArrowAvoidDist or 20
		getgenv().ArrowPushback = getgenv().ArrowPushback or 30
		local arrowCache = { at = 0, vec = Vector3.zero }

		-- broken in the dump: the arrow positions are never read, so this is always a zero vector.
		-- It still runs the boss-effect check on arrow/pillar effects (cached for ArrowScanRate seconds).
		local function arrowAvoidanceFor(_position)
			local now = tick()
			local fresh = now - (arrowCache.at or 0) < (getgenv().ArrowScanRate or 0.1)

			if fresh then
				return arrowCache.vec
			end

			arrowCache.at = now
			local effects = Workspace:FindFirstChild("Effects")

			if not effects then
				arrowCache.vec = Vector3.zero
				return arrowCache.vec
			end

			for _, child in ipairs(effects:GetChildren()) do
				local name = string.lower(child.Name)

				if string.find(name, "arrow", 1, true) or string.find(name, "pillar", 1, true) then
					getgenv().effectFromBoss(child)
				end
			end

			arrowCache.vec = Vector3.zero
			return Vector3.zero
		end

		getgenv().arrowAvoidanceFor = arrowAvoidanceFor

		getgenv().WallMovesKaidoOnly = getgenv().WallMovesKaidoOnly ~= false

		-- true when the wall checks apply to this NPC (Kaido only unless WallMovesKaidoOnly is off)
		getgenv().wallMoveAllowed = function(npc)
			if getgenv().WallMovesKaidoOnly == false then
				return true
			end

			if not (npc and getgenv().isKaidoNPC) then
				return false
			end

			return getgenv().isKaidoNPC(npc) and true or false
		end

		getgenv().ChaseWallGuard = getgenv().ChaseWallGuard ~= false
		getgenv().ChaseWallPad = getgenv().ChaseWallPad or 4
		getgenv().ChaseWallSamples = getgenv().ChaseWallSamples or 12
		getgenv().ChaseWallShrink = getgenv().ChaseWallShrink or { 1, 0.7, 0.45 }
		getgenv().ChaseWallStandoff = getgenv().ChaseWallStandoff or 18

		getgenv().ChaseWallMinStep = getgenv().ChaseWallMinStep or 6

		getgenv().ChaseWallLog = getgenv().ChaseWallLog ~= false
		getgenv().ChaseWallLogRate = getgenv().ChaseWallLogRate or 2

		-- true when the straight line from -> goal is clear enough to tween along
		getgenv().chaseGoalClear = function(from, goal, ignoreList)
			if not from or not goal then
				return true
			end

			if spotBlocked(goal, ignoreList) then
				return false
			end

			local offset = goal - from

			if offset.Magnitude < 0.05 then
				return true
			end

			local raycastParams = RaycastParams.new()
			raycastParams.FilterType = Enum.RaycastFilterType.Exclude
			local filterDescendantsInstances = {}
			ignoreList = ignoreList or {}

			for _, part in ipairs(ignoreList) do
				if part then
					table.insert(filterDescendantsInstances, part)
				end
			end

			raycastParams.FilterDescendantsInstances = filterDescendantsInstances
			local chaseWallPad = getgenv().ChaseWallPad or 4

			for i = 1, 6 do
				local hit = Workspace:Raycast(from, offset, raycastParams)

				if not hit or not hit.Instance then
					return true
				end

				if not getgenv().isBarrierPart(hit.Instance) then
					return (hit.Position - goal).Magnitude <= chaseWallPad
				end

				table.insert(filterDescendantsInstances, hit.Instance)
				raycastParams.FilterDescendantsInstances = filterDescendantsInstances
			end

			return true
		end

		getgenv().ChaseWallRate = getgenv().ChaseWallRate or 0.15
		getgenv().ChaseWallCache = getgenv().ChaseWallCache or {}

		-- when the spot behind the boss is inside a wall, picks an open point around him instead
		getgenv().PickOpenChaseGoal = function(boss, goal, ignoreList, instance)
			if getgenv().ChaseWallGuard == false then
				return goal
			end

			if not (boss and boss.Parent) or not goal then
				return goal
			end

			local position = boss.Position
			local chaseWallCache = getgenv().ChaseWallCache
			local now = tick()
			local cacheValid = chaseWallCache.boss == boss

			if cacheValid then
				local elapsed = now - (chaseWallCache.at or 0)

				cacheValid = elapsed < (getgenv().ChaseWallRate or 0.15)
			end

			if cacheValid then
				if chaseWallCache.offset == nil then
					return goal
				end

				return Vector3.new(position.X + chaseWallCache.offset.X, goal.Y, position.Z + chaseWallCache.offset.Z)
			end

			chaseWallCache.boss = boss
			chaseWallCache.at = now
			chaseWallCache.offset = nil

			if getgenv().chaseGoalClear(position, goal, ignoreList) then
				return goal
			end

			if not instance then
				instance = localPlayer.Character

				if instance then
					instance = instance:FindFirstChild("HumanoidRootPart")
				end

				instance = instance and instance.Position or goal
			end

			local vector = Vector3.new(goal.X - position.X, 0, goal.Z - position.Z)
			local radius = math.max(vector.Magnitude, 1)
			local baseAngle = vector.Magnitude > 0.01 and math.atan2(vector.Z, vector.X) or 0

			local samples = math.max(getgenv().ChaseWallSamples or 12, 4)
			local angleStep = 6.283185307179586 / samples
			local bestDist = math.huge
			local chaseWallShrink = getgenv().ChaseWallShrink or { 1, 0.7, 0.45 }
			local bestPoint = nil

			for _, shrink in ipairs(chaseWallShrink) do
				local dist = radius * shrink

				for i = 1, samples do
					local angleOffset = math.ceil(i / 2) * angleStep
					local angle = baseAngle + (i % 2 == 0 and angleOffset or -angleOffset)
					local y = goal.Y
					local z = position.Z
					local candidate = Vector3.new(position.X + math.cos(angle) * dist, y, z + math.sin(angle) * dist)

					if getgenv().chaseGoalClear(position, candidate, ignoreList) then
						local magnitude = (candidate - instance).Magnitude

						if magnitude < bestDist then
							bestDist = magnitude
							bestPoint = candidate
						end
					end
				end

				if bestPoint then
					break
				end
			end

			if not bestPoint then
				local _, openings = getgenv().bossWallScan(position, ignoreList)
				openings = openings and openings[1]

				if openings and openings.open > (getgenv().ChaseWallPad or 4) then
					local pullDist = math.min(
						math.max(radius, getgenv().ChaseWallStandoff or 18),
						openings.open - (getgenv().ChaseWallPad or 4)
					)

					if pullDist > 1 then
						bestPoint = Vector3.new(
							position.X + openings.dir.X * pullDist,
							goal.Y,
							position.Z + openings.dir.Z * pullDist
						)
					end
				end
			end

			if not bestPoint then
				return goal
			end

			local magnitude = (bestPoint - goal).Magnitude

			if magnitude < (getgenv().ChaseWallMinStep or 6) then
				return goal
			end

			chaseWallCache.offset = Vector3.new(bestPoint.X - position.X, 0, bestPoint.Z - position.Z)
			local bmLog = getgenv().ChaseWallLog ~= false and getgenv().BMLog

			if bmLog then
				local logNow = tick()
				local elapsed = logNow - (getgenv().LastChaseWallLog or 0)
				bmLog = elapsed >= (getgenv().ChaseWallLogRate or 2)
			end

			if bmLog then
				getgenv().LastChaseWallLog = tick()
				getgenv().BMLog(
					string.format(
						"[Tween] He is up against a wall and the spot behind him is inside it - going %d studs around him to open ground instead.",
						math.floor(magnitude)
					)
				)
			end

			return bestPoint
		end

		if getgenv().LureBossOut == true then
			getgenv().LureBossOut = nil
		end

		getgenv().LureBossOut = getgenv().LureBossOut == true
		getgenv().LureSamples = getgenv().LureSamples or 12
		getgenv().LureProbe = getgenv().LureProbe or 70
		getgenv().LureWallNear = getgenv().LureWallNear or 14
		getgenv().LureCornerHits = getgenv().LureCornerHits or 4
		getgenv().LureDistance = getgenv().LureDistance or 55
		getgenv().LureMinDistance = getgenv().LureMinDistance or 25
		getgenv().LurePad = getgenv().LurePad or 10
		getgenv().LureHeight = getgenv().LureHeight or 6
		getgenv().LureRepick = getgenv().LureRepick or 1.5
		getgenv().LureSticky = getgenv().LureSticky or 1
		getgenv().LureMaxHold = getgenv().LureMaxHold or 8
		getgenv().LureCooldown = getgenv().LureCooldown or 4
		getgenv().LureLog = getgenv().LureLog ~= false
		getgenv().LureLogRate = getgenv().LureLogRate or 3
		getgenv().LureState = getgenv().LureState or {}

		-- which sides around origin are blocked by walls, and the open directions (the dump lost the sort's
		-- comparison, so they are in no set order)
		getgenv().bossWallScan = function(origin, ignoreList)
			local once = "max"
			local samples = math.max(getgenv().LureSamples or 12, 4)
			local lureProbe, lureWallNear

			repeat
				lureProbe = getgenv().LureProbe or 70
				lureWallNear = getgenv().LureWallNear
			until once

			lureWallNear = lureWallNear or 14
			local raycastParams = RaycastParams.new()
			raycastParams.FilterType = Enum.RaycastFilterType.Exclude
			local filterDescendantsInstances = {}
			ignoreList = ignoreList or {}

			for _, part in ipairs(ignoreList) do
				if part then
					table.insert(filterDescendantsInstances, part)
				end
			end

			raycastParams.FilterDescendantsInstances = filterDescendantsInstances
			local rayStart = origin + Vector3.new(0, 3, 0)
			local blockedSides = 0
			local directions = {}

			for i = 1, samples do
				local angle = (i - 1) * (6.2831853071795862 / samples)
				local vector = Vector3.new(math.cos(angle), 0, math.sin(angle))
				local hit = Workspace:Raycast(rayStart, vector * lureProbe, raycastParams)
				local magnitude = hit and hit.Position and (hit.Position - rayStart).Magnitude or lureProbe

				if magnitude < lureWallNear then
					blockedSides += 1
				end

				table.insert(directions, { dir = vector, open = magnitude })
			end

			-- the dump lost the comparison, so this sort leaves no meaningful order
			table.sort(directions, function(a, b) end)
			return blockedSides, directions
		end

		-- when the boss is backed into a wall, picks a spot out in the open to lure him to
		getgenv().PickLureSpot = function(boss, _unused, ignoreList)
			if getgenv().LureBossOut == false then
				return nil
			end

			if not (boss and boss.Parent) then
				return nil
			end

			local lureState, now

			while true do
				lureState = getgenv().LureState
				now = tick()

				if lureState.boss == boss then
					break
				end

				lureState.boss = boss
				lureState.spot = nil
				lureState.at = 0
				local corneredAt = 0
				lureState.startedAt = 0
				lureState.corneredAt = corneredAt
				local loggedAt = 0
				lureState.readyAt = 0
				lureState.loggedAt = loggedAt
				break
			end

			if not (now < (lureState.readyAt or 0)) then
				local position = boss.Position
				local blockedSides, directions = getgenv().bossWallScan(position, ignoreList)
				local cornered = blockedSides >= (getgenv().LureCornerHits or 4)

				if cornered then
					lureState.corneredAt = now
				end

				local releaseCorner = not cornered and now - (lureState.corneredAt or 0) > (getgenv().LureSticky or 1)

				if releaseCorner then
					if lureState.spot and getgenv().LureLog ~= false and getgenv().BMLog then
						getgenv().BMLog("[Tween] He came off the wall - back to the normal chase.")
					end

					lureState.spot = nil
					lureState.startedAt = 0
					return nil
				end

				if lureState.spot and now - (lureState.startedAt or now) > (getgenv().LureMaxHold or 8) then
					lureState.spot = nil
					lureState.readyAt = now + (getgenv().LureCooldown or 4)

					if not (getgenv().LureLog ~= false and getgenv().BMLog) then
						return nil
					end

					getgenv().BMLog(
						string.format(
							"[Tween] He did not follow me off the wall within %ds - going back in to him.",
							math.floor(getgenv().LureMaxHold or 8)
						)
					)
					return nil
				end

				local spot = lureState.spot and (now - (lureState.at or 0)) < (getgenv().LureRepick or 1.5)

				if spot then
					return lureState.spot
				end

				local lureDistance = getgenv().LureDistance or 55
				local lurePad = getgenv().LurePad or 10

				for _, direction in ipairs(directions) do
					local pullDist = math.min(lureDistance, direction.open - lurePad)

					if not ((getgenv().LureMinDistance or 25) <= pullDist) then
						continue
					end

					local pulledPos = position + direction.dir * pullDist
					local nonBarrierGroundY = getgenv().FindNonBarrierGroundY(
						Vector3.new(pulledPos.X, position.Y + 10, pulledPos.Z),
						ignoreList
					)
					local spot = Vector3.new(
						pulledPos.X,
						nonBarrierGroundY and nonBarrierGroundY + (getgenv().LureHeight or 6) or pulledPos.Y,
						pulledPos.Z
					)

					if not getgenv().chaseGoalClear(position, spot, ignoreList) then
						continue
					end

					if not lureState.spot then
						lureState.startedAt = now
					end

					lureState.spot = spot
					lureState.at = now

					if
						not (
							getgenv().LureLog ~= false
							and getgenv().BMLog
							and now - (lureState.loggedAt or 0) >= (getgenv().LureLogRate or 3)
						)
					then
						return spot
					end

					lureState.loggedAt = now
					getgenv().BMLog(
						string.format(
							"[Tween] He is backed against a wall (%d of %d sides blocked) - pulling %d studs out into the open so he follows me off it.",
							blockedSides,
							math.max(getgenv().LureSamples or 12, 4),
							math.floor(pullDist)
						)
					)
					return spot
				end

				return lureState.spot
			end

			return nil
		end

		getgenv().FallRecoveryDrop = getgenv().FallRecoveryDrop or 60

		-- --------------------------------------------------------------------
		-- 3.8 Big Mom / background watchers
