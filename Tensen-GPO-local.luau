		-- flat (XZ) distance from us to Big Mom, nil when either is missing
		getgenv().flatToBoss = function()
			local character = localPlayer.Character
			local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
			local bigMom = getgenv().findBigMom and getgenv().findBigMom()
			local bigMomPosition = bigMom and getgenv().bigMomPosition and getgenv().bigMomPosition(bigMom) or nil

			if not (humanoidRootPart and bigMomPosition) then
				return nil
			end

			return (Vector3.new(humanoidRootPart.Position.X, 0, humanoidRootPart.Position.Z) - Vector3.new(
				bigMomPosition.X,
				0,
				bigMomPosition.Z
			)).Magnitude
		end

		-- false when we stand farther than this move has ever reached, so the dodge can be skipped
		getgenv().reactWorthIt = function(animId, label)
			if getgenv().ReactRangeGate == false then
				return true
			end

			local reach = (getgenv().ReactReach or {})[animId]

			if not reach or (reach.n or 0) < (getgenv().ReactReachMin or 4) then
				return true
			end

			local flatDist = getgenv().flatToBoss()

			if not flatDist then
				return true
			end

			if flatDist <= (reach.max or 0) * (getgenv().ReactReachMul or 1.5) + (getgenv().ReactReachPad or 25) then
				return true
			end

			getgenv().ReactSkipped = (getgenv().ReactSkipped or 0) + 1

			if getgenv().ReactLog ~= false and getgenv().BMLog and tick() - (getgenv().LastSkipLog or 0) >= 3 then
				getgenv().LastSkipLog = tick()
				local bmLog = getgenv().BMLog
				local labelText = tostring(label or animId)
				local max = reach.max or 0
				local samples = reach.n or 0
				bmLog(
					string.format(
						"[React] NOT dodging %s - we are %.0f studs out and it has never landed from past %.0f (%d samples), so it cannot reach us (x%d).",
						labelText,
						flatDist,
						max,
						samples,
						getgenv().ReactSkipped
					)
				)
			end

			return false
		end

		-- report of measured reach per move and how many dodges the range gate skipped
		getgenv().ReachReport = function()
			local gateState = getgenv().ReactRangeGate == false and "OFF" or "on"

			local lines = {
				string.format(
					"[Reach] measured reach per move | gate %s | skipped %d dodges | deduped %d",
					gateState,
					getgenv().ReactSkipped or 0,
					getgenv().ReactDeduped or 0
				),
			}

			local rows = {}
			local reactReach = getgenv().ReactReach or {}

			for k, reach in pairs(reactReach) do
				rows[#rows + 1] = { id = k, max = reach.max or 0, n = reach.n or 0 }
			end

			-- the dump lost the comparison, so this sort leaves no meaningful order
			table.sort(rows, function(a, b) end)

			for _, row in ipairs(rows) do
				lines[#lines + 1] = string.format(
					"   %-34s reaches %6.0f studs  (%d samples)%s",
					string.sub(tostring(getgenv().AnimLabels[row.id] or row.id), 1, 34),
					row.max,
					row.n,
					row.n < (getgenv().ReactReachMin or 4) and "  <- still always dodged" or ""
				)
			end

			local report = table.concat(lines, "\n")

			pcall(function()
				getgenv().BigMomPrint(report)
			end)
			return report
		end

