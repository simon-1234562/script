				getgenv().BMLog(
					string.format(
						"[Room] The fight put us outside room %s (%.0f studs from where we were standing in it) - going back in rather than reading the room state from out here (x%d).",
						tostring(getgenv().LastInsideRoom),
						magnitude,
						getgenv().RoomReturns
					)
				)
			end

			getgenv().BigMomBusy = true
			pcall(
				getgenv().goTo,
				CFrame.new(lastInsidePos),
				"back inside room " .. tostring(getgenv().LastInsideRoom),
