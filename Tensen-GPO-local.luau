		-- --------------------------------------------------------------------
		-- 3.9 Big Mom / character and NPC lookup
		-- --------------------------------------------------------------------

		getCharacter = function()
			local character = localPlayer.Character

			if character then
				return character
			end

			local character

			repeat
				task.wait(getgenv().CharPollRate or 0.1)
				character = localPlayer.Character
			until character

			return character
		end

		local isIgnoredNPC, npcRoot, nearestMob

		do
			local function isBurningStage()
				local stageName = tostring(getgenv().currentStageName or "")
				return string.find(string.upper(stageName), "BURNING") ~= nil or getgenv().BurningStageActive == true
			end

			getgenv().ForceFieldNames = getgenv().ForceFieldNames or { "DungeonVillageGarrisonForceField" }
			local instances = setmetatable({}, { __mode = "k" })

			-- true when a villager NPC is under a force field (memoised briefly)
			local function hasVillagerForceField(instance)
				if not instance or not instance.Parent then
					return false
				end

				if
					getgenv().ForceFieldSkipBosses ~= false
					and (
						getgenv().isMochiNPC and getgenv().isMochiNPC(instance)
						or getgenv().isBigMomNPC and getgenv().isBigMomNPC(instance)
						or getgenv().isJuiceNPC and getgenv().isJuiceNPC(instance)
					)
				then
					return false
				end

				local memo = instances[instance]

				if memo and tick() - memo.t < (getgenv().ForceFieldMemoRate or 2) then
					return memo.v
				end

				local hasVillagerFF = false

				if
					not pcall(function()
						local forceFieldNames = getgenv().ForceFieldNames or {}

						for _, forceFieldName in ipairs(forceFieldNames) do
							if
								instance:FindFirstChild(forceFieldName) or instance:FindFirstChild(forceFieldName, true)
							then
								hasVillagerFF = true
								return
							end
						end

						hasVillagerFF = instance:FindFirstChildOfClass("ForceField") ~= nil
					end)
				then
					hasVillagerFF = false
				end

				instances[instance] = { t = tick(), v = hasVillagerFF }
				return hasVillagerFF
			end

			getgenv().hasVillagerForceField = hasVillagerForceField

			-- true for NPCs the farm skips (ignored names, reinforcements unless allowed)
			isIgnoredNPC = function(npc)
				if not npc then
					return true
				end

				if hasVillagerForceField(npc) then
					return true
				end

				if not isBurningStage() then
					return false
				end

				if getgenv().IgnoredNPC == false or getgenv().AllowReinforcement == true then
					return false
				end

				local name = npc.Name
				local ignoredNPCNames = getgenv().IgnoredNPCNames or { "Reinforcement", "Operator", "Technician" }

				for _, ignoredNPCName in ipairs(ignoredNPCNames) do
					if string.find(name, ignoredNPCName) then
						return true
					end
				end

				return false
			end

			-- true for NPCs the target picker must leave alone (prisoner carrier, reinforcement operator,
			-- ...)
			local function isExcludedNPC(instance)
				if not instance then
					return false
				end

				if getgenv().CurrentReinforcementOperator == instance then
					return true
				end

				if getgenv().CurrentPrisonerCarrier and getgenv().CurrentPrisonerCarrier == instance then
					return false
				end

				if getgenv().AllowReinforcement ~= true then
					return false
				end

				local name = instance.Name
				return string.find(name, "Reinforcement") ~= nil
					or string.find(name, "Operator") ~= nil
					or string.find(name, "Technician") ~= nil
			end

			local obj = setmetatable({}, { __mode = "k" })

			-- true when the NPC is a quest giver (memoised for QuestMemoRate seconds)
			local function isQuestNPC(instance)
				if not instance or not instance.Parent then
					return false
				end

				local memo = obj[instance]

				if memo and tick() - memo.t < (getgenv().QuestMemoRate or 4) then
					return memo.v
				end

				local isQuest = false

				if
					not pcall(function()
						for _, descendant in ipairs(instance:GetDescendants()) do
							if descendant:IsA("Highlight") then
								isQuest = true
								return
							end

							local name = string.lower(descendant.Name)

							if
								string.find(name, "questmarker")
								or string.find(name, "quest")
								or string.find(name, "marker")
							then
								isQuest = true
								return
							end
						end
					end)
				then
					isQuest = false
				end

				obj[instance] = { t = tick(), v = isQuest }
				return isQuest
			end

			-- the root part of a model (HumanoidRootPart, else PrimaryPart), nil when missing
			npcRoot = function(model)
				if not model then
					return nil
				end

				local rootPart = model:FindFirstChild("HumanoidRootPart")

				if rootPart and rootPart:IsA("BasePart") then
					return rootPart
				end

				if model:IsA("Model") then
					return model.PrimaryPart
				end

				return nil
			end

			getgenv().npcRoot = npcRoot
			getgenv().isIgnoredNPC = isIgnoredNPC

			-- true for living NPCs the farm may target (not ignored, not excluded, not quest givers)
			local function isAliveTarget(instance)
				if not instance or not instance.Parent then
					return false
				end

				if isIgnoredNPC(instance) then
					return false
				end

				local hum = instance:FindFirstChildOfClass("Humanoid")

				if not hum or hum.Health <= 0 then
					return false
				end

				return isQuestNPC(instance)
			end

			-- the list of mobs to pick from: a table, a function returning one, a folder, or workspace.NPCs
			local function mobList(instance)
				if not instance then
					return npcFolder and npcFolder:GetChildren() or {}
				end

				if type(instance) == "function" then
					local ok, result = pcall(instance)

					if ok and type(result) == "table" then
						return result
					end

					return
				end

				if type(instance) == "table" then
					return instance
				end

				if typeof(instance) == "Instance" then
					return instance:GetChildren()
				end

				return {}
			end

			-- the closest living mob to `from` (a position or a part) that the farm may target; the prisoner
			-- carrier wins
			nearestMob = function(from, container)
				local instances = mobList(container)
				local fromVector = typeof(from) == "Vector3" and from
				local position

				if fromVector then
					position = fromVector
				elseif from then
					position = from.Position
				else
					position = from
				end

				if not position then
					return nil
				end

				if getgenv().CurrentPrisonerCarrier and getgenv().CurrentPrisonerCarrier.Parent then
					local currentPrisonerCarrier = getgenv().CurrentPrisonerCarrier
					local hum = currentPrisonerCarrier:FindFirstChildOfClass("Humanoid")

					if hum and hum.Health > 0 then
						return currentPrisonerCarrier
					end
				end

				if isBurningStage() then
					local bestDist = math.huge
					local iterFn, iterState, iterStart = ipairs(instances)
					local best = nil

					for _, instance in iterFn, iterState, iterStart do
						if
							not (not isIgnoredNPC(instance) and not isExcludedNPC(instance) and isAliveTarget(instance))
						then
							continue
						end

						local root = npcRoot(instance)
						local hum = instance:FindFirstChildOfClass("Humanoid")

						if root and hum and hum.Health > 0 then
							local magnitude = (position - root.Position).Magnitude

							if magnitude < bestDist then
								bestDist = magnitude
								best = instance
							end
						end
					end

					if best then
						return best
					end
				end

				local bestDist = math.huge
				local best = nil

				for _, instance in ipairs(instances) do
					if isIgnoredNPC(instance) or isExcludedNPC(instance) then
						continue
					end

					local root = npcRoot(instance)
					local humanoid = instance:FindFirstChildOfClass("Humanoid")

					if root and (not humanoid or humanoid.Health > 0 or humanoid.MaxHealth == 0) then
						local magnitude = (position - root.Position).Magnitude

						if magnitude < bestDist then
							bestDist = magnitude
							best = instance
						end
					end
				end

				return best
			end
		end

		getgenv().IsBlocking = false

		-- --------------------------------------------------------------------
		-- 3.10 Big Mom / blocking
		-- --------------------------------------------------------------------

		local function isDefending()
			if getgenv().BreathBlocking then
				return true
			end

			if getgenv().BreathActive then
				return true
			end

			if getgenv().AutoBlocking then
				return true
			end

			if getgenv().IsBlocking then
				return true
			end

			local character = localPlayer.Character or startCharacter

			if character and (character:FindFirstChild("Blocking") or character:FindFirstChild("Block")) then
				return true
			end

			return false
		end

		getgenv().BlockTypeCandidates = getgenv().BlockTypeCandidates or { "Sword", "Melee", "melee", "sword" }
		getgenv().BlockTypeProbe = getgenv().BlockTypeProbe == true

		if getgenv().BlockTypeTry ~= nil then
			if getgenv().BMLog then
				getgenv().BMLog(
					string.format(
						"[Block] Clearing a stale block type '%s' left by the old rotation - going back to the weapon class.",
						tostring(getgenv().BlockTypeTry)
					)
				)
			end

			getgenv().BlockTypeTry = nil
		end

		-- the block type to send: the pinned one, the one being tried, else from the weapon type
		getgenv().blockWeaponType = function()
			local blockWeaponType = getgenv().BlockWeaponType

			if blockWeaponType and blockWeaponType ~= "" then
				return blockWeaponType
			end

			if getgenv().BlockTypeTry and getgenv().BlockTypeTry ~= "" then
				return getgenv().BlockTypeTry
			end

			local weaponType = getgenv().WeaponType

			if weaponType == "Sword" or weaponType == "World Ender" then
				return "Sword"
			end

			return "Melee"
		end

		-- the next block type to try from BlockTypeCandidates, after the current one
		getgenv().nextBlockType = function()
			local blockTypeCandidates = getgenv().BlockTypeCandidates or {}

			if #blockTypeCandidates == 0 then
				return nil
			end

			local currentType = getgenv().blockWeaponType()
			local currentIndex = 0

			for i, blockTypeCandidate in ipairs(blockTypeCandidates) do
				if blockTypeCandidate == currentType then
					currentIndex = i
					break
				end
			end

			local blockTypeCandidate = blockTypeCandidates[currentIndex % #blockTypeCandidates + 1]
			getgenv().BlockTypeTry = blockTypeCandidate
			return blockTypeCandidate
		end

		-- our character model (Character, else the one in workspace.PlayerCharacters)
		getgenv().myCharacter = function()
			local character = localPlayer.Character

			if character and character.Parent then
				return character
			end

			local playerCharacters = Workspace:FindFirstChild("PlayerCharacters")

			if playerCharacters then
				local myModel = playerCharacters:FindFirstChild(localPlayer.Name)

				if myModel then
					return myModel
				end
			end

			return nil
		end

		-- true when the server shows the character as blocking (Blocking/Block child or attribute)
		getgenv().playerBlockingFlag = function()
			local myCharacter = getgenv().myCharacter()

			if not myCharacter then
				return false
			end

			if myCharacter:FindFirstChild("Blocking") or myCharacter:FindFirstChild("Block") then
				return true
			end

			local ok, result = pcall(function()
				return myCharacter:GetAttribute("Blocking")
			end)

			if ok and result == true then
				return true
			end

			return false
		end

		getgenv().BlockTrustReturn = getgenv().BlockTrustReturn ~= false

		do
			if getgenv().BlockReturnTrust == 2 then
				getgenv().BlockReturnTrust = nil
			end

			getgenv().BlockReturnTrust = getgenv().BlockReturnTrust or 0.5
			getgenv().BlockConfirmedAt = getgenv().BlockConfirmedAt or 0

			-- true when the block remote's return value proves the block registered
			getgenv().blockReturnConfirms = function(response)
				if getgenv().BlockTrustReturn == false then
					return false
				end

				if response == true then
					return true
				end

				if typeof(response) == "Instance" then
					return true
				end

				return false
			end

			-- true (with how) when the server shows our block
			getgenv().blockConfirmed = function()
				local ok, result = pcall(getgenv().playerBlockingFlag)

				if ok and result then
					return true, "the Blocking flag is up"
				end

				if tick() - (getgenv().BlockConfirmedAt or 0) <= (getgenv().BlockReturnTrust or 2) then
					return true, "the remote returned a Blocking object"
				end

				return false
			end

			-- sends the block remote (once, unless forced) and learns which block type the server accepts
			local function doBlock(force)
				if getgenv().BreathBlocking then
					getgenv().ToggleFaceMouse(false)
					getgenv().LastFaceMouseClear = tick()
				end

				if getgenv().IsBlocking and not force then
					return
				end

				getgenv().IsBlocking = true
				getgenv().BlockSends = (getgenv().BlockSends or 0) + 1
				local lastBlockType = getgenv().blockWeaponType()

				local function getResponse() end

				local blockOk, blockResponse = pcall(getResponse)
				getgenv().LastBlockType = lastBlockType
				getgenv().LastBlockReturn = blockOk and blockResponse or nil

				if blockOk and getgenv().blockReturnConfirms(blockResponse) then
					getgenv().BlockConfirmedAt = tick()

					if not getgenv().BlockEverTook then
						getgenv().BlockEverTook = true

						if getgenv().BMLog then
							getgenv().BMLog(
								string.format(
									"[Block] The remote returned '%s' for type '%s' - the block REGISTERED. Trusting the block from here on.",
									tostring(blockResponse),
									tostring(lastBlockType)
								)
							)
						end
					end

					if
						(getgenv().BlockPinOnReturn ~= false)
						and (getgenv().BlockWeaponType == nil or getgenv().BlockWeaponType == "")
					then
						getgenv().BlockWeaponType = lastBlockType

						if getgenv().BMLog then
							getgenv().BMLog(
								string.format(
									"[Block] Pinning the block type to '%s' - the server confirmed it by return value, not by guesswork.",
									tostring(lastBlockType)
								)
							)
						end
					end
				end

				if not blockOk and getgenv().BMLog then
					local log = getgenv().BMLog
					local typeText = tostring(lastBlockType)
					log(
						string.format(
							"[Defense] Block remote ERRORED with type '%s': %s",
							typeText,
							tostring(blockResponse)
						)
					)
				end
			end

			-- sends the unblock remote (once, unless forced); returns whether the call went through
			local function doUnblock(force)
				if not force and not getgenv().IsBlocking then
					return
				end

				getgenv().IsBlocking = false
				getgenv().BlockConfirmedAt = 0
				local unblockArgs = { false, getgenv().blockWeaponType(), false }

				local ok, result = pcall(function()
					return ReplicatedStorage.Events.Block:InvokeServer(unpack(unblockArgs))
				end)

				getgenv().LastUnblockAt = tick()
				getgenv().LastUnblockRet = ok and result or nil

				if not ok and getgenv().BMLog then
					getgenv().BMLog(string.format("[Block] The UNBLOCK remote errored: %s", tostring(result)))
				end

				return ok
			end

			getgenv().DoBlock = doBlock
			getgenv().DoUnBlock = doUnblock
			getgenv().BlockOrphanWatch = getgenv().BlockOrphanWatch ~= false
			getgenv().BlockOrphanGrace = getgenv().BlockOrphanGrace or 0.6
			getgenv().BlockOrphanRate = getgenv().BlockOrphanRate or 0.5
			getgenv().BlockOrphanLog = getgenv().BlockOrphanLog ~= false
			getgenv().BlockOrphanFixes = getgenv().BlockOrphanFixes or 0

			-- true (with who wants it) when something wants us to keep blocking
			getgenv().blockWanted = function()
				if getgenv().BreathBlocking == true then
					return true, "the breath watcher"
				end

				if getgenv().AutoBlocking == true then
					return true, "the defense loop"
				end

				if getgenv().IsBlocking == true then
					return true, "a block we sent"
				end

				return false
			end

			getgenv().WaitForUnblock = getgenv().WaitForUnblock ~= false
			getgenv().WaitUnblockMax = getgenv().WaitUnblockMax or 3
			getgenv().WaitUnblockLog = getgenv().WaitUnblockLog ~= false
