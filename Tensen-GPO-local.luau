							fruitStoreFail
						)
					)
				elseif fruitStoreFail < fruitStoreFailMax then
					getgenv().BMLog(
						string.format(
							"[Fruit] '%s' is still in the bag after the store call (try %d/%d).",
							tool.Name,
							fruitStoreFail,
							fruitStoreFailMax
						)
					)
				end

				return fruitStoreFail
			end

			-- the first fruit tool in the bag or hand that is not given up on, and its fruit name
			getgenv().findFruitTool = function()
				local character = getCharacter()
				local backpack = localPlayer:FindFirstChildOfClass("Backpack")

				if not character or not backpack then
					return nil
				end

				local fruitNames = getgenv().fruitNameSet()
				local fruitStoreGaveUp = getgenv().fruitStoreGaveUp

				for _, child in ipairs(character:GetChildren()) do
					if child:IsA("Tool") and fruitNames[child.Name] and not fruitStoreGaveUp(child) then
						if getgenv().RecordFruitTool then
							getgenv().RecordFruitTool(child.Name)
						end

						return child, fruitNames[child.Name]
					end
				end

				for _, child in ipairs(backpack:GetChildren()) do
					if child:IsA("Tool") and fruitNames[child.Name] and not fruitStoreGaveUp(child) then
						if getgenv().RecordFruitTool then
							getgenv().RecordFruitTool(child.Name)
						end

						return child, fruitNames[child.Name]
					end
				end

				return nil
			end

			-- stores one fruit from the bag through the FruitStorage remote; true when something was stored
			getgenv().AutoStore = function()
				local character = getCharacter()

				if not character then
					return false
				end

				local fruitTool, fruitName = getgenv().findFruitTool()

				if fruitTool then
					local hum = character:FindFirstChildOfClass("Humanoid")

					if not hum then
						return false
					end

					getgenv().BMLog(
						string.format("[Fruit] '%s' found (%s) - storing it.", fruitTool.Name, tostring(fruitName))
					)

					pcall(function()
						hum:UnequipTools()
					end)
					task.wait(0.3)

					if fruitTool.Parent ~= character then
						pcall(function()
							hum:EquipTool(fruitTool)
						end)
					end

					task.wait(0.5)

					local storeOk, storeErr = pcall(function()
						ReplicatedStorage.Events.FruitStorage:InvokeServer(true)
					end)
					task.wait(0.3)

					pcall(function()
						hum:UnequipTools()
					end)
					task.wait(0.2)
					local backpack = localPlayer:FindFirstChildOfClass("Backpack")
					local parent = fruitTool.Parent

					if
						storeOk
						and not (parent ~= nil and (parent == character or backpack ~= nil and parent == backpack))
					then
						getgenv().BMLog(string.format("[Fruit] Stored '%s'.", fruitTool.Name))
						getgenv().FruitStoreFails[fruitTool] = nil

						if getgenv().RecordFruitTool then
							getgenv().RecordFruitTool(fruitTool.Name, true)
						end
					elseif storeOk then
						getgenv().noteFruitStoreFail(fruitTool)
					else
						getgenv().BMLog(string.format("[Fruit] FruitStorage remote errored: %s", tostring(storeErr)))
						getgenv().noteFruitStoreFail(fruitTool)
					end

					getgenv().FruitStoreRetry = 0
					return true
				end

				getgenv().FruitStoreRetry = (getgenv().FruitStoreRetry or 0) + 1

				if (getgenv().AutoStoreMaxRetry or 5) <= getgenv().FruitStoreRetry then
					getgenv().BMLog(
						string.format(
							"[Fruit] Nothing to store after %d tries - dropping it for now.",
							getgenv().FruitStoreRetry
						)
					)
					getgenv().UnequipTool()
					getgenv().FruitStoreRetry = 0
					return true
				end

				return false
			end

			task.spawn(function()
				while task.wait(getgenv().AutoStoreRate or 5) do
					if bmStale() then
						break
					end

					if
						not (
							getgenv().AutoStoreFruit ~= false
							and getgenv().EnableBigMom
							and not (getgenv().EvadingBoss or getgenv().LowHealthActive)
							and not getgenv().CarryingReinforcement
							and not (getgenv().PerchedOnBarrier or getgenv().PerchEngaging)
							and getgenv().findFruitTool()
						)
					then
						continue
					end

					getgenv().FruitStoreRetry = 0
					getgenv().StoringFruit = true

					local equipOk = pcall(function()
						getgenv().AutoStore()
					end)
					getgenv().StoringFruit = false

					if not equipOk then
						getgenv().BMLog("[Fruit] Auto store pass errored - will retry.")
					end

					pcall(forceEquip)
				end
			end)
		end

		getgenv().AutoEquipWeapon = getgenv().AutoEquipWeapon ~= false
		getgenv().AutoEquipRate = getgenv().AutoEquipRate or 1
		getgenv().WeaponEquips = getgenv().WeaponEquips or 0

		task.spawn(function()
			while task.wait(getgenv().AutoEquipRate or 1) do
				if bmStale() then
					break
				end

				if
					getgenv().AutoEquipWeapon ~= false
					and getgenv().EnableBigMom
					and not getgenv().BigMomBusy
					and not getgenv().CarryingReinforcement
					and not getgenv().StoringFruit
				then
					local character = localPlayer.Character
					local humanoid = character and character:FindFirstChildOfClass("Humanoid")

					if
						character
						and humanoid
						and not (humanoid.Health <= 0)
						and not getgenv().weaponInHand(character)
						and getgenv().weaponInBag()
					then
						pcall(getgenv().equipWeapon, "the idle check")
					end
				end
			end
		end)

		getgenv().BossBlockSkip = getgenv().BossBlockSkip ~= false

		getgenv().bossBlockingNow = getgenv().bossBlockingNow
			or function()
				local bigMom = getgenv().findBigMom()

				if not bigMom then
					return false
				end

				return bigMom:FindFirstChild("Blocking") ~= nil
			end

		-- --------------------------------------------------------------------
		-- 3.21 Big Mom / swinging (M1 loop)
		-- --------------------------------------------------------------------

		do
			local function selfBlocking()
				local character = getCharacter()
				return (character and character:FindFirstChild("Blocking")) ~= nil
			end

			-- true when this swing should be skipped (farm off, no character, defending, stunned, ...)
			local function shouldSkipSwing()
				if not getgenv().EnableBigMom then
					return true
				end

				if not getCharacter() then
					return true
				end

				if isDefending() then
					return true
				end

				if selfBlocking() then
					return true
				end

				if getgenv().EvadingBoss then
					return true
				end

				if getgenv().LowHealthActive then
					return true
				end

				if not startRoot or not startRoot.Parent then
					return true
				end

				if getgenv().BossBlockSkip ~= false and getgenv().FeintOnBlock == false then
					local ok, result = pcall(getgenv().bossBlockingNow)

					if ok and result then
						return true
					end
				end

				return false
			end

			getgenv().FeintOnBlock = getgenv().FeintOnBlock ~= false
			getgenv().FeintRetry = getgenv().FeintRetry or 5
			getgenv().FeintLog = getgenv().FeintLog ~= false
			getgenv().Feints = getgenv().Feints or 0
			getgenv().BlockAnimIds = getgenv().BlockAnimIds or {}
			getgenv().BlockAnimIds["15374683054"] = "Big Mama Block"
			getgenv().BlockAnimIds["95593858663705"] = "Mochi Trident Block (Katakuri)"
			getgenv().BlockAnimIds["13243427337"] = "Mochi fruit Block"
			local obj = setmetatable({}, { __mode = "k" })

			-- true (with how it was seen) when the target is blocking: flag, attribute or block animation
			getgenv().targetBlocking = function(instance)
				if not (instance and instance.Parent) then
					return false
				end

				if getgenv().isNPCBlocking and getgenv().isNPCBlocking(instance) then
					return true, "a Blocking flag"
				end

				local ok, result = pcall(function()
					return instance:GetAttribute("IsBlocking")
				end)

				if ok and result == true then
					return true, "IsBlocking"
				end

				local humanoid = instance:FindFirstChildOfClass("Humanoid")
				local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")

				if animator then
					local blockAnimId = nil

					pcall(function()
						for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
							local animation = track.Animation
							local animId = animation and string.match(tostring(animation.AnimationId), "%d+")

							if animId and (getgenv().BlockAnimIds or {})[animId] then
								blockAnimId = getgenv().BlockAnimIds[animId]
								return
							end

							if animation and string.find(string.lower(animation.Name or ""), "block", 1, true) then
								blockAnimId = animation.Name
								return
							end
						end
					end)

					if blockAnimId then
						return true, "the " .. tostring(blockAnimId) .. " animation"
					end
				end

				return false
			end

			-- while the target blocks, holds the swing until it drops the block (the dump never sends the fake
			-- m1); true while holding
			local function swingAt(instance, weaponKind, index, animation)
				if getgenv().FeintOnBlock == false then
					return false
				end

				local parent = instance and instance.Parent

				if not parent then
					return false
				end

				local blocking, blockWhy = getgenv().targetBlocking(parent)

				if not blocking then
					if obj[parent] and getgenv().FeintLog ~= false and getgenv().BMLog then
						getgenv().BMLog(
							string.format(
								"[Feint] '%s' dropped the block after %.1fs - m1ing for real.",
								tostring(parent.Name),
								tick() - obj[parent].since
							)
						)
					end

					obj[parent] = nil
					return false
				end

				local feint = obj[parent]
				local tooSoon

				if feint then
					local elapsed = tick() - feint.at
					tooSoon = elapsed < (getgenv().FeintRetry or 5)
				else
					tooSoon = feint
				end

				if tooSoon then
					return true
				end

				obj[parent] = { at = tick(), since = feint and feint.since or tick() }
				getgenv().Feints = (getgenv().Feints or 0) + 1

				if getgenv().FeintLog ~= false and getgenv().BMLog then
					local bmLog = getgenv().BMLog
					local targetName = tostring(parent.Name)
					local whyText = tostring(blockWhy)
					bmLog(
						string.format(
							"[Feint] '%s' is blocking (%s) - fake m1, no damage. Waiting for the unblock, feinting again in %ds if it holds (x%d).",
							targetName,
							whyText,
							math.floor(getgenv().FeintRetry or 5),
							getgenv().Feints
						)
					)
				end

				return true
			end

			local function combatRange()
				if getgenv().BigMomFightActive() then
					return getgenv().BossCombatRange or 50
				end

				return 25
			end

			if getgenv().WeaponType == "Melee" then
				task.spawn(function()
					while task.wait(0.05) do
						if bmStale() then
							break
						end

						if shouldSkipSwing() then
							comboIndex = 1
							continue
						end

						local character = getCharacter()

						if not getgenv().weaponInHand(character) then
							if #getInstances(combatRange()) > 0 then
								getgenv().askWeaponEquip("a melee fight with nothing in hand")
							end
							continue
						end

						if tick() - lastSwing < getgenv().HitWait then
							continue
						end

						local instances = getInstances(combatRange())

						if #instances == 0 then
							comboIndex = 1
							continue
						end

						local target = instances[1]

						if not target or not target.Parent then
							comboIndex = 1
							continue
						end

						local step = punchCombo[comboIndex]

						if not step then
							comboIndex = 1
							continue
						end

						if
							swingAt(target, "Melee", step.index, ReplicatedStorage.CombatAnimations.Melee[step.anim])
						then
							lastSwing = tick()
							continue
						end

						combatRegister:InvokeServer({
							"swingsfx",
							"Melee",
							step.index,
							"Ground",
							false,
							ReplicatedStorage.CombatAnimations.Melee[step.anim],
							2,
							1.5,
						})

						local position = target.Position - startRoot.Position

						if position.Magnitude == 0 then
							position = startRoot.CFrame.LookVector
						end

						combatRegister:InvokeServer({
							"damage",
							instances,
							"Melee",
							{ step.index, "Ground", "Melee" },
							true,
							CFrame.new(target.Position - position.Unit * 5 + Vector3.new(0, 1, 0), target.Position),
							aircombo = "Ground",
						})

						lastSwing = tick()
						comboIndex += 1

						if comboIndex > 4 then
							comboIndex = 1
						end
					end
				end)
			end

			local usesSword = getgenv().WeaponType == "Sword"
				or getgenv().WeaponType == "World Ender"
				or getgenv().WeaponType == "PikaV2"

			if usesSword then
				task.spawn(function()
					local swords = ReplicatedStorage.Modules.SwordHandle.Swords
					local swordName = nil

					while task.wait(0.05) do
						if bmStale() then
							break
						end

						if shouldSkipSwing() then
							comboIndex = 1
							continue
						end

						local character = getCharacter()

						if not (swordName and character:FindFirstChild(swordName)) then
							if getgenv().WeaponType == "World Ender" then
								swordName = nil

								for _, name in ipairs({ "World Ender", "World Ender 2", "Hollow's World Ender" }) do
									if character:FindFirstChild(name) then
										swordName = name
										break
									end

									swordName = nil
								end
							else
								swordName = nil

								for _, child in pairs(swords:GetChildren()) do
									if
										character:FindFirstChild(child.Name) and getgenv().swordNameAllowed(child.Name)
									then
										swordName = child.Name
										break
									end

									swordName = nil
								end
							end
						end

						if not swordName then
							if #getInstances(combatRange()) > 0 then
								getgenv().askWeaponEquip(
									string.format("a %s fight with nothing in hand", tostring(getgenv().WeaponType))
								)
							end
							continue
						end

						if tick() - lastSwing < getgenv().HitWait then
							continue
						end

						local instances = getInstances(combatRange())

						if #instances == 0 then
							comboIndex = 1
							continue
						end

						local target = instances[1]

						if not target or not target.Parent then
							comboIndex = 1
							continue
						end

						local step = swordCombo[comboIndex]

						if not step then
							comboIndex = 1
							continue
						end

						local slash = swords[swordName].Slashes[step.anim]

						if swingAt(target, "Sword", step.index, slash) then
							lastSwing = tick()
							continue
						end

						combatRegister:InvokeServer({ "swingsfx", "Sword", step.index, "Ground", false, slash, 2, 1.5 })
						local position = target.Position - startRoot.Position

						if position.Magnitude == 0 then
							position = startRoot.CFrame.LookVector
						end

						combatRegister:InvokeServer({
							"damage",
							instances,
							"Sword",
							{ step.index, "Ground", "Sword" },
							true,
							CFrame.new(target.Position - position.Unit * 5 + Vector3.new(0, 1, 0), target.Position),
							aircombo = "Ground",
						})

						lastSwing = tick()
						comboIndex += 1

						if comboIndex > 4 then
							comboIndex = 1
						end
					end
				end)
			end
		end

		getgenv().TweenLand = getgenv().TweenLand ~= false
		getgenv().TweenLandMaxDrop = getgenv().TweenLandMaxDrop or 30

		getgenv().TweenLandHold = getgenv().TweenLandHold or 0.2

		getgenv().TweenLandLog = getgenv().TweenLandLog == true

		getgenv().TweenLandings = getgenv().TweenLandings or 0
		getgenv().TweenLandHolding = false

		-- --------------------------------------------------------------------
		-- 3.22 Big Mom / landing after a tween
		-- --------------------------------------------------------------------

		do
			-- how high the root sits above the floor for this rig (R6 or HipHeight based)
			local function standHeight()
				local y = (startRoot and startRoot.Size.Y or 2) / 2

				if humanoid and humanoid.Parent then
					local ok, result = pcall(function()
						return humanoid.RigType == Enum.HumanoidRigType.R6
					end)

					if ok and result then
						return y + 2
					end

					local hipHeight = humanoid.HipHeight

					if type(hipHeight) == "number" and hipHeight > 0 then
						return y + hipHeight
					end
				end

				return 3
			end

			-- Y of the floor under a position, and the part hit
			local function floorBelow(position)
				local raycastParams = RaycastParams.new()
				raycastParams.FilterType = Enum.RaycastFilterType.Exclude
				raycastParams.FilterDescendantsInstances = { localPlayer.Character or startCharacter }
				raycastParams.IgnoreWater = true

				pcall(function()
					raycastParams.RespectCanCollide = true
				end)
				local tweenLandMaxDrop = getgenv().TweenLandMaxDrop or 30
				local hit = Workspace:Raycast(
					position + Vector3.new(0, 4, 0),
					Vector3.new(0, -(tweenLandMaxDrop + 4), 0),
					raycastParams
				)

				if hit and hit.Instance then
					return hit.Position.Y, hit.Instance
				end

				return nil
			end

			-- after a tween, puts the character down on the floor under it; returns whether it moved and
			-- where
			getgenv().landAfterTween = function(position, label)
				local root = startRoot

				if not (root and root.Parent) then
					return false
				end

				if getgenv().TweenLand == false then
					return false
				end

				if getgenv().firebreathMovementHeld() then
					return false
				end

				position = position or root.Position
				local floorY, floorPart = floorBelow(position)
				local vector = position

				if floorY then
					vector = Vector3.new(position.X, floorY + standHeight(), position.Z)
				end

				pcall(function()
					root.CFrame = CFrame.new(vector) * root.CFrame.Rotation
					root.AssemblyLinearVelocity = Vector3.zero
					root.AssemblyAngularVelocity = Vector3.zero
				end)

				pcall(function()
					if humanoid and humanoid.Parent then
						humanoid.PlatformStand = false
						humanoid.AutoRotate = true
					end
				end)
				getgenv().TweenLandings = (getgenv().TweenLandings or 0) + 1

				if getgenv().TweenLandLog == true and getgenv().BMLog then
					getgenv().BMLog(
						string.format(
							"[Land] %s stopped at Y %.1f - %s, standing at Y %.1f.",
							tostring(label or "the tween"),
							position.Y,
							floorPart and "floor '" .. floorPart.Name .. "' at Y " .. string.format("%.1f", floorY)
								or "no floor within " .. tostring(getgenv().TweenLandMaxDrop or 30) .. " studs",
							vector.Y
						)
					)
				end

				local num = tonumber(getgenv().TweenLandHold)
				local settle = num or 0.2

				if settle <= 0 then
					return true, vector
				end

				local gen = tweenState.Gen
				getgenv().TweenLandHolding = true

				pcall(function()
					root.Anchored = true
				end)

				task.spawn(function()
					local deadline = tick() + settle

					while tick() < deadline do
						if tweenState.Gen ~= gen or tweenState.Enabled then
							break
						end

						if root and root.Parent and not getgenv().firebreathMovementHeld() then
							task.wait(0.03)
							continue
						end

						break
					end

					getgenv().TweenLandHolding = false

					pcall(function()
						if root and root.Parent then
							root.AssemblyLinearVelocity = Vector3.zero
							root.AssemblyAngularVelocity = Vector3.zero

							if not getgenv().firebreathMovementHeld() then
								root.Anchored = false
							end
						end
					end)
				end)
				return true, vector
			end
		end

		-- --------------------------------------------------------------------
		-- 3.23 Big Mom / tweenToCFrame and safe walking
		-- --------------------------------------------------------------------

		local function tweenToCFrame(cfg)
			if getgenv().EvadingBoss or getgenv().LowHealthAnchored then
				return
			end

			if getgenv().LowHealthActive and not getgenv().LowHealthSelfTween then
				return
			end

			cfg = cfg or {}
			local cframe = cfg.CFrame
			local offset = cfg.Offset or Vector3.zero
			local walkOnWater = cfg.WalkOnWater ~= false
			local noclip = cfg.Noclip ~= false

			if tweenState.Enabled == true or not cframe or not startRoot then
				return
			end

			getgenv().RecordTweenRequest("cframe", cfg)
			stopTween()
			tweenState.Enabled = true
			setNoclip(noclip)
			getgenv().NoclipOverride = false
			getgenv().OverrideType = ""
			getgenv().WaterOverride = true

			if walkOnWater then
				getgenv().WaterOverrideType = "Collide"
			else
				getgenv().WaterOverrideType = "NoCollide"
			end

			humanoid.PlatformStand = true
			humanoid.AutoRotate = false
			local breathHeld = getgenv().firebreathMovementHeld()

			if not breathHeld then
				startRoot.Anchored = false
			end

			local kdCFrameGyro = Instance.new("BodyGyro")
			kdCFrameGyro.Name = "KD_CFrameGyro"
			kdCFrameGyro.P = 200000
			kdCFrameGyro.D = 1000
			kdCFrameGyro.MaxTorque = Vector3.new(1e9, 1e9, 1000000000)
			kdCFrameGyro.Parent = startRoot
			local bodyVelocity = Instance.new("BodyVelocity")
			bodyVelocity.Name = "KD_CFrameVel"
			bodyVelocity.MaxForce = Vector3.new(1000000000, 1000000000, 1e9)
			bodyVelocity.Parent = startRoot
			tweenState.Gyro = kdCFrameGyro
			tweenState.Vel = bodyVelocity
			local startedAt = tick()
			local maxTime = cfg.MaxTime or 20
			local raycastParams = RaycastParams.new()
			raycastParams.FilterDescendantsInstances = { startCharacter }
			raycastParams.FilterType = Enum.RaycastFilterType.Exclude
			local heartbeat = RunService.Heartbeat
			tweenState.Conn = heartbeat:Connect(function(dt)
				if bmStale() then
					pcall(function()
						bodyVelocity.Velocity = Vector3.zero
					end)

					pcall(function()
						bodyVelocity:Destroy()
					end)

					if tweenState.Conn then
						tweenState.Conn:Disconnect()
						tweenState.Conn = nil
					end

					tweenState.Enabled = false
					return
				end

				if getgenv().firebreathMovementHeld() then
					bodyVelocity.Velocity = Vector3.zero
					startedAt += dt
					return
				end

				local timedOut = tick() - startedAt >= maxTime

				if not tweenState.Enabled or getgenv().EvadingBoss or getgenv().LowHealthAnchored or timedOut then
					if timedOut and tweenState.Enabled then
						getgenv().TweenNeedsRetween = true

						pcall(function()
							local magnitude = (cframe.Position + offset - startRoot.Position).Magnitude
							getgenv().BMLog(
								string.format(
									"[Tween] Timed out after %ds still %d studs from the goal - NOT an arrival.",
									math.floor(maxTime),
									math.floor(magnitude)
								)
							)
						end)

