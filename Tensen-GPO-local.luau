		-- which boss the back-and-forth applies to: "her" (Big Mom), "him" (Katakuri), "juice", or nil
		getgenv().m1ShuffleWho = function(instance)
			if getgenv().M1Shuffle == false then
				return nil
			end

			if not (instance and instance.Parent) then
				return nil
			end

			if getgenv().M1ShuffleBigMom ~= false and getgenv().isBigMomNPC and getgenv().isBigMomNPC(instance) then
				return "her"
			end

			if getgenv().M1ShuffleMochi ~= false and getgenv().isMochiNPC and getgenv().isMochiNPC(instance) then
				return "him"
			end

			if getgenv().M1ShuffleJuice ~= false and getgenv().isJuiceNPC and getgenv().isJuiceNPC(instance) then
