		getgenv().isBarrierPart = function(part)
			if not part then
				return false
			end

			local isBarrier = false

			pcall(function()
				local collisionGroup = part.CollisionGroup

				if collisionGroup and string.find(string.lower(tostring(collisionGroup)), "barrier", 1, true) then
					isBarrier = true
					return
				end

				local fullName = string.lower(part:GetFullName())
				local barrierNameHints = getgenv().BarrierNameHints or {}

				for _, barrierNameHint in ipairs(barrierNameHints) do
					if barrierNameHint ~= "" and string.find(fullName, string.lower(barrierNameHint), 1, true) then
						isBarrier = true
						return
					end
				end
			end)

			return isBarrier
		end

		getgenv().GroundDropOffset = getgenv().GroundDropOffset or 4

		-- Y of the first non-barrier floor under origin, and the part hit
		getgenv().FindNonBarrierGroundY = function(origin, ignoreList)
			if not origin then
				return nil
			end

			local raycastParams = RaycastParams.new()
			raycastParams.FilterType = Enum.RaycastFilterType.Exclude
			local filterDescendantsInstances = {}
			local character = localPlayer and localPlayer.Character

			if character then
				table.insert(filterDescendantsInstances, character)
			end

			local iterFn, iterState, iterStart = ipairs(ignoreList or {})

			for _, part in iterFn, iterState, iterStart do
				if part then
					table.insert(filterDescendantsInstances, part)
				end
			end

			raycastParams.FilterDescendantsInstances = filterDescendantsInstances
			local rayStart = origin + Vector3.new(0, 2, 0)

			for i = 1, 12 do
				local hit = Workspace:Raycast(rayStart, Vector3.new(0, -3000, 0), raycastParams)

				if not (hit and hit.Instance) then
					return nil
				end

				if not getgenv().isBarrierPart(hit.Instance) then
					return hit.Position.Y, hit.Instance
				end

				table.insert(filterDescendantsInstances, hit.Instance)
				raycastParams.FilterDescendantsInstances = filterDescendantsInstances
			end

			return nil
		end

		-- true (plus part and position) when a barrier part sits between from and to
		getgenv().BarrierBetween = function(from, to, ignoreList)
			if not from or not to then
				return false
			end

			local offset = to - from

			if offset.Magnitude < 0.05 then
				return false
			end

			local raycastParams = RaycastParams.new()
			raycastParams.FilterType = Enum.RaycastFilterType.Exclude
			local filterDescendantsInstances = {}
			local character = localPlayer and localPlayer.Character

			if character then
				table.insert(filterDescendantsInstances, character)
			end

			local ignore = ignoreList or {}

			for _, part in ipairs(ignore) do
				if part then
					table.insert(filterDescendantsInstances, part)
				end
			end

			raycastParams.FilterDescendantsInstances = filterDescendantsInstances
			local rayDir = offset.Unit * (offset.Magnitude + (getgenv().BarrierProbePad or 3))

			for i = 1, 8 do
				local hit = Workspace:Raycast(from, rayDir, raycastParams)

				if not (hit and hit.Instance) then
					return false
				end

				if getgenv().isBarrierPart(hit.Instance) then
					return true, hit.Instance, hit.Position
				end

				table.insert(filterDescendantsInstances, hit.Instance)
				raycastParams.FilterDescendantsInstances = filterDescendantsInstances
			end

			return false
		end

