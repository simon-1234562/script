					local noWalkOnWater, needRescan, elapsed, oceanRescanRate, oceanTopY, noteOceanPart

					if not (oceanFolder and oceanFolder.Parent) then
						oceanFolder = getgenv().findOceanFolder()
						instances = nil
						scannedOceanFolder = nil
