		-- keeps a tween target at the current height when the floor ray says the change is tiny
		getgenv().SnapGroundY = function(label, instance, targetPos, hitPart)
			if not instance or not instance.Parent then
				return targetPos
			end

			local deltaY = targetPos.Y - instance.Position.Y

			if getgenv().TweenGroundLog == true and math.abs(deltaY) > 0.05 then
				local now = tick()
				local elapsed = now - (getgenv().LastGroundLog or 0)

				if (getgenv().TweenGroundLogRate or 1) <= elapsed then
					getgenv().LastGroundLog = now

					if getgenv().BMLog then
						local bmLog = getgenv().BMLog
						local labelText = tostring(label)
						bmLog(
							string.format(
								"[TweenY] %s: standing at Y %.1f, floor ray hit '%s' at Y %.1f -> wants Y %.1f (%+.1f).",
								labelText,
								instance.Position.Y,
								hitPart and hitPart:GetFullName() or "?",
								hitPart and hitPart.Position.Y or 0,
								targetPos.Y,
								deltaY
							)
						)
					end
				end
			end

			if math.abs(deltaY) <= (getgenv().TweenGroundDeadzone or 2.5) then
				return Vector3.new(targetPos.X, instance.Position.Y, targetPos.Z)
			end

			return targetPos
		end

		do
			-- logs (rate limited) that the tween is climbing over an obstacle
			local function logTweenClimb(label, obstacle, isBarrier, fromY, toY)
				if getgenv().TweenClimbLog == false then
					return
				end

				local now = tick()

				if now - (getgenv().LastClimbLog or 0) < (getgenv().TweenClimbRate or 2) then
