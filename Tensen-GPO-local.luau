		-- walks back into the room after being pushed out of it; true when we are inside (or gave up)
		getgenv().backIntoRoom = function(instance)
			local returnOff = getgenv().RoomReturn == false

			if returnOff then
				return true
			end

			if getgenv().reactionOwnsUs() then
				getgenv().OutOfRoomSince = nil
				return true
			end

			local _name, _room, how = getgenv().currentCakeStage()

			if how == "inside" then
				getgenv().OutOfRoomSince = nil
				return true
			end

			if how ~= "nearest" or not getgenv().LastInsideRoom then
				getgenv().OutOfRoomSince = nil
				return true
			end

			local lastRoom = getgenv().cakeRoomByName(getgenv().LastInsideRoom)

			if not lastRoom then
				getgenv().LastInsideRoom = nil
				getgenv().OutOfRoomSince = nil
				return true
			end

			getgenv().OutOfRoomSince = getgenv().OutOfRoomSince or tick()
			local elapsed = tick() - getgenv().OutOfRoomSince

			if elapsed < (getgenv().RoomReturnGrace or 3) then
				getgenv().BigMomStep =
					string.format("outside room %s - giving it a moment", tostring(getgenv().LastInsideRoom))
				return false
			end

			if (getgenv().RoomReturnGiveUp or 60) < elapsed then
				local bmLog = getgenv().RoomReturnLog ~= false and getgenv().BMLog

				if bmLog then
					getgenv().BMLog(
						string.format(
							"[Room] %.0fs outside room %s and I cannot get back in - carrying on from where I am.",
							elapsed,
							tostring(getgenv().LastInsideRoom)
						)
					)
				end

				getgenv().LastInsideRoom = nil
				getgenv().OutOfRoomSince = nil
				return true
			end

			local lastInsidePos = getgenv().LastInsidePos
			local boxCF = getgenv().roomBox(lastRoom)

			if lastInsidePos and boxCF then
				local _stage, roomThere = getgenv().currentCakeStage(lastInsidePos)

				if roomThere ~= lastRoom then
					lastInsidePos = nil
				end
			end

			lastInsidePos = lastInsidePos or boxCF and boxCF.Position or nil

			if not lastInsidePos then
				getgenv().LastInsideRoom = nil
				getgenv().OutOfRoomSince = nil
				return true
			end

			getgenv().RoomReturns = (getgenv().RoomReturns or 0) + 1
			instance = instance and instance:FindFirstChild("HumanoidRootPart")
			local magnitude = instance and (instance.Position - lastInsidePos).Magnitude or -1
			getgenv().BigMomStep = string.format(
				"outside room %s - walking back in (%.0f studs)",
				tostring(getgenv().LastInsideRoom),
				magnitude
			)
